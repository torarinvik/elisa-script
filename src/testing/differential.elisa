# Typed, deterministic comparison primitives for reference/candidate runs.
#
# Runners are deliberately separate from this module: a process adapter, an
# in-process function, or a future VM can all materialize the same DifferentialRun
# value before comparison. Errors remain named data at this testing boundary; the
# production language still reports failures through Elisa's error[...] channel.

include "../../vendor/elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../../vendor/elisa-compiler/elisacore_std/elisacore_fileio.elisa"
include "../ir/ir.elisa"
include "./report_model.elisa"
include "./sequence_model.elisa"
include "./stability_model.elisa"
include "./filesystem_snapshot_model.elisa"
include "./order_model.elisa"
include "./trace_window_model.elisa"
include "./effect_trace_model.elisa"
include "./replay_model.elisa"
include "./redaction_model.elisa"
include "./generator_model.elisa"


error DifferentialRunnerError:
    Invalid
    UnsupportedKind
    UnsupportedConfiguration
    Process
    Timeout
    OutputLimit


module EsDifferential:
    using EsIr
    using EsProcess
    using EsRuntime
    using EsDifferentialSequence


    const DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES: u64 = 67108864
    const DIFFERENTIAL_DEFAULT_MAX_TIMEOUT_STEPS: u64 = EsIr::ES_RUNTIME_DEFAULT_MAX_STEPS
    # Process adapters copy argv and environment entries into owned C strings
    # before fork. Keep both host-side reservations bounded even when a caller
    # bypasses runner preparation and invokes the low-level adapter directly.
    const DIFFERENTIAL_DEFAULT_MAX_ARGUMENTS: usize = 1048576
    const DIFFERENTIAL_DEFAULT_MAX_ENVIRONMENT_ENTRIES: usize = 1048576
    # Bound the aggregate C-string payload and stdin staging allocation before
    # a differential process duplicates caller-owned text into host buffers.
    const DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES: usize = 67108864
    # The working directory is a POSIX pathname, not an arbitrary process text
    # field. Admit it through a portable 4 KiB envelope before any NUL scan or
    # child-side chdir call while retaining the broader text ceiling elsewhere.
    const DIFFERENTIAL_DEFAULT_MAX_PROCESS_PATH_BYTES: usize = 4096
    const DIFFERENTIAL_DEFAULT_MAX_PROCESS_INPUT_BYTES: usize = 67108864
    # A complete hermetic world is fingerprinted and materialized as one
    # admission unit. Bound its aggregate payload independently from each
    # fixture/channel limit so many individually valid entries cannot create an
    # unbounded hash or staging workload.
    const DIFFERENTIAL_DEFAULT_MAX_WORLD_BYTES: usize = 268435456
    const DIFFERENTIAL_DEFAULT_MAX_WORLD_PATH_BYTES: usize = 4096
    const DIFFERENTIAL_DEFAULT_MAX_WORLD_METADATA_BYTES: usize = 4096

    public:
        const enum DifferentialValueKind of u8:
            Void
            Bool
            Int
            Float
            Array
            Map
            Text
            ProcessCapture


        struct DifferentialValue:
            text: sview = ""
            integer: i64 = 0
            decimal: f64 = 0.0
            process_exit_status: i64 = 0
            process_stdout: sview = ""
            process_stderr: sview = ""
            array_start: u32 = 0
            array_count: u32 = 0
            map_start: u32 = 0
            map_count: u32 = 0
            kind: DifferentialValueKind
            boolean: bool = false


    private:
        # Differential value pools serialize aggregate offsets as u32. Keep
        # the host-side pool count inside that interchange domain before any
        # conversion or recursive materialization can truncate it.
        const DIFFERENTIAL_U32_MAX: usize = 4294967295
        # A comparison artifact must not retain an effectively unbounded flat
        # value pool even when every individual offset is representable.
        const DIFFERENTIAL_DEFAULT_MAX_VALUES: usize = 1048576
        const DIFFERENTIAL_DEFAULT_MAX_OBSERVATION_SITES: usize = 65536
        # Equality may revisit shared or cyclic aggregate views. Bound the
        # number of selected pairs independently from pool size so a malformed
        # DAG cannot turn comparison into an unbounded work loop.
        const DIFFERENTIAL_DEFAULT_MAX_COMPARISON_PAIRS: usize = 1048576
        # Runtime aggregate snapshots are recursively converted into the owned
        # pool. Keep hostile nesting from exhausting the host call stack.
        const DIFFERENTIAL_DEFAULT_MAX_VALUE_DEPTH: usize = 128


        # Differential values are an interchange boundary, not an open-ended
        # host union. Keep unknown enum ordinals from falling through the
        # scalar comparison path (where they would otherwise be interpreted as
        # text) or from being mistaken for a future kind with different storage
        # invariants.
        def differential_value_kind_valid(kind: DifferentialValueKind) -> bool:
            return kind in {DifferentialValueKind.Void, DifferentialValueKind.Bool, DifferentialValueKind.Int, DifferentialValueKind.Float, DifferentialValueKind.Array, DifferentialValueKind.Map, DifferentialValueKind.Text, DifferentialValueKind.ProcessCapture}


        def differential_observation_schema_valid(schema: DifferentialObservationSchema&) -> bool:
            return false if schema.sites.count > DIFFERENTIAL_DEFAULT_MAX_OBSERVATION_SITES
            required_observations_remaining: mutable usize = ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS
            for index in 0..<schema.sites.count |schema|:
                site: DifferentialObservationSite = schema.sites[index]
                return false if site.trace == 0 or not differential_value_kind_valid(site.value_kind)
                return false if site.maximum_count == 0 or site.maximum_count.usize() > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS
                return false if site.minimum_count > site.maximum_count
                return false if index != 0 and schema.sites[index - 1].trace >= site.trace
                required_count: usize = site.minimum_count.usize()
                return false if required_count > required_observations_remaining
                required_observations_remaining <- required_observations_remaining - required_count
            return true


        def differential_observation_schema_canonical_bytes(schema: DifferentialObservationSchema&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not differential_observation_schema_valid(schema)
            output: mutable darray[u8] = []
            EsIr::canonical_artifact_emit_byte(output, 69)
            EsIr::canonical_artifact_emit_byte(output, 83)
            EsIr::canonical_artifact_emit_byte(output, 79)
            EsIr::canonical_artifact_emit_byte(output, 83)
            EsIr::canonical_artifact_emit_byte(output, 1)
            EsIr::canonical_artifact_emit_u64(output, schema.sites.count.u64())
            for site in schema.sites |output|:
                EsIr::canonical_artifact_emit_u64(output, site.trace)
                EsIr::canonical_artifact_emit_byte(output, site.value_kind.u8())
                EsIr::canonical_artifact_emit_u64(output, site.minimum_count.u64())
                EsIr::canonical_artifact_emit_u64(output, site.maximum_count.u64())
            return output


        # Serialized readers receive raw ordinals before an enum value exists.
        # Keep this byte-level predicate explicit rather than relying on the
        # current highest ordinal: a future enum revision may reserve a gap or
        # reorder storage, and an old reader must reject that byte before it
        # falls through to the default Void representation.
        def differential_value_kind_byte_valid(kind_byte: u8) -> bool:
            return kind_byte == DifferentialValueKind.Void.u8() or kind_byte == DifferentialValueKind.Bool.u8() or kind_byte == DifferentialValueKind.Int.u8() or kind_byte == DifferentialValueKind.Float.u8() or kind_byte == DifferentialValueKind.Array.u8() or kind_byte == DifferentialValueKind.Map.u8() or kind_byte == DifferentialValueKind.Text.u8() or kind_byte == DifferentialValueKind.ProcessCapture.u8()


        # Every serialized enum gets an explicit raw-byte admission predicate.
        # Do not infer validity from the current highest ordinal: future enum
        # revisions may reserve gaps, and old readers must reject those bytes
        # before defaulting to the first constructor.
        def differential_text_comparison_byte_valid(value: u8) -> bool:
            return value == DifferentialTextComparison.Exact.u8() or value == DifferentialTextComparison.TrimFinalNewline.u8()


        def differential_map_comparison_byte_valid(value: u8) -> bool:
            return value == DifferentialMapComparison.Unordered.u8() or value == DifferentialMapComparison.Ordered.u8()


        def differential_artifact_policy_byte_valid(value: u8) -> bool:
            return value == DifferentialArtifactPolicy.Never.u8() or value == DifferentialArtifactPolicy.OnMismatch.u8() or value == DifferentialArtifactPolicy.Always.u8()


        def differential_engine_requirement_byte_valid(value: u8) -> bool:
            return value == DifferentialEngineRequirement.Ignore.u8() or value == DifferentialEngineRequirement.RequireKnown.u8() or value == DifferentialEngineRequirement.RequireDistinct.u8() or value == DifferentialEngineRequirement.RequireDirectBytecodeCandidate.u8()


        def differential_artifact_side_byte_valid(value: u8) -> bool:
            return value == DifferentialArtifactSide.Reference.u8() or value == DifferentialArtifactSide.Candidate.u8()


        def differential_run_outcome_byte_valid(value: u8) -> bool:
            return value == DifferentialRunOutcome.Completed.u8() or value == DifferentialRunOutcome.NormalError.u8() or value == DifferentialRunOutcome.SpawnFailure.u8() or value == DifferentialRunOutcome.Crash.u8() or value == DifferentialRunOutcome.Timeout.u8() or value == DifferentialRunOutcome.OutputLimit.u8() or value == DifferentialRunOutcome.CompileFailure.u8()


        def differential_artifact_publication_state_byte_valid(value: u8) -> bool:
            return value == DifferentialArtifactPublicationState.Prepared.u8() or value == DifferentialArtifactPublicationState.Complete.u8()


        def differential_difference_kind_byte_valid(value: u8) -> bool:
            return value == DifferentialDifferenceKind.Equal.u8() or value == DifferentialDifferenceKind.Engine.u8() or value == DifferentialDifferenceKind.ExitStatus.u8() or value == DifferentialDifferenceKind.Error.u8() or value == DifferentialDifferenceKind.Stdout.u8() or value == DifferentialDifferenceKind.Stderr.u8() or value == DifferentialDifferenceKind.ReturnValue.u8() or value == DifferentialDifferenceKind.ObservationCount.u8() or value == DifferentialDifferenceKind.ObservationTrace.u8() or value == DifferentialDifferenceKind.ObservationValue.u8() or value == DifferentialDifferenceKind.Outcome.u8() or value == DifferentialDifferenceKind.CaseInvalid.u8() or value == DifferentialDifferenceKind.ObservationContract.u8()


        def differential_execution_engine_byte_valid(value: u8) -> bool:
            return value == EsIr::ExecutionEngine.ReferenceInterpreter.u8() or value == EsIr::ExecutionEngine.DirectBytecode.u8() or value == EsIr::ExecutionEngine.BytecodeInterpreterFallback.u8()


        # Differential snapshots keep u32 offsets for stable interchange.
        # Validate a half-open array range by subtraction so a hostile
        # externally assembled value cannot wrap `start + count` on a
        # narrower host before the comparator indexes its owned pool.
        def differential_array_value_range_valid(storage: darray[DifferentialValue]&, value: DifferentialValue) -> bool:
            false return if value.kind != DifferentialValueKind.Array
            start: usize = value.array_start.usize()
            false return if start > storage.count
            return value.array_count.usize() <= storage.count - start


        # Map snapshots store key/value pairs consecutively. Validate the pair
        # span by subtraction before multiplying or indexing so a malformed
        # u32 start/count cannot wrap on a narrower host. Keeping this beside
        # the array predicate makes every owned-map comparison use one boundary
        # contract rather than reimplementing partial checks at each call site.
        def differential_map_value_range_valid(storage: darray[DifferentialValue]&, value: DifferentialValue) -> bool:
            false return if value.kind != DifferentialValueKind.Map
            start: usize = value.map_start.usize()
            false return if start > storage.count
            return value.map_count.usize() <= (storage.count - start) / 2


    public:
        # Floating-point comparisons are exact by default.  A caller that is
        # comparing numerically equivalent ports may opt into an explicit
        # absolute/relative tolerance; no normalization is implicit.
        struct DifferentialFloatTolerance:
            absolute: f64 = 0.0
            relative: f64 = 0.0


        const enum DifferentialTextComparison of u8:
            Exact
            TrimFinalNewline


        const enum DifferentialMapComparison of u8:
            Unordered
            Ordered


        # Comparison policy is explicit data rather than an adapter-side
        # convention.  Exact text, unordered maps, and zero float tolerance
        # preserve the historical default; every relaxed comparison must be
        # selected by the case author and can therefore be recorded later in
        # an artifact manifest without guessing intent.
        struct DifferentialComparatorPolicy:
            float_tolerance: DifferentialFloatTolerance = DifferentialFloatTolerance{}
            text: DifferentialTextComparison = DifferentialTextComparison.Exact
            maps: DifferentialMapComparison = DifferentialMapComparison.Unordered


        struct DifferentialObservation:
            trace: u64
            value: DifferentialValue


        # Trace identifiers are canonicalized in strict ascending order. This
        # lets cases share a bounded, deterministic observation contract.
        struct DifferentialObservationSite:
            trace: u64
            value_kind: DifferentialValueKind
            minimum_count: u32 = 1
            maximum_count: u32 = 1


        struct DifferentialObservationSchema:
            sites: darray[DifferentialObservationSite] = []


        # Environment overrides are kept as an ordered list rather than a runtime
        # dictionary: native adapters must preserve duplicate-key validation and
        # do not require a host map representation for text keys.
        struct DifferentialEnvironmentEntry:
            name: sview
            value: sview


        const enum DifferentialRunOutcome of u8:
            Completed
            NormalError
            SpawnFailure
            Crash
            Timeout
            OutputLimit
            CompileFailure


        struct DifferentialRun:
            exit_status: mutable i64 = 0
            error_text: sview = ""
            stdout: sview = ""
            stderr: sview = ""
            observations: mutable darray[DifferentialObservation]
            values: mutable darray[DifferentialValue] = []
            return_value: mutable DifferentialValue = DifferentialValue{kind: DifferentialValueKind.Void}
            outcome: mutable DifferentialRunOutcome = DifferentialRunOutcome.Completed
            # External processes do not have an Elisascript engine identity.
            # In-process candidates set this flag and preserve the exact
            # interpreter/bytecode choice for artifact and parity auditing.
            engine_known: mutable bool = false
            engine: mutable EsIr::ExecutionEngine = EsIr::ExecutionEngine.ReferenceInterpreter
            # A capability snapshot accompanies known in-process backend runs.
            # External processes leave it unknown because their instruction and
            # global counts are not observable at this boundary.
            capability_known: mutable bool = false
            capability: mutable EsIr::ExecutionCapability = EsIr::ExecutionCapability{}
            # In-process candidates carry the shared run policy and the usage
            # observed at the execution boundary. External oracle processes
            # leave this unknown because their host resources are not visible
            # through this record.
            resource_policy_known: mutable bool = false
            resource_policy: mutable EsIr::RuntimeResourcePolicy = EsIr::RuntimeResourcePolicy{}
            resource_usage: mutable EsIr::RuntimeResourceUsage = EsIr::RuntimeResourceUsage{}


    private:
        const enum DifferentialCaptureState of u8:
            Validate
            Materialize
            Done


        struct DifferentialCaptureCursor:
            state: mutable DifferentialCaptureState
            result: mutable DifferentialRun


    public:
        def differential_array_value(storage: mutable darray[DifferentialValue]&, values: darray[DifferentialValue]) -> DifferentialValue error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialRunnerError.Invalid if storage.count > DIFFERENTIAL_U32_MAX
            raise DifferentialRunnerError.Invalid if values.count > DIFFERENTIAL_U32_MAX - storage.count
            raise DifferentialRunnerError.OutputLimit if storage.count > DIFFERENTIAL_DEFAULT_MAX_VALUES
            raise DifferentialRunnerError.OutputLimit if values.count > DIFFERENTIAL_DEFAULT_MAX_VALUES - storage.count
            start: u32 = storage.count.u32()
            storage.extend(values)
            return DifferentialValue{kind: DifferentialValueKind.Array, array_start: start, array_count: values.count.u32()}


        def differential_map_value(storage: mutable darray[DifferentialValue]&, keys_and_values: darray[DifferentialValue]) -> DifferentialValue error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialRunnerError.Invalid if keys_and_values.count % 2 != 0
            raise DifferentialRunnerError.Invalid if storage.count > DIFFERENTIAL_U32_MAX
            raise DifferentialRunnerError.Invalid if keys_and_values.count / 2 > (DIFFERENTIAL_U32_MAX - storage.count) / 2
            raise DifferentialRunnerError.OutputLimit if storage.count > DIFFERENTIAL_DEFAULT_MAX_VALUES
            raise DifferentialRunnerError.OutputLimit if keys_and_values.count > DIFFERENTIAL_DEFAULT_MAX_VALUES - storage.count
            start: u32 = storage.count.u32()
            storage.extend(keys_and_values)
            return DifferentialValue{kind: DifferentialValueKind.Map, map_start: start, map_count: (keys_and_values.count / 2).u32()}


        # Convert an interpreter observation into the owned comparison value. The
        # public wrapper keeps the adapter API stable while the recursive helper
        # applies an explicit nesting budget.
        def differential_value_from_runtime(storage: darray[EsIr::RuntimeValue]&, value: EsIr::RuntimeValue, values: mutable darray[DifferentialValue]&) -> DifferentialValue error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            return try differential_value_from_runtime_at_depth(storage, value, values, 0)


    private:
        # Array elements are copied recursively so a comparison never depends on
        # the interpreter's transient flat runtime storage.
        def differential_value_from_runtime_at_depth(storage: darray[EsIr::RuntimeValue]&, value: EsIr::RuntimeValue, values: mutable darray[DifferentialValue]&, depth: usize) -> DifferentialValue error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialRunnerError.OutputLimit if depth > DIFFERENTIAL_DEFAULT_MAX_VALUE_DEPTH
            raise DifferentialRunnerError.Invalid if not EsIr::runtime_value_kind_valid(value.kind)
            match value.kind:
                EsIr::RuntimeValueKind.Void:
                    return DifferentialValue{kind: DifferentialValueKind.Void}
                EsIr::RuntimeValueKind.Bool:
                    return DifferentialValue{kind: DifferentialValueKind.Bool, boolean: value.boolean}
                EsIr::RuntimeValueKind.Int:
                    return DifferentialValue{kind: DifferentialValueKind.Int, integer: value.integer}
                EsIr::RuntimeValueKind.Float:
                    return DifferentialValue{kind: DifferentialValueKind.Float, decimal: value.decimal}
                EsIr::RuntimeValueKind.Text:
                    raise DifferentialRunnerError.OutputLimit if sview_len(value.text) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES
                    return DifferentialValue{kind: DifferentialValueKind.Text, text: value.text}
                EsIr::RuntimeValueKind.ProcessCapture:
                    raise DifferentialRunnerError.OutputLimit if not differential_process_capture_text_bytes_fit(value)
                    return DifferentialValue{kind: DifferentialValueKind.ProcessCapture, process_exit_status: value.process_exit_status, process_stdout: value.process_stdout, process_stderr: value.process_stderr}
                EsIr::RuntimeValueKind.Array:
                    raise DifferentialRunnerError.Invalid if not EsIr::runtime_array_range_valid(storage, value)
                    raise DifferentialRunnerError.OutputLimit if values.count > DIFFERENTIAL_DEFAULT_MAX_VALUES
                    start: usize = values.count
                    count: usize = value.array_count.usize()
                    raise DifferentialRunnerError.OutputLimit if count > DIFFERENTIAL_DEFAULT_MAX_VALUES - values.count
                    raise DifferentialRunnerError.Invalid if start > DIFFERENTIAL_U32_MAX
                    raise DifferentialRunnerError.Invalid if count > DIFFERENTIAL_U32_MAX - start
                    for offset in 0..<value.array_count.usize() |values|:
                        values.push(DifferentialValue{kind: DifferentialValueKind.Void})
                    for offset in 0..<count |storage, value, values, start|:
                        values[start + offset] <- try differential_value_from_runtime_at_depth(storage, storage[value.array_start.usize() + offset], values, depth + 1)
                    return DifferentialValue{kind: DifferentialValueKind.Array, array_start: start.u32(), array_count: value.array_count}
                EsIr::RuntimeValueKind.Map:
                    raise DifferentialRunnerError.Invalid if not EsIr::runtime_map_range_valid(storage, value)
                    raise DifferentialRunnerError.OutputLimit if values.count > DIFFERENTIAL_DEFAULT_MAX_VALUES
                    start: usize = values.count
                    pair_count: usize = value.map_count.usize()
                    raise DifferentialRunnerError.OutputLimit if pair_count > (DIFFERENTIAL_DEFAULT_MAX_VALUES - values.count) / 2
                    raise DifferentialRunnerError.Invalid if start > DIFFERENTIAL_U32_MAX
                    raise DifferentialRunnerError.Invalid if pair_count > (DIFFERENTIAL_U32_MAX - start) / 2
                    for _ in 0..<pair_count |values|:
                        values.push(DifferentialValue{kind: DifferentialValueKind.Void})
                        values.push(DifferentialValue{kind: DifferentialValueKind.Void})
                    for offset in 0..<pair_count |storage, value, values, start|:
                        key_offset: usize = offset * 2
                        values[start + key_offset] <- try differential_value_from_runtime_at_depth(storage, storage[value.map_start.usize() + key_offset], values, depth + 1)
                        values[start + key_offset + 1] <- try differential_value_from_runtime_at_depth(storage, storage[value.map_start.usize() + key_offset + 1], values, depth + 1)
                    return DifferentialValue{kind: DifferentialValueKind.Map, map_start: start.u32(), map_count: value.map_count}


        # Runtime ProcessCapture values are borrowed snapshots, but they still
        # cross the same host-visible output boundary as native process runs.
        # Reject oversized channels before exposing them to comparison or
        # artifact code; this keeps every adapter on one bounded contract.
        def differential_process_capture_text_bytes_fit(capture: EsIr::RuntimeValue) -> bool:
            return false if capture.kind != EsIr::RuntimeValueKind.ProcessCapture
            return false if sview_len(capture.process_stdout).u64() > DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES
            return sview_len(capture.process_stderr).u64() <= DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES


    public:
        def append_differential_observations_from_runtime(storage: darray[EsIr::RuntimeValue]&, observations: darray[EsIr::Observation], values: mutable darray[DifferentialValue]&, converted: mutable darray[DifferentialObservation]&) -> void error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            # Adapters may receive snapshots assembled outside the execution
            # engines, so enforce the same trace budget before converting any
            # element into the owned comparison pools.
            raise DifferentialRunnerError.OutputLimit if observations.count > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS
            for observation in observations |storage, values, converted|:
                converted.push(DifferentialObservation{trace: observation.trace, value: try differential_value_from_runtime(storage, observation.value, values)})


        # Adapt one typed ProcessCapture snapshot into the comparison model. A
        # malformed value becomes a deterministic run error instead of exposing
        # partially populated stdout/stderr fields to the comparator.
        def differential_run_from_process_capture(capture: EsIr::RuntimeValue&, observations: darray[DifferentialObservation], values: darray[DifferentialValue] = []) -> DifferentialRun:
            cursor: mutable DifferentialCaptureCursor = DifferentialCaptureCursor{state: DifferentialCaptureState.Validate, result: DifferentialRun{observations: []}}
            machine over cursor.state:
                state Adapt
                start Adapt

                Adapt, DifferentialCaptureState.Validate if capture.kind == EsIr::RuntimeValueKind.ProcessCapture and differential_capture_observation_values_shape_valid(observations, values) and differential_process_capture_text_bytes_fit(capture) and differential_capture_inputs_text_bytes_fit(observations, values):
                    cursor.state <- DifferentialCaptureState.Materialize
                    -> Adapt
                Adapt, DifferentialCaptureState.Validate if capture.kind == EsIr::RuntimeValueKind.ProcessCapture and not differential_capture_observation_values_shape_valid(observations, values):
                    cursor.result <- DifferentialRun{error_text: "process capture inputs are structurally invalid", outcome: DifferentialRunOutcome.NormalError, observations: []}
                    cursor.state <- DifferentialCaptureState.Done
                    -> Adapt
                Adapt, DifferentialCaptureState.Validate if capture.kind == EsIr::RuntimeValueKind.ProcessCapture and differential_process_capture_text_bytes_fit(capture):
                    cursor.result <- DifferentialRun{error_text: "process capture inputs exceed differential budget", outcome: DifferentialRunOutcome.OutputLimit, observations: []}
                    cursor.state <- DifferentialCaptureState.Done
                    -> Adapt
                Adapt, DifferentialCaptureState.Validate if capture.kind == EsIr::RuntimeValueKind.ProcessCapture:
                    cursor.result <- DifferentialRun{error_text: "process capture exceeds output limit", outcome: DifferentialRunOutcome.OutputLimit, observations: []}
                    cursor.state <- DifferentialCaptureState.Done
                    -> Adapt
                Adapt, DifferentialCaptureState.Validate:
                    cursor.result <- DifferentialRun{error_text: "expected ProcessCapture runtime value", observations: []}
                    cursor.state <- DifferentialCaptureState.Done
                    -> Adapt

                Adapt, DifferentialCaptureState.Materialize:
                    cursor.result <- DifferentialRun{exit_status: capture.process_exit_status, stdout: capture.process_stdout, stderr: capture.process_stderr, observations: observations, values: values, return_value: DifferentialValue{kind: DifferentialValueKind.Int, integer: capture.process_exit_status}}
                    cursor.state <- DifferentialCaptureState.Done
                    -> Adapt

                Adapt, DifferentialCaptureState.Done:
                    break

            return cursor.result


        # A runner is a typed, shell-free execution specification. `target` is
        # an executable/module/adapter path for external runners and a symbol
        # or function identifier for in-process runners. `arguments` stays a
        # vector so adapters never need to reconstruct a command string.
        const enum DifferentialRunnerKind of u8:
            InProcessFunction
            ElisascriptFile
            ElisascriptProgram
            NativeProcess
            PythonAdapter
            CAbiFunction
            WasmModule
            Service


        struct DifferentialRunner:
            kind: DifferentialRunnerKind
            name: sview
            target: sview
            entry: sview = ""
            arguments: darray[sview]
            handlers: darray[Handler] = []
            working_directory: sview = ""
            environment: darray[DifferentialEnvironmentEntry] = []
            stdin: sview = ""
            # Binary stdin is an owned byte payload, never a C string. The
            # explicit mode bit makes mixed payloads fail closed.
            stdin_bytes: mutable darray[u8] = []
            stdin_binary: bool = false
            protocol: sview = ""
            timeout_steps: u64 = 1
            max_output_bytes: u64 = DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES
            required_effects: darray[sview] = []
            required_errors: darray[sview] = []


        const enum DifferentialOracleLanguage of u8:
            Python
            Perl
            Awk
            Shell
            C
            Cpp
            Native


        struct DifferentialOracle:
            name: sview
            language: DifferentialOracleLanguage
            runner: DifferentialRunner
            version: sview = ""


        const enum DifferentialOracleIssue of u8:
            None
            MissingName
            InvalidLanguage
            InvalidVersion
            InvalidRunner
            NotIndependent


        struct DifferentialOracleCheck:
            valid: mutable bool
            issue: mutable DifferentialOracleIssue
            reason: mutable sview = ""


        # A hermetic world is part of the differential contract rather than an
        # ambient process setting. Fixture files may be text-backed or carry an
        # owned byte buffer; the kind is explicit so a binary NUL never crosses
        # a host-string boundary by accident.
        const enum DifferentialWorldFileKind of u8:
            Text
            Bytes


        struct DifferentialWorldFile:
            path: sview
            kind: DifferentialWorldFileKind = DifferentialWorldFileKind.Text
            contents: sview = ""
            bytes: mutable darray[u8] = []
            mode: u32 = 0
            executable: bool = false


        struct DifferentialWorld:
            working_directory: sview = ""
            files: darray[DifferentialWorldFile] = []
            environment: darray[DifferentialEnvironmentEntry] = []
            argv: darray[sview] = []
            stdin: sview = ""
            stdin_bytes: mutable darray[u8] = []
            stdin_binary: bool = false
            locale: sview = ""
            timezone: sview = ""
            seed: u64 = 0


        struct DifferentialWorldSnapshot:
            format_version: u8 = 1
            world_fingerprint: u64 = 0
            world: DifferentialWorld


        const enum DifferentialWorldSnapshotIssue of u8:
            None
            InvalidWorld
            InvalidSnapshot
            FingerprintMismatch


        struct DifferentialWorldSnapshotCheck:
            valid: mutable bool
            issue: mutable DifferentialWorldSnapshotIssue
            reason: mutable sview = ""


        const enum DifferentialWorldMaterializationState of u8:
            Planned
            Materializing
            Materialized
            Running
            Restoring
            Restored


        # Public value record: validation enforces structural consistency, not
        # provenance. Host adapters must own this plan rather than trust a
        # caller-constructed terminal record as restoration evidence.
        struct DifferentialWorldMaterializationPlan:
            format_version: u8 = 1
            snapshot_fingerprint: u64 = 0
            reference_root: sview = ""
            candidate_root: sview = ""
            state: DifferentialWorldMaterializationState = DifferentialWorldMaterializationState.Planned
            has_materialization_attempt: bool = false
            has_reference_restoration: bool = false
            reference_restored_world_fingerprint: u64 = 0
            has_candidate_restoration: bool = false
            candidate_restored_world_fingerprint: u64 = 0


        const enum DifferentialWorldMaterializationIssue of u8:
            None
            InvalidPlan
            InvalidSnapshot
            SnapshotFingerprintMismatch
            InvalidRoot
            RootsCollide
            InvalidTransition


        struct DifferentialWorldMaterializationCheck:
            valid: mutable bool
            issue: mutable DifferentialWorldMaterializationIssue
            reason: mutable sview = ""


        const enum DifferentialArtifactPolicy of u8:
            Never
            OnMismatch
            Always


        const enum DifferentialEngineRequirement of u8:
            Ignore
            RequireKnown
            RequireDistinct
            RequireDirectBytecodeCandidate


        # A typed case binds two runners to one world, comparison policy, and
        # artifact decision. It is deliberately non-executable data: adapters
        # must validate it before launching either side.
        struct DifferentialCase:
            name: sview
            reference: DifferentialRunner
            candidate: DifferentialRunner
            world: DifferentialWorld = DifferentialWorld{}
            comparator: DifferentialComparatorPolicy = DifferentialComparatorPolicy{}
            observation_schema: DifferentialObservationSchema = DifferentialObservationSchema{}
            tolerance: DifferentialFloatTolerance = DifferentialFloatTolerance{}
            engine_requirement: DifferentialEngineRequirement = DifferentialEngineRequirement.Ignore
            timeout_steps: u64 = 0
            max_output_bytes: u64 = 0
            seed: u64 = 0
            artifact_policy: DifferentialArtifactPolicy = DifferentialArtifactPolicy.OnMismatch


        const enum DifferentialCaseSide of u8:
            Reference
            Candidate


        struct DifferentialArtifactManifest:
            format_version: u8 = 3
            case_name: sview
            reference_name: sview
            candidate_name: sview
            world_seed: u64 = 0
            world_fingerprint: u64 = 0
            case_seed: u64 = 0
            engine_requirement: DifferentialEngineRequirement = DifferentialEngineRequirement.Ignore
            artifact_policy: DifferentialArtifactPolicy = DifferentialArtifactPolicy.OnMismatch
            module_fingerprint: u64 = 0
            module_digest_0: u64 = 0
            module_digest_1: u64 = 0
            module_digest_2: u64 = 0
            module_digest_3: u64 = 0
            module_digest_present: bool = false
            comparator: DifferentialComparatorPolicy = DifferentialComparatorPolicy{}
            observation_schema_digest_0: u64 = 0
            observation_schema_digest_1: u64 = 0
            observation_schema_digest_2: u64 = 0
            observation_schema_digest_3: u64 = 0


        struct DifferentialArtifactManifestDecode:
            valid: bool
            manifest: DifferentialArtifactManifest


        const enum DifferentialArtifactSide of u8:
            Reference
            Candidate


        # A process-stream payload is kept separate from the compact ESCR
        # comparison report. It preserves the complete bounded text channels
        # and terminal status for one side without forcing large captures into
        # the manifest or first-difference envelope.
        struct DifferentialProcessStreamArtifact:
            format_version: u8 = 1
            manifest_fingerprint: u64 = 0
            side: DifferentialArtifactSide = DifferentialArtifactSide.Reference
            outcome: DifferentialRunOutcome = DifferentialRunOutcome.Completed
            exit_status: i64 = 0
            error_text: sview = ""
            stdout: sview = ""
            stderr: sview = ""


        struct DifferentialProcessStreamArtifactDecode:
            valid: bool
            artifact: DifferentialProcessStreamArtifact


        # A reproduction artifact names a shell-free launcher target and
        # typed entry point. It is deliberately an identity-bearing sidecar,
        # not an opaque command string that could reintroduce shell parsing.
        struct DifferentialReproductionArtifact:
            format_version: u8 = 1
            manifest_fingerprint: u64 = 0
            target: sview = ""
            entry: sview = ""


        struct DifferentialReproductionArtifactDecode:
            valid: bool
            artifact: DifferentialReproductionArtifact


        # The value-pool payload owns the typed root, flat aggregate storage,
        # and observation trace for one side. Text/process channels stay in
        # ESPS so large streams do not duplicate this aggregate snapshot.
        struct DifferentialValuePoolArtifact:
            format_version: u8 = 1
            manifest_fingerprint: u64 = 0
            side: DifferentialArtifactSide = DifferentialArtifactSide.Reference
            outcome: DifferentialRunOutcome = DifferentialRunOutcome.Completed
            exit_status: i64 = 0
            root_value: DifferentialValue = DifferentialValue{kind: DifferentialValueKind.Void}
            values: darray[DifferentialValue] = []
            observations: darray[DifferentialObservation] = []


        struct DifferentialValuePoolArtifactDecode:
            valid: bool
            artifact: DifferentialValuePoolArtifact


        const enum DifferentialArtifactPublicationState of u8:
            Prepared
            Complete


        # ESIX is the bounded publication index for one artifact directory.
        # Prepared indexes may be written while sidecars are staged; Complete
        # is admitted only when every required sidecar fingerprint is present,
        # preventing a partial or mixed directory from being replayed.
        struct DifferentialArtifactIndex:
            format_version: u8 = 1
            manifest_fingerprint: u64 = 0
            publication: DifferentialArtifactPublicationState = DifferentialArtifactPublicationState.Prepared
            comparison_fingerprint: u64 = 0
            reference_process_fingerprint: u64 = 0
            candidate_process_fingerprint: u64 = 0
            reproduction_fingerprint: u64 = 0
            reference_value_pool_fingerprint: u64 = 0
            candidate_value_pool_fingerprint: u64 = 0


        struct DifferentialArtifactIndexDecode:
            valid: bool
            index: DifferentialArtifactIndex


        const enum DifferentialArtifactReplayIssue of u8:
            None
            InvalidManifest
            InvalidIndex
            Incomplete
            ManifestFingerprintMismatch
            ComparisonInvalid
            ReferenceProcessInvalid
            CandidateProcessInvalid
            ReproductionInvalid
            ReferenceValuePoolInvalid
            CandidateValuePoolInvalid
            SideMismatch
            FingerprintMismatch


        struct DifferentialArtifactReplayCheck:
            valid: mutable bool
            issue: mutable DifferentialArtifactReplayIssue
            reason: mutable sview = ""


        const enum DifferentialArtifactDirectoryState of u8:
            Staging
            Ready
            Published


        struct DifferentialArtifactDirectoryPlan:
            format_version: u8 = 1
            manifest_fingerprint: u64 = 0
            parent: sview = ""
            staging_name: sview = ""
            final_name: sview = ""
            state: DifferentialArtifactDirectoryState = DifferentialArtifactDirectoryState.Staging


        const enum DifferentialArtifactDirectoryIssue of u8:
            None
            InvalidPlan
            InvalidIndex
            InvalidParent
            InvalidComponent
            NameCollision
            ManifestFingerprintMismatch
            InvalidPublicationState
            InvalidTransition


        struct DifferentialArtifactDirectoryCheck:
            valid: mutable bool
            issue: mutable DifferentialArtifactDirectoryIssue
            reason: mutable sview = ""


        const enum DifferentialRunnerIssueKind of u8:
            None
            MissingName
            MissingTarget
            MissingEntry
            UnexpectedEntry
            InvalidTimeout
            InvalidOutputLimit
            InvalidEnvironmentName
            EmbeddedNul
            TooManyArguments
            TooManyEnvironmentEntries
            TooManyProcessTextBytes
            TooMuchProcessInput
            InvalidProcessInputPayload


        struct DifferentialRunnerCheck:
            reason: mutable sview = ""
            argument_index: mutable u32 = 0
            valid: mutable bool
            issue: mutable DifferentialRunnerIssueKind


        const enum DifferentialCaseIssueKind of u8:
            None
            MissingName
            InvalidReferenceRunner
            InvalidCandidateRunner
            EmbeddedNul
            DuplicateWorldPath
            InvalidWorldPath
            InvalidWorldFileKind
            InvalidWorldFilePayload
            InvalidWorldStdinPayload
            InvalidArtifactPolicy
            InvalidEngineRequirement
            InvalidTolerance
            InvalidComparator
            InvalidObservationSchema
            InvalidLimit
            InvalidWorldFileMode


        struct DifferentialCaseCheck:
            reason: mutable sview = ""
            valid: mutable bool
            issue: mutable DifferentialCaseIssueKind
            runner_issue: mutable DifferentialRunnerIssueKind = DifferentialRunnerIssueKind.None


        struct DifferentialObservationSchemaCheck:
            valid: bool
            index: u32 = 0
            reason: sview = ""


        const enum DifferentialShrinkKind of u8:
            RemoveWorldFile
            ClearWorldFileBytes
            RemoveWorldArgument
            RemoveWorldEnvironment
            ClearWorldStdin
            ClearWorldStdinBytes


        struct DifferentialShrinkCandidate:
            kind: DifferentialShrinkKind
            reduced_case: DifferentialCase


        struct DifferentialShrinkResult:
            valid: bool
            candidates: darray[DifferentialShrinkCandidate]


        const enum DifferentialRunShrinkKind of u8:
            ClearReferenceStdout
            ClearCandidateStdout
            ClearReferenceStderr
            ClearCandidateStderr
            RemoveReferenceObservation
            RemoveCandidateObservation
            ClearReferenceValueSlot
            ClearCandidateValueSlot


        struct DifferentialRunShrinkCandidate:
            kind: DifferentialRunShrinkKind
            reference: DifferentialRun
            candidate: DifferentialRun


        struct DifferentialRunShrinkResult:
            valid: bool
            original_kind: DifferentialDifferenceKind
            candidates: darray[DifferentialRunShrinkCandidate]


    private:
        const enum DifferentialRunnerCheckState of u8:
            Name
            Target
            Entry
            Arguments
            WorkingDirectory
            Environment
            ProcessBounds
            Timeout
            OutputLimit
            Done


        struct DifferentialRunnerCursor:
            state: mutable DifferentialRunnerCheckState
            argument_index: mutable usize
            result: mutable DifferentialRunnerCheck


    public:
        # The host adapter consumes this shell-free invocation. `executable` is
        # kept separate from the argv vector so no quoting or expansion step can
        # be introduced between validation and launch.
        struct DifferentialProcessInvocation:
            executable: sview
            entry: sview = ""
            arguments: darray[sview]
            working_directory: sview = ""
            environment: darray[DifferentialEnvironmentEntry] = []
            stdin: sview = ""
            stdin_bytes: mutable darray[u8] = []
            stdin_binary: bool = false
            protocol: sview = ""
            timeout_steps: u64 = 1
            max_output_bytes: u64 = DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES


    private:
        const enum DifferentialCaseCheckState of u8:
            Name
            Reference
            Candidate
            World
            ObservationSchema
            Limits
            Done


        struct DifferentialCaseCheckCursor:
            state: mutable DifferentialCaseCheckState
            result: mutable DifferentialCaseCheck


        def differential_world_path_segment_safe(path: sview, start: usize, end: usize) -> bool:
            length: usize = end - start
            return false if length == 0
            return false if length == 1 and sview_at(path, start) == 46
            return false if length == 2 and sview_at(path, start) == 46 and sview_at(path, start + 1) == 46
            return true


        # Fixture paths are relative names inside the materialized world. The
        # segment walk rejects absolute paths, dot segments, empty segments,
        # and parent traversal before any host filesystem operation occurs.
        def differential_world_fixture_path_safe(path: sview) -> bool:
            length: usize = sview_len(path)
            return false if length == 0 or length > DIFFERENTIAL_DEFAULT_MAX_WORLD_PATH_BYTES
            return false if differential_sview_has_nul(path) or sview_at(path, 0) == 47
            segment_start: mutable usize = 0
            index: mutable usize = 0
            while index < length:
                if sview_at(path, index) == 47:
                    return false if not differential_world_path_segment_safe(path, segment_start, index)
                    segment_start <- index + 1
                index <- index + 1
            return differential_world_path_segment_safe(path, segment_start, length)


        def differential_world_file_kind_valid(kind: DifferentialWorldFileKind) -> bool:
            return kind in {DifferentialWorldFileKind.Text, DifferentialWorldFileKind.Bytes}


        # World fixtures describe ordinary POSIX permission bits only. Special
        # setuid/setgid/sticky bits are host identity policy, not portable test
        # input, and must never reach a later chmod adapter.
        def differential_world_file_mode_valid(mode: u32) -> bool:
            return mode <= 511


        def differential_world_payload_add_fits(total: mutable usize&, amount: usize) -> bool:
            return false if total > DIFFERENTIAL_DEFAULT_MAX_WORLD_BYTES
            return false if amount > DIFFERENTIAL_DEFAULT_MAX_WORLD_BYTES - total
            total <- total + amount
            return true


        def differential_world_payload_text_fits(total: mutable usize&, value: sview) -> bool:
            return differential_world_payload_add_fits(total, sview_len(value))


        def differential_world_payload_bytes_fits(total: mutable usize&, value: darray[u8]&) -> bool:
            return differential_world_payload_add_fits(total, value.count)


        def differential_world_payload_fits(world: DifferentialWorld&) -> bool:
            total: mutable usize = 0
            return false if not differential_world_payload_text_fits(total, world.working_directory) or not differential_world_payload_text_fits(total, world.locale) or not differential_world_payload_text_fits(total, world.timezone)
            if world.stdin_binary:
                return false if not differential_world_payload_bytes_fits(total, world.stdin_bytes)
            else:
                return false if not differential_world_payload_text_fits(total, world.stdin)
            for argument in world.argv |total|:
                return false if not differential_world_payload_text_fits(total, argument)
            for entry in world.environment |total|:
                return false if not differential_world_payload_text_fits(total, entry.name) or not differential_world_payload_text_fits(total, entry.value)
            for fixture in world.files |total|:
                return false if not differential_world_payload_text_fits(total, fixture.path)
                return false if not differential_world_payload_text_fits(total, fixture.contents) or not differential_world_payload_bytes_fits(total, fixture.bytes)
            return total <= DIFFERENTIAL_DEFAULT_MAX_WORLD_BYTES


        # Check only lengths before any NUL, duplicate, or path scan. This
        # keeps borrowed hostile views out of byte-walking helpers even when
        # the caller bypasses a typed world builder.
        def differential_world_text_field_lengths_valid(world: DifferentialWorld&) -> bool:
            return false if sview_len(world.working_directory) > DIFFERENTIAL_DEFAULT_MAX_WORLD_PATH_BYTES or sview_len(world.locale) > DIFFERENTIAL_DEFAULT_MAX_WORLD_METADATA_BYTES or sview_len(world.timezone) > DIFFERENTIAL_DEFAULT_MAX_WORLD_METADATA_BYTES
            return false if sview_len(world.stdin) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_INPUT_BYTES
            for argument in world.argv:
                return false if sview_len(argument) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES
            for entry in world.environment:
                return false if sview_len(entry.name) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES or sview_len(entry.value) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES
            for fixture in world.files:
                return false if sview_len(fixture.path) > DIFFERENTIAL_DEFAULT_MAX_WORLD_PATH_BYTES
            return true


        def differential_case_name_valid(value: sview) -> bool:
            return false if sview_len(value) == 0 or sview_len(value) > DIFFERENTIAL_DEFAULT_MAX_WORLD_METADATA_BYTES
            return not differential_sview_has_nul(value)


        def differential_world_issue(world: DifferentialWorld&) -> DifferentialCaseIssueKind:
            return DifferentialCaseIssueKind.InvalidLimit if not differential_world_text_field_lengths_valid(world)
            return DifferentialCaseIssueKind.EmbeddedNul if differential_sview_has_nul(world.working_directory) or differential_sview_has_nul(world.locale) or differential_sview_has_nul(world.timezone)
            return DifferentialCaseIssueKind.InvalidLimit if sview_len(world.stdin) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_INPUT_BYTES or world.files.count > DIFFERENTIAL_DEFAULT_MAX_ARGUMENTS or world.environment.count > DIFFERENTIAL_DEFAULT_MAX_ENVIRONMENT_ENTRIES or world.argv.count > DIFFERENTIAL_DEFAULT_MAX_ARGUMENTS
            return DifferentialCaseIssueKind.InvalidWorldStdinPayload if world.stdin_binary and world.stdin != ""
            return DifferentialCaseIssueKind.InvalidWorldStdinPayload if not world.stdin_binary and world.stdin_bytes.count != 0
            return DifferentialCaseIssueKind.InvalidLimit if world.stdin_bytes.count > DIFFERENTIAL_DEFAULT_MAX_PROCESS_INPUT_BYTES
            return DifferentialCaseIssueKind.EmbeddedNul if not differential_environment_valid(world.environment)
            for argument in world.argv:
                return DifferentialCaseIssueKind.EmbeddedNul if differential_sview_has_nul(argument)
            for index in 0..<world.files.count |world|:
                fixture: DifferentialWorldFile = world.files[index]
                return DifferentialCaseIssueKind.InvalidWorldPath if not differential_world_fixture_path_safe(fixture.path)
                return DifferentialCaseIssueKind.InvalidWorldFileKind if not differential_world_file_kind_valid(fixture.kind)
                return DifferentialCaseIssueKind.InvalidWorldFileMode if not differential_world_file_mode_valid(fixture.mode)
                return DifferentialCaseIssueKind.InvalidLimit if fixture.kind == DifferentialWorldFileKind.Text and sview_len(fixture.contents) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES
                return DifferentialCaseIssueKind.InvalidLimit if fixture.kind == DifferentialWorldFileKind.Bytes and fixture.bytes.count > DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES
                return DifferentialCaseIssueKind.InvalidWorldFilePayload if (fixture.kind == DifferentialWorldFileKind.Bytes and fixture.contents != "") or (fixture.kind == DifferentialWorldFileKind.Text and fixture.bytes.count != 0)
                for earlier in 0..<index |world, fixture|:
                    return DifferentialCaseIssueKind.DuplicateWorldPath if world.files[earlier].path == fixture.path
            return DifferentialCaseIssueKind.InvalidLimit if not differential_world_payload_fits(world)
            return DifferentialCaseIssueKind.None


        def differential_world_hash_u64(hash: u64, value: u64) -> u64:
            result: mutable u64 = hash
            for shift in 0..<8 |result, value|:
                result <- EsIr::canonical_artifact_hash_byte(result, (value >> (shift * 8)).u8())
            return result


        def differential_world_hash_text(hash: u64, value: sview) -> u64:
            result: mutable u64 = differential_world_hash_u64(hash, sview_len(value).u64())
            index: mutable usize = 0
            while index < sview_len(value):
                result <- EsIr::canonical_artifact_hash_byte(result, sview_at(value, index))
                index <- index + 1
            return result


        def differential_world_hash_bytes(hash: u64, value: darray[u8]&) -> u64:
            result: mutable u64 = differential_world_hash_u64(hash, value.count.u64())
            for byte in value |result|:
                result <- EsIr::canonical_artifact_hash_byte(result, byte)
            return result


        # Hash the complete validated world without allocating a second byte
        # representation. Length prefixes, field tags, ordering, permissions,
        # and executable bits prevent distinct worlds from collapsing into the
        # same concatenated stream.
        def differential_world_fingerprint(world: DifferentialWorld&) -> u64:
            return 0 if differential_world_issue(world) != DifferentialCaseIssueKind.None
            fingerprint: mutable u64 = 14695981039346656037
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 1)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 1)
            fingerprint <- differential_world_hash_text(fingerprint, world.working_directory)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 2)
            fingerprint <- differential_world_hash_text(fingerprint, world.locale)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 3)
            fingerprint <- differential_world_hash_text(fingerprint, world.timezone)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 4)
            fingerprint <- differential_world_hash_text(fingerprint, world.stdin) if not world.stdin_binary
            if world.stdin_binary:
                fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 9)
                fingerprint <- differential_world_hash_bytes(fingerprint, world.stdin_bytes)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 5)
            fingerprint <- differential_world_hash_u64(fingerprint, world.argv.count.u64())
            for argument in world.argv |fingerprint|:
                fingerprint <- differential_world_hash_text(fingerprint, argument)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 6)
            fingerprint <- differential_world_hash_u64(fingerprint, world.environment.count.u64())
            for entry in world.environment |fingerprint|:
                fingerprint <- differential_world_hash_text(fingerprint, entry.name)
                fingerprint <- differential_world_hash_text(fingerprint, entry.value)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 7)
            fingerprint <- differential_world_hash_u64(fingerprint, world.files.count.u64())
            for fixture in world.files |fingerprint|:
                fingerprint <- differential_world_hash_text(fingerprint, fixture.path)
                fingerprint <- differential_world_hash_u64(fingerprint, fixture.kind.u8().u64())
                fingerprint <- differential_world_hash_text(fingerprint, fixture.contents) if fixture.kind == DifferentialWorldFileKind.Text
                fingerprint <- differential_world_hash_bytes(fingerprint, fixture.bytes) if fixture.kind == DifferentialWorldFileKind.Bytes
                fingerprint <- differential_world_hash_u64(fingerprint, fixture.mode.u64())
                fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 1 if fixture.executable else 0)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 8)
            return differential_world_hash_u64(fingerprint, world.seed)


        def differential_artifact_policy_valid(policy: DifferentialArtifactPolicy) -> bool:
            return policy in {DifferentialArtifactPolicy.Never, DifferentialArtifactPolicy.OnMismatch, DifferentialArtifactPolicy.Always}


        def differential_engine_requirement_valid(requirement: DifferentialEngineRequirement) -> bool:
            return requirement in {DifferentialEngineRequirement.Ignore, DifferentialEngineRequirement.RequireKnown, DifferentialEngineRequirement.RequireDistinct, DifferentialEngineRequirement.RequireDirectBytecodeCandidate}


        def differential_float_tolerance_valid(tolerance: DifferentialFloatTolerance) -> bool:
            return false if tolerance.absolute < 0.0 or tolerance.relative < 0.0
            return false if tolerance.absolute != tolerance.absolute or tolerance.relative != tolerance.relative
            return false if tolerance.absolute * 0.0 != 0.0 or tolerance.relative * 0.0 != 0.0
            return true


        def differential_comparator_policy_valid(policy: DifferentialComparatorPolicy) -> bool:
            return false if not differential_float_tolerance_valid(policy.float_tolerance)
            return false if policy.text != DifferentialTextComparison.Exact and policy.text != DifferentialTextComparison.TrimFinalNewline
            return policy.maps == DifferentialMapComparison.Unordered or policy.maps == DifferentialMapComparison.Ordered


        # `tolerance` predates the structured comparator policy and remains in
        # the public case for source compatibility. A non-default legacy value
        # is promoted into the manifest policy; new callers should set the
        # nested field directly.
        def differential_case_comparator(case: DifferentialCase&) -> DifferentialComparatorPolicy:
            result: mutable DifferentialComparatorPolicy = case.comparator
            if case.tolerance.absolute != 0.0 or case.tolerance.relative != 0.0:
                result.float_tolerance <- case.tolerance
            return result


        def differential_case_effective_limit(case_limit: u64, runner_limit: u64) -> u64:
            return runner_limit if case_limit == 0 or runner_limit <= case_limit
            return case_limit


        # The schema is stored in trace order, so each emitted observation is
        # checked with a bounded binary search. Counts are allocated once per
        # declared site; this keeps validation O(observations * log(sites))
        # instead of rescanning the whole schema for every runtime event.
        def differential_observation_site_index(schema: DifferentialObservationSchema&, trace: u64) -> usize:
            low: mutable usize = 0
            high: mutable usize = schema.sites.count
            while low < high:
                middle: usize = low + (high - low) / 2
                if schema.sites[middle].trace < trace:
                    low <- middle + 1
                else:
                    high <- middle
            return schema.sites.count if low >= schema.sites.count
            return schema.sites.count if schema.sites[low].trace != trace
            return low


        def differential_run_observation_schema_check(run: DifferentialRun&, schema: DifferentialObservationSchema&) -> DifferentialObservationSchemaCheck can[Memory.Allocate, Abort.Panic]:
            return DifferentialObservationSchemaCheck{valid: false, reason: "run observation count exceeds schema budget"} if run.observations.count > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS
            counts: mutable darray[u32] = []
            counts.reserve(schema.sites.count)
            for _ in 0..<schema.sites.count |counts|:
                counts.push(0)
            for observation_index in 0..<run.observations.count |run, schema, counts|:
                observation: DifferentialObservation = run.observations[observation_index]
                site_index: usize = differential_observation_site_index(schema, observation.trace)
                return DifferentialObservationSchemaCheck{valid: false, index: observation_index.u32(), reason: "run emitted an undeclared observation trace"} if site_index >= schema.sites.count
                site: DifferentialObservationSite = schema.sites[site_index]
                return DifferentialObservationSchemaCheck{valid: false, index: site_index.u32(), reason: "observation value kind violates its site schema"} if not differential_value_kind_valid(observation.value.kind) or observation.value.kind != site.value_kind
                return DifferentialObservationSchemaCheck{valid: false, index: observation_index.u32(), reason: "observation site exceeded its maximum occurrence count"} if counts[site_index] >= site.maximum_count
                counts[site_index] <- counts[site_index] + 1
            for site_index in 0..<schema.sites.count |schema, counts|:
                return DifferentialObservationSchemaCheck{valid: false, index: site_index.u32(), reason: "required observation site was omitted"} if counts[site_index] < schema.sites[site_index].minimum_count
            return DifferentialObservationSchemaCheck{valid: true}


        # Reconstruct the whole runner so narrowing execution limits cannot
        # accidentally discard adapter configuration or dynamic handler state.
        def differential_case_runner_with_limits(runner: DifferentialRunner&, timeout_steps: u64, max_output_bytes: u64) -> DifferentialRunner:
            return DifferentialRunner{kind: runner.kind, name: runner.name, target: runner.target, entry: runner.entry, arguments: runner.arguments, handlers: runner.handlers, working_directory: runner.working_directory, environment: runner.environment, stdin: runner.stdin, stdin_bytes: runner.stdin_bytes, stdin_binary: runner.stdin_binary, protocol: runner.protocol, timeout_steps: timeout_steps, max_output_bytes: max_output_bytes, required_effects: runner.required_effects, required_errors: runner.required_errors}


    public:
        # Validate the complete case envelope before either runner is handed to
        # an adapter. Nested runner failures retain their original issue kind so a
        # malformed reference cannot be misreported as candidate behavior.
        def validate_differential_case(case: DifferentialCase&) -> DifferentialCaseCheck:
            cursor: mutable DifferentialCaseCheckCursor = DifferentialCaseCheckCursor{state: DifferentialCaseCheckState.Name, result: DifferentialCaseCheck{valid: true, issue: DifferentialCaseIssueKind.None}}
            machine over cursor.state while cursor.result.valid:
                state Validate
                start Validate

                Validate, DifferentialCaseCheckState.Name if differential_case_name_valid(case.name):
                    cursor.state <- DifferentialCaseCheckState.Reference
                    -> Validate
                Validate, DifferentialCaseCheckState.Name:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialCaseIssueKind.MissingName
                    cursor.result.reason <- "differential case name is required and must not contain NUL"
                    -> Validate

                Validate, DifferentialCaseCheckState.Reference:
                    nested: DifferentialRunnerCheck = validate_differential_runner(case.reference)
                    if nested.valid:
                        cursor.state <- DifferentialCaseCheckState.Candidate
                    else:
                        cursor.result.valid <- false
                        cursor.result.issue <- DifferentialCaseIssueKind.InvalidReferenceRunner
                        cursor.result.runner_issue <- nested.issue
                        cursor.result.reason <- "reference runner is invalid"
                    -> Validate

                Validate, DifferentialCaseCheckState.Candidate:
                    nested: DifferentialRunnerCheck = validate_differential_runner(case.candidate)
                    if nested.valid:
                        cursor.state <- DifferentialCaseCheckState.World
                    else:
                        cursor.result.valid <- false
                        cursor.result.issue <- DifferentialCaseIssueKind.InvalidCandidateRunner
                        cursor.result.runner_issue <- nested.issue
                        cursor.result.reason <- "candidate runner is invalid"
                    -> Validate

                Validate, DifferentialCaseCheckState.World:
                    world_issue: DifferentialCaseIssueKind = differential_world_issue(case.world)
                    if world_issue == DifferentialCaseIssueKind.None:
                        cursor.state <- DifferentialCaseCheckState.ObservationSchema
                    else:
                        cursor.result.valid <- false
                        cursor.result.issue <- world_issue
                        cursor.result.reason <- "differential world is invalid"
                    -> Validate

                Validate, DifferentialCaseCheckState.ObservationSchema if differential_observation_schema_valid(case.observation_schema):
                    cursor.state <- DifferentialCaseCheckState.Limits
                    -> Validate
                Validate, DifferentialCaseCheckState.ObservationSchema:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialCaseIssueKind.InvalidObservationSchema
                    cursor.result.reason <- "differential observation schema is invalid"
                    -> Validate

                Validate, DifferentialCaseCheckState.Limits if (case.timeout_steps == 0 or case.timeout_steps <= DIFFERENTIAL_DEFAULT_MAX_TIMEOUT_STEPS) and (case.max_output_bytes == 0 or case.max_output_bytes <= DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES) and differential_artifact_policy_valid(case.artifact_policy) and differential_engine_requirement_valid(case.engine_requirement) and differential_float_tolerance_valid(case.tolerance) and differential_comparator_policy_valid(case.comparator):
                    cursor.state <- DifferentialCaseCheckState.Done
                    -> Validate
                Validate, DifferentialCaseCheckState.Limits:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialCaseIssueKind.InvalidArtifactPolicy if not differential_artifact_policy_valid(case.artifact_policy) else DifferentialCaseIssueKind.InvalidEngineRequirement if not differential_engine_requirement_valid(case.engine_requirement) else DifferentialCaseIssueKind.InvalidTolerance if not differential_float_tolerance_valid(case.tolerance) else DifferentialCaseIssueKind.InvalidComparator if not differential_comparator_policy_valid(case.comparator) else DifferentialCaseIssueKind.InvalidLimit
                    cursor.result.reason <- "differential case policy or limit is invalid"
                    -> Validate

                Validate, DifferentialCaseCheckState.Done:
                    break

            return cursor.result


        # Produce the selected side's runner with the case ceilings applied.
        # Zero case limits inherit the side's runner value; nonzero limits can
        # only narrow it. This validates both sides and the world first, so a
        # caller cannot accidentally begin a half-valid differential run.
        # World materialization and merging remain the orchestration adapter's
        # responsibility.
        def prepare_differential_case_runner(case: DifferentialCase&, side: DifferentialCaseSide) -> DifferentialRunner error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            check: DifferentialCaseCheck = validate_differential_case(case)
            raise DifferentialRunnerError.Invalid if not check.valid
            selected: mutable DifferentialRunner = case.reference
            match side:
                DifferentialCaseSide.Reference:
                    selected <- case.reference
                DifferentialCaseSide.Candidate:
                    selected <- case.candidate
                _:
                    raise DifferentialRunnerError.Invalid
            timeout_steps: u64 = differential_case_effective_limit(case.timeout_steps, selected.timeout_steps)
            max_output_bytes: u64 = differential_case_effective_limit(case.max_output_bytes, selected.max_output_bytes)
            return differential_case_runner_with_limits(selected, timeout_steps, max_output_bytes)


        def make_differential_artifact_manifest(case: DifferentialCase&, module_fingerprint: u64 = 0, module_digest_0: u64 = 0, module_digest_1: u64 = 0, module_digest_2: u64 = 0, module_digest_3: u64 = 0, bind_module_digest: bool = false) -> DifferentialArtifactManifest error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            check: DifferentialCaseCheck = validate_differential_case(case)
            raise DifferentialRunnerError.Invalid if not check.valid
            world_fingerprint: u64 = differential_world_fingerprint(case.world)
            raise DifferentialRunnerError.Invalid if world_fingerprint == 0
            schema_bytes: darray[u8] = differential_observation_schema_canonical_bytes(case.observation_schema)
            schema_digest: darray[u8] = EsIr::canonical_bytes_sha256(schema_bytes)
            raise DifferentialRunnerError.Invalid if schema_digest.count != 32
            has_module_digest: bool = bind_module_digest or module_digest_0 != 0 or module_digest_1 != 0 or module_digest_2 != 0 or module_digest_3 != 0
            return DifferentialArtifactManifest{format_version: 5, case_name: case.name, reference_name: case.reference.name, candidate_name: case.candidate.name, world_seed: case.world.seed, world_fingerprint: world_fingerprint, case_seed: case.seed, engine_requirement: case.engine_requirement, artifact_policy: case.artifact_policy, module_fingerprint: module_fingerprint, module_digest_0: module_digest_0, module_digest_1: module_digest_1, module_digest_2: module_digest_2, module_digest_3: module_digest_3, module_digest_present: has_module_digest, comparator: differential_case_comparator(case), observation_schema_digest_0: EsIr::canonical_digest_word(schema_digest, 0), observation_schema_digest_1: EsIr::canonical_digest_word(schema_digest, 1), observation_schema_digest_2: EsIr::canonical_digest_word(schema_digest, 2), observation_schema_digest_3: EsIr::canonical_digest_word(schema_digest, 3)}


        # Preferred constructor for an Elisascript-backed differential case.
        # Keeping digest derivation here prevents callers from accidentally
        # passing only the compact fingerprint and omitting module-code
        # binding when the verified module is available.
        def make_differential_artifact_manifest_for_module(case: DifferentialCase&, module: Module&) -> DifferentialArtifactManifest error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            module_digest: darray[u8] = canonical_module_digest(module)
            raise DifferentialRunnerError.Invalid if module_digest.count != 32
            manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(case, module_fingerprint(module), canonical_digest_word(module_digest, 0), canonical_digest_word(module_digest, 1), canonical_digest_word(module_digest, 2), canonical_digest_word(module_digest, 3), true)
            raise DifferentialRunnerError.Invalid if manifest.format_version != 5
            return manifest


        const DIFFERENTIAL_MAX_MANIFEST_BYTES: usize = 65536


        def differential_manifest_text_bytes_fits(manifest: DifferentialArtifactManifest) -> bool:
            total: mutable usize = 0
            length: usize = sview_len(manifest.case_name)
            return false if length > DIFFERENTIAL_MAX_MANIFEST_BYTES - total
            total <- total + length
            length <- sview_len(manifest.reference_name)
            return false if length > DIFFERENTIAL_MAX_MANIFEST_BYTES - total
            total <- total + length
            length <- sview_len(manifest.candidate_name)
            return false if length > DIFFERENTIAL_MAX_MANIFEST_BYTES - total
            return true


        def differential_artifact_manifest_valid(manifest: DifferentialArtifactManifest&) -> bool:
            return false if manifest.format_version != 1 and manifest.format_version != 2 and manifest.format_version != 3 and manifest.format_version != 4 and manifest.format_version != 5
            return false if manifest.case_name == "" or manifest.reference_name == "" or manifest.candidate_name == ""
            return false if not differential_manifest_text_bytes_fits(manifest)
            return false if differential_sview_has_nul(manifest.case_name) or differential_sview_has_nul(manifest.reference_name) or differential_sview_has_nul(manifest.candidate_name)
            return false if manifest.format_version == 2 and manifest.world_fingerprint == 0
            return false if manifest.format_version == 3 and manifest.world_fingerprint == 0
            return false if manifest.format_version == 4 and manifest.world_fingerprint == 0
            return false if manifest.format_version == 5 and manifest.world_fingerprint == 0
            return false if manifest.format_version == 5 and not manifest.module_digest_present and (manifest.module_digest_0 != 0 or manifest.module_digest_1 != 0 or manifest.module_digest_2 != 0 or manifest.module_digest_3 != 0)
            return false if not differential_artifact_policy_valid(manifest.artifact_policy) or not differential_engine_requirement_valid(manifest.engine_requirement)
            return false if manifest.format_version >= 3 and not differential_comparator_policy_valid(manifest.comparator)
            return true


        # Deterministic, versioned metadata bytes are suitable for an artifact
        # sidecar or cache key. Output payloads remain separate files so a
        # manifest can be validated before any large observation is opened.
        def canonical_differential_artifact_manifest_bytes(manifest: DifferentialArtifactManifest) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not differential_artifact_manifest_valid(manifest)
            output: mutable darray[u8] = []
            EsIr::canonical_artifact_emit_byte(output, 69)
            EsIr::canonical_artifact_emit_byte(output, 83)
            EsIr::canonical_artifact_emit_byte(output, 68)
            EsIr::canonical_artifact_emit_byte(output, 70)
            EsIr::canonical_artifact_emit_byte(output, manifest.format_version)
            EsIr::canonical_artifact_emit_text(output, manifest.case_name)
            EsIr::canonical_artifact_emit_text(output, manifest.reference_name)
            EsIr::canonical_artifact_emit_text(output, manifest.candidate_name)
            EsIr::canonical_artifact_emit_u64(output, manifest.world_seed)
            EsIr::canonical_artifact_emit_u64(output, manifest.world_fingerprint) if manifest.format_version >= 2
            EsIr::canonical_artifact_emit_u64(output, manifest.case_seed)
            EsIr::canonical_artifact_emit_byte(output, manifest.engine_requirement.u8())
            EsIr::canonical_artifact_emit_byte(output, manifest.artifact_policy.u8())
            EsIr::canonical_artifact_emit_u64(output, manifest.module_fingerprint)
            if manifest.format_version >= 4:
                EsIr::canonical_artifact_emit_byte(output, 1 if manifest.module_digest_present else 0) if manifest.format_version >= 5
                EsIr::canonical_artifact_emit_u64(output, manifest.module_digest_0)
                EsIr::canonical_artifact_emit_u64(output, manifest.module_digest_1)
                EsIr::canonical_artifact_emit_u64(output, manifest.module_digest_2)
                EsIr::canonical_artifact_emit_u64(output, manifest.module_digest_3)
            if manifest.format_version >= 5:
                EsIr::canonical_artifact_emit_u64(output, manifest.observation_schema_digest_0)
                EsIr::canonical_artifact_emit_u64(output, manifest.observation_schema_digest_1)
                EsIr::canonical_artifact_emit_u64(output, manifest.observation_schema_digest_2)
                EsIr::canonical_artifact_emit_u64(output, manifest.observation_schema_digest_3)
            if manifest.format_version >= 3:
                EsIr::canonical_artifact_emit_byte(output, manifest.comparator.text.u8())
                EsIr::canonical_artifact_emit_byte(output, manifest.comparator.maps.u8())
                EsIr::canonical_artifact_emit_u64(output, differential_float_bits(manifest.comparator.float_tolerance.absolute))
                EsIr::canonical_artifact_emit_u64(output, differential_float_bits(manifest.comparator.float_tolerance.relative))
            return [] if output.count > DIFFERENTIAL_MAX_MANIFEST_BYTES
            return output


        def differential_artifact_manifest_fingerprint(manifest: DifferentialArtifactManifest) -> u64 can[Memory.Allocate, Abort.Panic]:
            encoded: darray[u8] = canonical_differential_artifact_manifest_bytes(manifest)
            return 0 if encoded.count == 0
            fingerprint: mutable u64 = 14695981039346656037
            for byte in encoded |fingerprint|:
                fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, byte)
            return fingerprint


    private:
        def differential_manifest_read_u64(bytes: darray[u8]&, offset: mutable usize&, value: mutable u64&) -> bool:
            return false if offset > bytes.count
            return false if bytes.count - offset < 8
            value <- 0
            for shift in 0..<8 |bytes, offset, value|:
                value <- value | (bytes[offset + shift].u64() << (shift * 8))
            offset <- offset + 8
            return true


        def differential_manifest_read_i64(bytes: darray[u8]&, offset: mutable usize&, value: mutable i64&) -> bool:
            bits: mutable u64 = 0
            return false if not differential_manifest_read_u64(bytes, offset, bits)
            value <- bits.i64()
            return true


        def differential_manifest_read_u32(bytes: darray[u8]&, offset: mutable usize&, value: mutable u32&) -> bool:
            return false if offset > bytes.count
            return false if bytes.count - offset < 4
            value <- 0
            for shift in 0..<4 |bytes, offset, value|:
                value <- value | (bytes[offset + shift].u32() << (shift * 8))
            offset <- offset + 4
            return true


        def differential_manifest_read_text_bounds(bytes: darray[u8]&, offset: mutable usize&, start: mutable usize&, end: mutable usize&) -> bool:
            length: mutable u64 = 0
            return false if not differential_manifest_read_u64(bytes, offset, length)
            start <- offset
            return false if length.usize().u64() != length
            length_host: usize = length.usize()
            return false if not runtime_bounded_slice_end(offset, length_host, bytes.count, end)
            offset <- end
            return true


        def differential_manifest_text_view(bytes: darray[u8]&, start: usize, end: usize) -> sview can[Unsafe.PointerCast]:
            return sview("", 0, 0) if end <= start
            base: u8& = (&bytes[start]).cast[u8&]
            return base[0:(end - start)]


        def differential_decode_artifact_manifest(bytes: darray[u8]&) -> DifferentialArtifactManifestDecode can[Unsafe.PointerCast]:
            invalid: DifferentialArtifactManifest = DifferentialArtifactManifest{case_name: "", reference_name: "", candidate_name: ""}
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if bytes.count < 5 or bytes.count > DIFFERENTIAL_MAX_MANIFEST_BYTES
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if bytes[0] != 69 or bytes[1] != 83 or bytes[2] != 68 or bytes[3] != 70 or (bytes[4] != 1 and bytes[4] != 2 and bytes[4] != 3 and bytes[4] != 4 and bytes[4] != 5)
            format_version: u8 = bytes[4]
            offset: mutable usize = 5
            case_start: mutable usize = 0
            case_end: mutable usize = 0
            reference_start: mutable usize = 0
            reference_end: mutable usize = 0
            candidate_start: mutable usize = 0
            candidate_end: mutable usize = 0
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if not differential_manifest_read_text_bounds(bytes, offset, case_start, case_end) or not differential_manifest_read_text_bounds(bytes, offset, reference_start, reference_end) or not differential_manifest_read_text_bounds(bytes, offset, candidate_start, candidate_end)
            world_seed: mutable u64 = 0
            world_fingerprint: mutable u64 = 0
            case_seed: mutable u64 = 0
            module_fingerprint: mutable u64 = 0
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if not differential_manifest_read_u64(bytes, offset, world_seed)
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if format_version >= 2 and not differential_manifest_read_u64(bytes, offset, world_fingerprint)
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if not differential_manifest_read_u64(bytes, offset, case_seed)
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if offset >= bytes.count
            engine_byte: u8 = bytes[offset]
            offset <- offset + 1
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if not differential_engine_requirement_byte_valid(engine_byte)
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if offset >= bytes.count
            policy_byte: u8 = bytes[offset]
            offset <- offset + 1
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if not differential_artifact_policy_byte_valid(policy_byte)
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if not differential_manifest_read_u64(bytes, offset, module_fingerprint)
            module_digest_0: mutable u64 = 0
            module_digest_1: mutable u64 = 0
            module_digest_2: mutable u64 = 0
            module_digest_3: mutable u64 = 0
            module_digest_present: mutable bool = false
            if format_version >= 5:
                return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if offset >= bytes.count
                module_digest_present_byte: u8 = bytes[offset]
                offset <- offset + 1
                return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if module_digest_present_byte > 1
                module_digest_present <- module_digest_present_byte == 1
            module_digest_present <- true if format_version == 4
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if format_version >= 4 and (not differential_manifest_read_u64(bytes, offset, module_digest_0) or not differential_manifest_read_u64(bytes, offset, module_digest_1) or not differential_manifest_read_u64(bytes, offset, module_digest_2) or not differential_manifest_read_u64(bytes, offset, module_digest_3))
            observation_schema_digest_0: mutable u64 = 0
            observation_schema_digest_1: mutable u64 = 0
            observation_schema_digest_2: mutable u64 = 0
            observation_schema_digest_3: mutable u64 = 0
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if format_version >= 5 and (not differential_manifest_read_u64(bytes, offset, observation_schema_digest_0) or not differential_manifest_read_u64(bytes, offset, observation_schema_digest_1) or not differential_manifest_read_u64(bytes, offset, observation_schema_digest_2) or not differential_manifest_read_u64(bytes, offset, observation_schema_digest_3))
            engine: DifferentialEngineRequirement = DifferentialEngineRequirement.Ignore
            engine <- DifferentialEngineRequirement.RequireKnown if engine_byte == DifferentialEngineRequirement.RequireKnown.u8()
            engine <- DifferentialEngineRequirement.RequireDistinct if engine_byte == DifferentialEngineRequirement.RequireDistinct.u8()
            engine <- DifferentialEngineRequirement.RequireDirectBytecodeCandidate if engine_byte == DifferentialEngineRequirement.RequireDirectBytecodeCandidate.u8()
            policy: DifferentialArtifactPolicy = DifferentialArtifactPolicy.Never
            policy <- DifferentialArtifactPolicy.OnMismatch if policy_byte == DifferentialArtifactPolicy.OnMismatch.u8()
            policy <- DifferentialArtifactPolicy.Always if policy_byte == DifferentialArtifactPolicy.Always.u8()
            comparator: mutable DifferentialComparatorPolicy = DifferentialComparatorPolicy{}
            if format_version >= 3:
                return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if offset > bytes.count
                return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if bytes.count - offset < 18
                text_byte: u8 = bytes[offset]
                maps_byte: u8 = bytes[offset + 1]
                offset <- offset + 2
                absolute_bits: mutable u64 = 0
                relative_bits: mutable u64 = 0
                return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if not differential_text_comparison_byte_valid(text_byte) or not differential_map_comparison_byte_valid(maps_byte) or not differential_manifest_read_u64(bytes, offset, absolute_bits) or not differential_manifest_read_u64(bytes, offset, relative_bits)
                comparator.text <- DifferentialTextComparison.TrimFinalNewline if text_byte == DifferentialTextComparison.TrimFinalNewline.u8()
                comparator.maps <- DifferentialMapComparison.Ordered if maps_byte == DifferentialMapComparison.Ordered.u8()
                comparator.float_tolerance.absolute <- differential_float_from_bits(absolute_bits)
                comparator.float_tolerance.relative <- differential_float_from_bits(relative_bits)
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if offset != bytes.count
            manifest: DifferentialArtifactManifest = DifferentialArtifactManifest{format_version: format_version, case_name: differential_manifest_text_view(bytes, case_start, case_end), reference_name: differential_manifest_text_view(bytes, reference_start, reference_end), candidate_name: differential_manifest_text_view(bytes, candidate_start, candidate_end), world_seed: world_seed, world_fingerprint: world_fingerprint, case_seed: case_seed, engine_requirement: engine, artifact_policy: policy, module_fingerprint: module_fingerprint, module_digest_0: module_digest_0, module_digest_1: module_digest_1, module_digest_2: module_digest_2, module_digest_3: module_digest_3, module_digest_present: module_digest_present, comparator: comparator, observation_schema_digest_0: observation_schema_digest_0, observation_schema_digest_1: observation_schema_digest_1, observation_schema_digest_2: observation_schema_digest_2, observation_schema_digest_3: observation_schema_digest_3}
            return DifferentialArtifactManifestDecode{valid: false, manifest: invalid} if not differential_artifact_manifest_valid(manifest)
            return DifferentialArtifactManifestDecode{valid: true, manifest: manifest}


    public:
        def differential_artifact_manifest_bytes_valid(bytes: darray[u8]&) -> bool can[Unsafe.PointerCast]:
            return differential_decode_artifact_manifest(bytes).valid


        # Version 1--4 manifests remain readable for source compatibility but
        # do not bind a differential run to the observation schema contract. A
        # cache/reproduce loader can use this predicate to require an explicit
        # migration before admitting an old manifest into a schema-bound run.
        def differential_artifact_manifest_requires_migration(bytes: darray[u8]&) -> bool can[Unsafe.PointerCast]:
            decoded: DifferentialArtifactManifestDecode = differential_decode_artifact_manifest(bytes)
            return decoded.valid and decoded.manifest.format_version != 5


        def decode_differential_artifact_manifest(bytes: darray[u8]&) -> DifferentialArtifactManifestDecode can[Unsafe.PointerCast]:
            return differential_decode_artifact_manifest(bytes)


    private:
        const DIFFERENTIAL_MAX_PROCESS_STREAM_ARTIFACT_BYTES: usize = 201326592
        const DIFFERENTIAL_MAX_PROCESS_STREAM_ARTIFACT_TEXT_BYTES: usize = 201326528


        def differential_artifact_side_valid(side: DifferentialArtifactSide) -> bool:
            return side in {DifferentialArtifactSide.Reference, DifferentialArtifactSide.Candidate}


        def differential_process_stream_artifact_text_bytes_fits(artifact: DifferentialProcessStreamArtifact&) -> bool:
            return false if sview_len(artifact.error_text) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES
            return false if sview_len(artifact.stdout) > DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES
            return false if sview_len(artifact.stderr) > DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES
            total: mutable usize = 0
            length: usize = sview_len(artifact.error_text)
            return false if length > DIFFERENTIAL_MAX_PROCESS_STREAM_ARTIFACT_TEXT_BYTES - total
            total <- total + length
            length <- sview_len(artifact.stdout)
            return false if length > DIFFERENTIAL_MAX_PROCESS_STREAM_ARTIFACT_TEXT_BYTES - total
            total <- total + length
            length <- sview_len(artifact.stderr)
            return false if length > DIFFERENTIAL_MAX_PROCESS_STREAM_ARTIFACT_TEXT_BYTES - total
            total <- total + length
            return total <= DIFFERENTIAL_MAX_PROCESS_STREAM_ARTIFACT_TEXT_BYTES


        # A DifferentialRun can be assembled by an in-process adapter without
        # passing through the process-stream artifact constructor. Reuse the
        # same per-channel and aggregate text contract before comparison so a
        # borrowed snapshot cannot make the comparator walk an unbounded view.
        def differential_run_text_bytes_fits(run: DifferentialRun&) -> bool:
            artifact: DifferentialProcessStreamArtifact = DifferentialProcessStreamArtifact{error_text: run.error_text, stdout: run.stdout, stderr: run.stderr}
            return differential_process_stream_artifact_text_bytes_fits(artifact)


        def differential_process_stream_artifact_valid(artifact: DifferentialProcessStreamArtifact&) -> bool:
            return false if artifact.format_version != 1
            return false if artifact.manifest_fingerprint == 0
            return false if not differential_artifact_side_valid(artifact.side)
            return false if not differential_run_outcome_valid(artifact.outcome)
            return differential_process_stream_artifact_text_bytes_fits(artifact)


    public:
        # Capture one complete bounded process-facing run payload. The
        # side identity keeps reference and candidate streams distinct
        # even when they happen to contain identical bytes.
        def make_differential_process_stream_artifact(manifest: DifferentialArtifactManifest&, side: DifferentialArtifactSide, run: DifferentialRun&) -> DifferentialProcessStreamArtifact error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialRunnerError.Invalid if not differential_artifact_manifest_valid(manifest) or not differential_artifact_side_valid(side) or not differential_run_outcome_valid(run.outcome)
            manifest_fingerprint: u64 = differential_artifact_manifest_fingerprint(manifest)
            raise DifferentialRunnerError.Invalid if manifest_fingerprint == 0
            artifact: DifferentialProcessStreamArtifact = DifferentialProcessStreamArtifact{manifest_fingerprint: manifest_fingerprint, side: side, outcome: run.outcome, exit_status: run.exit_status, error_text: run.error_text, stdout: run.stdout, stderr: run.stderr}
            raise DifferentialRunnerError.OutputLimit if not differential_process_stream_artifact_text_bytes_fits(artifact)
            return artifact


        def canonical_differential_process_stream_artifact_bytes(artifact: DifferentialProcessStreamArtifact) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not differential_process_stream_artifact_valid(artifact)
            output: mutable darray[u8] = []
            EsIr::canonical_artifact_emit_byte(output, 69)
            EsIr::canonical_artifact_emit_byte(output, 83)
            EsIr::canonical_artifact_emit_byte(output, 80)
            EsIr::canonical_artifact_emit_byte(output, 83)
            EsIr::canonical_artifact_emit_byte(output, artifact.format_version)
            EsIr::canonical_artifact_emit_u64(output, artifact.manifest_fingerprint)
            EsIr::canonical_artifact_emit_byte(output, artifact.side.u8())
            EsIr::canonical_artifact_emit_byte(output, artifact.outcome.u8())
            EsIr::canonical_artifact_emit_i64(output, artifact.exit_status)
            EsIr::canonical_artifact_emit_text(output, artifact.error_text)
            EsIr::canonical_artifact_emit_text(output, artifact.stdout)
            EsIr::canonical_artifact_emit_text(output, artifact.stderr)
            return [] if output.count > DIFFERENTIAL_MAX_PROCESS_STREAM_ARTIFACT_BYTES
            return output


        def differential_process_stream_artifact_fingerprint(artifact: DifferentialProcessStreamArtifact) -> u64 can[Memory.Allocate, Abort.Panic]:
            encoded: darray[u8] = canonical_differential_process_stream_artifact_bytes(artifact)
            return 0 if encoded.count == 0
            fingerprint: mutable u64 = 14695981039346656037
            for byte in encoded |fingerprint|:
                fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, byte)
            return fingerprint


    private:
        def differential_decode_process_stream_artifact(bytes: darray[u8]&) -> DifferentialProcessStreamArtifactDecode can[Unsafe.PointerCast]:
            invalid: DifferentialProcessStreamArtifact = DifferentialProcessStreamArtifact{}
            return DifferentialProcessStreamArtifactDecode{valid: false, artifact: invalid} if bytes.count < 5 or bytes.count > DIFFERENTIAL_MAX_PROCESS_STREAM_ARTIFACT_BYTES
            return DifferentialProcessStreamArtifactDecode{valid: false, artifact: invalid} if bytes[0] != 69 or bytes[1] != 83 or bytes[2] != 80 or bytes[3] != 83 or bytes[4] != 1
            offset: mutable usize = 5
            manifest_fingerprint: mutable u64 = 0
            return DifferentialProcessStreamArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_u64(bytes, offset, manifest_fingerprint)
            return DifferentialProcessStreamArtifactDecode{valid: false, artifact: invalid} if offset > bytes.count
            return DifferentialProcessStreamArtifactDecode{valid: false, artifact: invalid} if bytes.count - offset < 2
            side_byte: u8 = bytes[offset]
            outcome_byte: u8 = bytes[offset + 1]
            offset <- offset + 2
            return DifferentialProcessStreamArtifactDecode{valid: false, artifact: invalid} if not differential_artifact_side_byte_valid(side_byte) or not differential_run_outcome_byte_valid(outcome_byte)
            exit_status: mutable i64 = 0
            return DifferentialProcessStreamArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_i64(bytes, offset, exit_status)
            error_start: mutable usize = 0
            error_end: mutable usize = 0
            stdout_start: mutable usize = 0
            stdout_end: mutable usize = 0
            stderr_start: mutable usize = 0
            stderr_end: mutable usize = 0
            return DifferentialProcessStreamArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_text_bounds(bytes, offset, error_start, error_end) or not differential_manifest_read_text_bounds(bytes, offset, stdout_start, stdout_end) or not differential_manifest_read_text_bounds(bytes, offset, stderr_start, stderr_end) or offset != bytes.count
            side: DifferentialArtifactSide = DifferentialArtifactSide.Reference
            side <- DifferentialArtifactSide.Candidate if side_byte == DifferentialArtifactSide.Candidate.u8()
            outcome: DifferentialRunOutcome = DifferentialRunOutcome.Completed
            outcome <- DifferentialRunOutcome.NormalError if outcome_byte == DifferentialRunOutcome.NormalError.u8()
            outcome <- DifferentialRunOutcome.SpawnFailure if outcome_byte == DifferentialRunOutcome.SpawnFailure.u8()
            outcome <- DifferentialRunOutcome.Crash if outcome_byte == DifferentialRunOutcome.Crash.u8()
            outcome <- DifferentialRunOutcome.Timeout if outcome_byte == DifferentialRunOutcome.Timeout.u8()
            outcome <- DifferentialRunOutcome.OutputLimit if outcome_byte == DifferentialRunOutcome.OutputLimit.u8()
            outcome <- DifferentialRunOutcome.CompileFailure if outcome_byte == DifferentialRunOutcome.CompileFailure.u8()
            artifact: DifferentialProcessStreamArtifact = DifferentialProcessStreamArtifact{manifest_fingerprint: manifest_fingerprint, side: side, outcome: outcome, exit_status: exit_status, error_text: differential_manifest_text_view(bytes, error_start, error_end), stdout: differential_manifest_text_view(bytes, stdout_start, stdout_end), stderr: differential_manifest_text_view(bytes, stderr_start, stderr_end)}
            return DifferentialProcessStreamArtifactDecode{valid: false, artifact: invalid} if not differential_process_stream_artifact_valid(artifact)
            return DifferentialProcessStreamArtifactDecode{valid: true, artifact: artifact}


    public:
        def differential_process_stream_artifact_bytes_valid(bytes: darray[u8]&) -> bool can[Unsafe.PointerCast]:
            return differential_decode_process_stream_artifact(bytes).valid


        def decode_differential_process_stream_artifact(bytes: darray[u8]&) -> DifferentialProcessStreamArtifactDecode can[Unsafe.PointerCast]:
            return differential_decode_process_stream_artifact(bytes)


    private:
        const DIFFERENTIAL_MAX_REPRODUCTION_ARTIFACT_BYTES: usize = 65536
        const DIFFERENTIAL_MAX_REPRODUCTION_TEXT_BYTES: usize = 65480


        def differential_reproduction_text_valid(value: sview) -> bool:
            return false if sview_len(value) == 0 or sview_len(value) > DIFFERENTIAL_MAX_REPRODUCTION_TEXT_BYTES
            return not differential_sview_has_nul(value)


        def differential_reproduction_artifact_valid(artifact: DifferentialReproductionArtifact&) -> bool:
            return false if artifact.format_version != 1
            return false if artifact.manifest_fingerprint == 0
            return false if not differential_reproduction_text_valid(artifact.target) or not differential_reproduction_text_valid(artifact.entry)
            total: mutable usize = 0
            target_length: usize = sview_len(artifact.target)
            return false if target_length > DIFFERENTIAL_MAX_REPRODUCTION_TEXT_BYTES - total
            total <- total + target_length
            entry_length: usize = sview_len(artifact.entry)
            return false if entry_length > DIFFERENTIAL_MAX_REPRODUCTION_TEXT_BYTES - total
            total <- total + entry_length
            return total <= DIFFERENTIAL_MAX_REPRODUCTION_TEXT_BYTES


    public:
        def make_differential_reproduction_artifact(manifest: DifferentialArtifactManifest&, target: sview, entry: sview) -> DifferentialReproductionArtifact error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialRunnerError.Invalid if not differential_artifact_manifest_valid(manifest) or not differential_reproduction_text_valid(target) or not differential_reproduction_text_valid(entry)
            manifest_fingerprint: u64 = differential_artifact_manifest_fingerprint(manifest)
            raise DifferentialRunnerError.Invalid if manifest_fingerprint == 0
            artifact: DifferentialReproductionArtifact = DifferentialReproductionArtifact{manifest_fingerprint: manifest_fingerprint, target: target, entry: entry}
            raise DifferentialRunnerError.OutputLimit if not differential_reproduction_artifact_valid(artifact)
            return artifact


        def canonical_differential_reproduction_artifact_bytes(artifact: DifferentialReproductionArtifact) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not differential_reproduction_artifact_valid(artifact)
            output: mutable darray[u8] = []
            EsIr::canonical_artifact_emit_byte(output, 69)
            EsIr::canonical_artifact_emit_byte(output, 83)
            EsIr::canonical_artifact_emit_byte(output, 82)
            EsIr::canonical_artifact_emit_byte(output, 80)
            EsIr::canonical_artifact_emit_byte(output, artifact.format_version)
            EsIr::canonical_artifact_emit_u64(output, artifact.manifest_fingerprint)
            EsIr::canonical_artifact_emit_text(output, artifact.target)
            EsIr::canonical_artifact_emit_text(output, artifact.entry)
            return [] if output.count > DIFFERENTIAL_MAX_REPRODUCTION_ARTIFACT_BYTES
            return output


        def differential_reproduction_artifact_fingerprint(artifact: DifferentialReproductionArtifact) -> u64 can[Memory.Allocate, Abort.Panic]:
            encoded: darray[u8] = canonical_differential_reproduction_artifact_bytes(artifact)
            return 0 if encoded.count == 0
            fingerprint: mutable u64 = 14695981039346656037
            for byte in encoded |fingerprint|:
                fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, byte)
            return fingerprint


    private:
        def differential_decode_reproduction_artifact(bytes: darray[u8]&) -> DifferentialReproductionArtifactDecode can[Unsafe.PointerCast]:
            invalid: DifferentialReproductionArtifact = DifferentialReproductionArtifact{}
            return DifferentialReproductionArtifactDecode{valid: false, artifact: invalid} if bytes.count < 5 or bytes.count > DIFFERENTIAL_MAX_REPRODUCTION_ARTIFACT_BYTES
            return DifferentialReproductionArtifactDecode{valid: false, artifact: invalid} if bytes[0] != 69 or bytes[1] != 83 or bytes[2] != 82 or bytes[3] != 80 or bytes[4] != 1
            offset: mutable usize = 5
            manifest_fingerprint: mutable u64 = 0
            return DifferentialReproductionArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_u64(bytes, offset, manifest_fingerprint)
            target_start: mutable usize = 0
            target_end: mutable usize = 0
            entry_start: mutable usize = 0
            entry_end: mutable usize = 0
            return DifferentialReproductionArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_text_bounds(bytes, offset, target_start, target_end) or not differential_manifest_read_text_bounds(bytes, offset, entry_start, entry_end) or offset != bytes.count
            artifact: DifferentialReproductionArtifact = DifferentialReproductionArtifact{manifest_fingerprint: manifest_fingerprint, target: differential_manifest_text_view(bytes, target_start, target_end), entry: differential_manifest_text_view(bytes, entry_start, entry_end)}
            return DifferentialReproductionArtifactDecode{valid: false, artifact: invalid} if not differential_reproduction_artifact_valid(artifact)
            return DifferentialReproductionArtifactDecode{valid: true, artifact: artifact}


    public:
        def differential_reproduction_artifact_bytes_valid(bytes: darray[u8]&) -> bool can[Unsafe.PointerCast]:
            return differential_decode_reproduction_artifact(bytes).valid


        def decode_differential_reproduction_artifact(bytes: darray[u8]&) -> DifferentialReproductionArtifactDecode can[Unsafe.PointerCast]:
            return differential_decode_reproduction_artifact(bytes)


    private:
        const DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_BYTES: usize = 268435456
        const DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_TEXT_BYTES: usize = 268434944


        def differential_float_bits(value: f64) -> u64 can[Unsafe.PointerCast]:
            bits: mutable u64 = 0
            _ = memcpy((&bits).cast[mutable void&], (&value).cast[void&], 8)
            return bits


        def differential_float_from_bits(bits: u64) -> f64 can[Unsafe.PointerCast]:
            value: mutable f64 = 0.0
            _ = memcpy((&value).cast[mutable void&], (&bits).cast[void&], 8)
            return value


        def differential_value_text_bytes_fits(value: DifferentialValue) -> bool:
            return sview_len(value.text) <= DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES and sview_len(value.process_stdout) <= DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES and sview_len(value.process_stderr) <= DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES


        def differential_value_record_valid(storage: darray[DifferentialValue]&, value: DifferentialValue) -> bool:
            return false if not differential_value_kind_valid(value.kind) or not differential_value_text_bytes_fits(value)
            return false if value.kind == DifferentialValueKind.Array and not differential_array_value_range_valid(storage, value)
            return false if value.kind == DifferentialValueKind.Map and not differential_map_value_range_valid(storage, value)
            return true


        def differential_value_text_append_fits(total: mutable usize&, text: sview, limit: usize) -> bool:
            length: usize = sview_len(text)
            return false if length > limit - total
            total <- total + length
            return true


        def differential_value_text_fields_fits(total: mutable usize&, value: DifferentialValue, limit: usize) -> bool:
            return false if not differential_value_text_append_fits(total, value.text, limit)
            return false if not differential_value_text_append_fits(total, value.process_stdout, limit)
            return differential_value_text_append_fits(total, value.process_stderr, limit)


        # Comparison may receive a caller-owned value pool directly rather
        # than through value-pool artifact construction. Validate every flat
        # record's channel limits and the same aggregate envelope used by the
        # serialized value-pool boundary before any scalar text comparison.
        def differential_value_pool_comparison_text_bytes_fits(storage: darray[DifferentialValue]&, total: mutable usize&) -> bool:
            return false if storage.count > DIFFERENTIAL_DEFAULT_MAX_VALUES
            for value in storage |total|:
                return false if not differential_value_text_bytes_fits(value)
                return false if not differential_value_text_fields_fits(total, value, DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_TEXT_BYTES)
            return true


        def differential_capture_observation_values_fit(observations: darray[DifferentialObservation]&, values: darray[DifferentialValue]&, total: mutable usize&) -> bool:
            return false if observations.count > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS
            return false if not differential_value_pool_comparison_text_bytes_fits(values, total)
            for observation in observations |total|:
                return false if not differential_value_text_bytes_fits(observation.value)
                return false if not differential_value_text_fields_fits(total, observation.value, DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_TEXT_BYTES)
            return total <= DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_TEXT_BYTES


        # ProcessCapture adaptation is an admission boundary: reject unknown
        # value kinds and dangling aggregate views before exposing borrowed
        # observations to a DifferentialRun. Direct comparison keeps its
        # structured-mismatch behavior, so this stricter check is adapter-only.
        def differential_capture_observation_values_shape_valid(observations: darray[DifferentialObservation]&, values: darray[DifferentialValue]&) -> bool:
            return false if observations.count > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS or values.count > DIFFERENTIAL_DEFAULT_MAX_VALUES
            for value in values:
                return false if not differential_value_kind_valid(value.kind)
                return false if value.kind == DifferentialValueKind.Array and not differential_array_value_range_valid(values, value)
                return false if value.kind == DifferentialValueKind.Map and not differential_map_value_range_valid(values, value)
            for observation in observations:
                return false if not differential_value_kind_valid(observation.value.kind)
                return false if observation.value.kind == DifferentialValueKind.Array and not differential_array_value_range_valid(values, observation.value)
                return false if observation.value.kind == DifferentialValueKind.Map and not differential_map_value_range_valid(values, observation.value)
            return true


        def differential_capture_inputs_text_bytes_fit(observations: darray[DifferentialObservation]&, values: darray[DifferentialValue]&) -> bool:
            total: mutable usize = 0
            return differential_capture_observation_values_fit(observations, values, total)


        # The root return value and observation values are also caller-owned
        # snapshots; they need the same per-field and aggregate checks even
        # when they are not present in the flat value pool.
        def differential_run_value_text_bytes_fits(run: DifferentialRun&) -> bool:
            total: mutable usize = 0
            return false if not differential_value_text_bytes_fits(run.return_value)
            return false if not differential_value_text_fields_fits(total, run.return_value, DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_TEXT_BYTES)
            return differential_capture_observation_values_fit(run.observations, run.values, total)


        def differential_value_pool_text_bytes_fits(artifact: DifferentialValuePoolArtifact&) -> bool:
            total: mutable usize = 0
            return false if not differential_value_text_fields_fits(total, artifact.root_value, DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_TEXT_BYTES)
            for value in artifact.values |total|:
                return false if not differential_value_text_fields_fits(total, value, DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_TEXT_BYTES)
            for observation in artifact.observations |total|:
                return false if not differential_value_text_fields_fits(total, observation.value, DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_TEXT_BYTES)
            return total <= DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_TEXT_BYTES


        def differential_value_pool_artifact_valid(artifact: DifferentialValuePoolArtifact&) -> bool:
            return false if artifact.format_version != 1 or artifact.manifest_fingerprint == 0
            return false if not differential_artifact_side_valid(artifact.side) or not differential_run_outcome_valid(artifact.outcome)
            return false if artifact.values.count > DIFFERENTIAL_DEFAULT_MAX_VALUES or artifact.values.count > DIFFERENTIAL_U32_MAX
            return false if artifact.observations.count > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS
            return false if not differential_value_record_valid(artifact.values, artifact.root_value)
            for value in artifact.values |artifact|:
                return false if not differential_value_record_valid(artifact.values, value)
            for observation in artifact.observations |artifact|:
                return false if not differential_value_record_valid(artifact.values, observation.value)
            return differential_value_pool_text_bytes_fits(artifact)


        def differential_emit_value(output: mutable darray[u8]&, value: DifferentialValue) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            EsIr::canonical_artifact_emit_byte(output, value.kind.u8())
            EsIr::canonical_artifact_emit_byte(output, 1 if value.boolean else 0)
            EsIr::canonical_artifact_emit_i64(output, value.integer)
            EsIr::canonical_artifact_emit_u64(output, differential_float_bits(value.decimal))
            EsIr::canonical_artifact_emit_i64(output, value.process_exit_status)
            EsIr::canonical_artifact_emit_text(output, value.text)
            EsIr::canonical_artifact_emit_text(output, value.process_stdout)
            EsIr::canonical_artifact_emit_text(output, value.process_stderr)
            EsIr::canonical_artifact_emit_u32(output, value.array_start)
            EsIr::canonical_artifact_emit_u32(output, value.array_count)
            EsIr::canonical_artifact_emit_u32(output, value.map_start)
            EsIr::canonical_artifact_emit_u32(output, value.map_count)


        def differential_read_value(bytes: darray[u8]&, offset: mutable usize&, value: mutable DifferentialValue&) -> bool can[Unsafe.PointerCast]:
            return false if offset >= bytes.count
            kind_byte: u8 = bytes[offset]
            offset <- offset + 1
            return false if not differential_value_kind_byte_valid(kind_byte)
            return false if offset >= bytes.count
            boolean_byte: u8 = bytes[offset]
            offset <- offset + 1
            return false if boolean_byte > 1
            integer: mutable i64 = 0
            return false if not differential_manifest_read_i64(bytes, offset, integer)
            decimal_bits: mutable u64 = 0
            return false if not differential_manifest_read_u64(bytes, offset, decimal_bits)
            process_exit_status: mutable i64 = 0
            return false if not differential_manifest_read_i64(bytes, offset, process_exit_status)
            text_start: mutable usize = 0
            text_end: mutable usize = 0
            stdout_start: mutable usize = 0
            stdout_end: mutable usize = 0
            stderr_start: mutable usize = 0
            stderr_end: mutable usize = 0
            return false if not differential_manifest_read_text_bounds(bytes, offset, text_start, text_end) or not differential_manifest_read_text_bounds(bytes, offset, stdout_start, stdout_end) or not differential_manifest_read_text_bounds(bytes, offset, stderr_start, stderr_end)
            array_start: mutable u32 = 0
            array_count: mutable u32 = 0
            map_start: mutable u32 = 0
            map_count: mutable u32 = 0
            return false if not differential_manifest_read_u32(bytes, offset, array_start) or not differential_manifest_read_u32(bytes, offset, array_count) or not differential_manifest_read_u32(bytes, offset, map_start) or not differential_manifest_read_u32(bytes, offset, map_count)
            kind: DifferentialValueKind = DifferentialValueKind.Void
            kind <- DifferentialValueKind.Bool if kind_byte == DifferentialValueKind.Bool.u8()
            kind <- DifferentialValueKind.Int if kind_byte == DifferentialValueKind.Int.u8()
            kind <- DifferentialValueKind.Float if kind_byte == DifferentialValueKind.Float.u8()
            kind <- DifferentialValueKind.Array if kind_byte == DifferentialValueKind.Array.u8()
            kind <- DifferentialValueKind.Map if kind_byte == DifferentialValueKind.Map.u8()
            kind <- DifferentialValueKind.Text if kind_byte == DifferentialValueKind.Text.u8()
            kind <- DifferentialValueKind.ProcessCapture if kind_byte == DifferentialValueKind.ProcessCapture.u8()
            value <- DifferentialValue{kind: kind, boolean: boolean_byte == 1, integer: integer, decimal: differential_float_from_bits(decimal_bits), process_exit_status: process_exit_status, text: differential_manifest_text_view(bytes, text_start, text_end), process_stdout: differential_manifest_text_view(bytes, stdout_start, stdout_end), process_stderr: differential_manifest_text_view(bytes, stderr_start, stderr_end), array_start: array_start, array_count: array_count, map_start: map_start, map_count: map_count}
            return true


    public:
        def make_differential_value_pool_artifact(manifest: DifferentialArtifactManifest&, side: DifferentialArtifactSide, run: DifferentialRun&) -> DifferentialValuePoolArtifact error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise DifferentialRunnerError.Invalid if not differential_artifact_manifest_valid(manifest) or not differential_artifact_side_valid(side) or not differential_run_outcome_valid(run.outcome)
            manifest_fingerprint: u64 = differential_artifact_manifest_fingerprint(manifest)
            raise DifferentialRunnerError.Invalid if manifest_fingerprint == 0
            artifact: DifferentialValuePoolArtifact = DifferentialValuePoolArtifact{manifest_fingerprint: manifest_fingerprint, side: side, outcome: run.outcome, exit_status: run.exit_status, root_value: run.return_value, values: run.values, observations: run.observations}
            raise DifferentialRunnerError.Invalid if not differential_value_pool_artifact_valid(artifact)
            return artifact


        def canonical_differential_value_pool_artifact_bytes(artifact: DifferentialValuePoolArtifact) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return [] if not differential_value_pool_artifact_valid(artifact)
            output: mutable darray[u8] = []
            EsIr::canonical_artifact_emit_byte(output, 69)
            EsIr::canonical_artifact_emit_byte(output, 83)
            EsIr::canonical_artifact_emit_byte(output, 86)
            EsIr::canonical_artifact_emit_byte(output, 80)
            EsIr::canonical_artifact_emit_byte(output, artifact.format_version)
            EsIr::canonical_artifact_emit_u64(output, artifact.manifest_fingerprint)
            EsIr::canonical_artifact_emit_byte(output, artifact.side.u8())
            EsIr::canonical_artifact_emit_byte(output, artifact.outcome.u8())
            EsIr::canonical_artifact_emit_i64(output, artifact.exit_status)
            EsIr::canonical_artifact_emit_u64(output, artifact.values.count.u64())
            EsIr::canonical_artifact_emit_u64(output, artifact.observations.count.u64())
            differential_emit_value(output, artifact.root_value)
            for value in artifact.values |output|:
                differential_emit_value(output, value)
            for observation in artifact.observations |output|:
                EsIr::canonical_artifact_emit_u64(output, observation.trace)
                differential_emit_value(output, observation.value)
            return [] if output.count > DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_BYTES
            return output


        def differential_value_pool_artifact_fingerprint(artifact: DifferentialValuePoolArtifact) -> u64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            encoded: darray[u8] = canonical_differential_value_pool_artifact_bytes(artifact)
            return 0 if encoded.count == 0
            fingerprint: mutable u64 = 14695981039346656037
            for byte in encoded |fingerprint|:
                fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, byte)
            return fingerprint


    private:
        def differential_decode_value_pool_artifact(bytes: darray[u8]&) -> DifferentialValuePoolArtifactDecode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            invalid: DifferentialValuePoolArtifact = DifferentialValuePoolArtifact{}
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if bytes.count < 5 or bytes.count > DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_BYTES
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if bytes[0] != 69 or bytes[1] != 83 or bytes[2] != 86 or bytes[3] != 80 or bytes[4] != 1
            offset: mutable usize = 5
            manifest_fingerprint: mutable u64 = 0
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_u64(bytes, offset, manifest_fingerprint)
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if offset > bytes.count
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if bytes.count - offset < 2
            side_byte: u8 = bytes[offset]
            outcome_byte: u8 = bytes[offset + 1]
            offset <- offset + 2
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if not differential_artifact_side_byte_valid(side_byte) or not differential_run_outcome_byte_valid(outcome_byte)
            exit_status: mutable i64 = 0
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_i64(bytes, offset, exit_status)
            value_count: mutable u64 = 0
            observation_count: mutable u64 = 0
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_u64(bytes, offset, value_count) or not differential_manifest_read_u64(bytes, offset, observation_count)
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if value_count > DIFFERENTIAL_DEFAULT_MAX_VALUES.u64() or observation_count > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS.u64()
            root_value: mutable DifferentialValue = DifferentialValue{kind: DifferentialValueKind.Void}
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if not differential_read_value(bytes, offset, root_value)
            values: mutable darray[DifferentialValue] = []
            for _ in 0..<value_count.usize() |values|:
                value: mutable DifferentialValue = DifferentialValue{kind: DifferentialValueKind.Void}
                return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if not differential_read_value(bytes, offset, value)
                values.push(value)
            observations: mutable darray[DifferentialObservation] = []
            for _ in 0..<observation_count.usize() |observations|:
                trace: mutable u64 = 0
                value: mutable DifferentialValue = DifferentialValue{kind: DifferentialValueKind.Void}
                return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_u64(bytes, offset, trace) or not differential_read_value(bytes, offset, value)
                observations.push(DifferentialObservation{trace: trace, value: value})
            side: DifferentialArtifactSide = DifferentialArtifactSide.Reference
            side <- DifferentialArtifactSide.Candidate if side_byte == DifferentialArtifactSide.Candidate.u8()
            outcome: DifferentialRunOutcome = DifferentialRunOutcome.Completed
            outcome <- DifferentialRunOutcome.NormalError if outcome_byte == DifferentialRunOutcome.NormalError.u8()
            outcome <- DifferentialRunOutcome.SpawnFailure if outcome_byte == DifferentialRunOutcome.SpawnFailure.u8()
            outcome <- DifferentialRunOutcome.Crash if outcome_byte == DifferentialRunOutcome.Crash.u8()
            outcome <- DifferentialRunOutcome.Timeout if outcome_byte == DifferentialRunOutcome.Timeout.u8()
            outcome <- DifferentialRunOutcome.OutputLimit if outcome_byte == DifferentialRunOutcome.OutputLimit.u8()
            outcome <- DifferentialRunOutcome.CompileFailure if outcome_byte == DifferentialRunOutcome.CompileFailure.u8()
            artifact: DifferentialValuePoolArtifact = DifferentialValuePoolArtifact{manifest_fingerprint: manifest_fingerprint, side: side, outcome: outcome, exit_status: exit_status, root_value: root_value, values: values, observations: observations}
            return DifferentialValuePoolArtifactDecode{valid: false, artifact: invalid} if offset != bytes.count or not differential_value_pool_artifact_valid(artifact)
            return DifferentialValuePoolArtifactDecode{valid: true, artifact: artifact}


    public:
        def differential_value_pool_artifact_bytes_valid(bytes: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return differential_decode_value_pool_artifact(bytes).valid


        def decode_differential_value_pool_artifact(bytes: darray[u8]&) -> DifferentialValuePoolArtifactDecode can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return differential_decode_value_pool_artifact(bytes)


    private:
        const DIFFERENTIAL_MAX_ARTIFACT_INDEX_BYTES: usize = 256


        def differential_artifact_publication_state_valid(state: DifferentialArtifactPublicationState) -> bool:
            return state in {DifferentialArtifactPublicationState.Prepared, DifferentialArtifactPublicationState.Complete}


        def differential_artifact_index_valid(index: DifferentialArtifactIndex&) -> bool:
            return false if index.format_version != 1 or index.manifest_fingerprint == 0 or not differential_artifact_publication_state_valid(index.publication)
            return true if index.publication == DifferentialArtifactPublicationState.Prepared
            return index.comparison_fingerprint != 0 and index.reference_process_fingerprint != 0 and index.candidate_process_fingerprint != 0 and index.reproduction_fingerprint != 0 and index.reference_value_pool_fingerprint != 0 and index.candidate_value_pool_fingerprint != 0


    public:
        def make_differential_artifact_index(manifest: DifferentialArtifactManifest&, publication: DifferentialArtifactPublicationState, comparison_fingerprint: u64 = 0, reference_process_fingerprint: u64 = 0, candidate_process_fingerprint: u64 = 0, reproduction_fingerprint: u64 = 0, reference_value_pool_fingerprint: u64 = 0, candidate_value_pool_fingerprint: u64 = 0) -> DifferentialArtifactIndex error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialRunnerError.Invalid if not differential_artifact_manifest_valid(manifest) or not differential_artifact_publication_state_valid(publication)
            manifest_fingerprint: u64 = differential_artifact_manifest_fingerprint(manifest)
            raise DifferentialRunnerError.Invalid if manifest_fingerprint == 0
            index: DifferentialArtifactIndex = DifferentialArtifactIndex{manifest_fingerprint: manifest_fingerprint, publication: publication, comparison_fingerprint: comparison_fingerprint, reference_process_fingerprint: reference_process_fingerprint, candidate_process_fingerprint: candidate_process_fingerprint, reproduction_fingerprint: reproduction_fingerprint, reference_value_pool_fingerprint: reference_value_pool_fingerprint, candidate_value_pool_fingerprint: candidate_value_pool_fingerprint}
            raise DifferentialRunnerError.Invalid if not differential_artifact_index_valid(index)
            return index


        def canonical_differential_artifact_index_bytes(index: DifferentialArtifactIndex) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not differential_artifact_index_valid(index)
            output: mutable darray[u8] = []
            EsIr::canonical_artifact_emit_byte(output, 69)
            EsIr::canonical_artifact_emit_byte(output, 83)
            EsIr::canonical_artifact_emit_byte(output, 73)
            EsIr::canonical_artifact_emit_byte(output, 88)
            EsIr::canonical_artifact_emit_byte(output, index.format_version)
            EsIr::canonical_artifact_emit_u64(output, index.manifest_fingerprint)
            EsIr::canonical_artifact_emit_byte(output, index.publication.u8())
            EsIr::canonical_artifact_emit_u64(output, index.comparison_fingerprint)
            EsIr::canonical_artifact_emit_u64(output, index.reference_process_fingerprint)
            EsIr::canonical_artifact_emit_u64(output, index.candidate_process_fingerprint)
            EsIr::canonical_artifact_emit_u64(output, index.reproduction_fingerprint)
            EsIr::canonical_artifact_emit_u64(output, index.reference_value_pool_fingerprint)
            EsIr::canonical_artifact_emit_u64(output, index.candidate_value_pool_fingerprint)
            return [] if output.count > DIFFERENTIAL_MAX_ARTIFACT_INDEX_BYTES
            return output


        def differential_artifact_index_fingerprint(index: DifferentialArtifactIndex) -> u64 can[Memory.Allocate, Abort.Panic]:
            encoded: darray[u8] = canonical_differential_artifact_index_bytes(index)
            return 0 if encoded.count == 0
            fingerprint: mutable u64 = 14695981039346656037
            for byte in encoded |fingerprint|:
                fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, byte)
            return fingerprint


    private:
        def differential_decode_artifact_index(bytes: darray[u8]&) -> DifferentialArtifactIndexDecode can[Unsafe.PointerCast]:
            invalid: DifferentialArtifactIndex = DifferentialArtifactIndex{}
            return DifferentialArtifactIndexDecode{valid: false, index: invalid} if bytes.count < 5 or bytes.count > DIFFERENTIAL_MAX_ARTIFACT_INDEX_BYTES
            return DifferentialArtifactIndexDecode{valid: false, index: invalid} if bytes[0] != 69 or bytes[1] != 83 or bytes[2] != 73 or bytes[3] != 88 or bytes[4] != 1
            offset: mutable usize = 5
            manifest_fingerprint: mutable u64 = 0
            return DifferentialArtifactIndexDecode{valid: false, index: invalid} if not differential_manifest_read_u64(bytes, offset, manifest_fingerprint) or offset >= bytes.count
            publication_byte: u8 = bytes[offset]
            offset <- offset + 1
            return DifferentialArtifactIndexDecode{valid: false, index: invalid} if not differential_artifact_publication_state_byte_valid(publication_byte)
            comparison_fingerprint: mutable u64 = 0
            reference_process_fingerprint: mutable u64 = 0
            candidate_process_fingerprint: mutable u64 = 0
            reproduction_fingerprint: mutable u64 = 0
            reference_value_pool_fingerprint: mutable u64 = 0
            candidate_value_pool_fingerprint: mutable u64 = 0
            return DifferentialArtifactIndexDecode{valid: false, index: invalid} if not differential_manifest_read_u64(bytes, offset, comparison_fingerprint) or not differential_manifest_read_u64(bytes, offset, reference_process_fingerprint) or not differential_manifest_read_u64(bytes, offset, candidate_process_fingerprint) or not differential_manifest_read_u64(bytes, offset, reproduction_fingerprint) or not differential_manifest_read_u64(bytes, offset, reference_value_pool_fingerprint) or not differential_manifest_read_u64(bytes, offset, candidate_value_pool_fingerprint) or offset != bytes.count
            publication: DifferentialArtifactPublicationState = DifferentialArtifactPublicationState.Prepared
            publication <- DifferentialArtifactPublicationState.Complete if publication_byte == DifferentialArtifactPublicationState.Complete.u8()
            index: DifferentialArtifactIndex = DifferentialArtifactIndex{manifest_fingerprint: manifest_fingerprint, publication: publication, comparison_fingerprint: comparison_fingerprint, reference_process_fingerprint: reference_process_fingerprint, candidate_process_fingerprint: candidate_process_fingerprint, reproduction_fingerprint: reproduction_fingerprint, reference_value_pool_fingerprint: reference_value_pool_fingerprint, candidate_value_pool_fingerprint: candidate_value_pool_fingerprint}
            return DifferentialArtifactIndexDecode{valid: false, index: invalid} if not differential_artifact_index_valid(index)
            return DifferentialArtifactIndexDecode{valid: true, index: index}


    public:
        def differential_artifact_index_bytes_valid(bytes: darray[u8]&) -> bool can[Unsafe.PointerCast]:
            return differential_decode_artifact_index(bytes).valid


        def decode_differential_artifact_index(bytes: darray[u8]&) -> DifferentialArtifactIndexDecode can[Unsafe.PointerCast]:
            return differential_decode_artifact_index(bytes)


    private:
        const DIFFERENTIAL_MAX_ARTIFACT_DIRECTORY_PARENT_BYTES: usize = 4096
        const DIFFERENTIAL_MAX_ARTIFACT_DIRECTORY_COMPONENT_BYTES: usize = 128


        def differential_artifact_directory_state_valid(state: DifferentialArtifactDirectoryState) -> bool:
            return state in {DifferentialArtifactDirectoryState.Staging, DifferentialArtifactDirectoryState.Ready, DifferentialArtifactDirectoryState.Published}


        def differential_artifact_directory_component_valid(value: sview) -> bool:
            length: usize = sview_len(value)
            return false if length == 0 or length > DIFFERENTIAL_MAX_ARTIFACT_DIRECTORY_COMPONENT_BYTES or differential_sview_has_nul(value)
            return false if value == "." or value == ".."
            index: mutable usize = 0
            while index < length:
                byte: u8 = sview_at(value, index)
                return false if byte == 47 or byte == 92
                index <- index + 1
            return true


        def differential_artifact_directory_plan_valid(plan: DifferentialArtifactDirectoryPlan&) -> bool:
            return false if plan.format_version != 1 or plan.manifest_fingerprint == 0 or not differential_artifact_directory_state_valid(plan.state)
            return false if sview_len(plan.parent) == 0 or sview_len(plan.parent) > DIFFERENTIAL_MAX_ARTIFACT_DIRECTORY_PARENT_BYTES or differential_sview_has_nul(plan.parent)
            return false if not differential_artifact_directory_component_valid(plan.staging_name) or not differential_artifact_directory_component_valid(plan.final_name)
            return plan.staging_name != plan.final_name


        const enum DifferentialArtifactDirectoryCheckState of u8:
            Plan
            Index
            Binding
            Publication
            Done


        struct DifferentialArtifactDirectoryCheckCursor:
            state: mutable DifferentialArtifactDirectoryCheckState
            result: mutable DifferentialArtifactDirectoryCheck


        def differential_artifact_directory_failure(issue: DifferentialArtifactDirectoryIssue, reason: sview) -> DifferentialArtifactDirectoryCheck:
            return DifferentialArtifactDirectoryCheck{valid: false, issue: issue, reason: reason}


    public:
        # Describe an atomic artifact directory without constructing a shell
        # command or exposing a path with an interpolated component. The later
        # filesystem adapter creates `staging_name`, writes sidecars and a
        # Prepared index, replaces it with a Complete index, then renames the
        # directory to `final_name`.
        def make_differential_artifact_directory_plan(manifest: DifferentialArtifactManifest&, parent: sview, staging_name: sview, final_name: sview, state: DifferentialArtifactDirectoryState = DifferentialArtifactDirectoryState.Staging) -> DifferentialArtifactDirectoryPlan error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialRunnerError.Invalid if not differential_artifact_manifest_valid(manifest) or not differential_artifact_directory_state_valid(state)
            manifest_fingerprint: u64 = differential_artifact_manifest_fingerprint(manifest)
            raise DifferentialRunnerError.Invalid if manifest_fingerprint == 0
            plan: DifferentialArtifactDirectoryPlan = DifferentialArtifactDirectoryPlan{manifest_fingerprint: manifest_fingerprint, parent: parent, staging_name: staging_name, final_name: final_name, state: state}
            raise DifferentialRunnerError.Invalid if not differential_artifact_directory_plan_valid(plan)
            return plan


        # Validate the publication step before any host filesystem mutation.
        # Staging is paired only with a Prepared index; Ready and Published
        # require Complete so a final directory can never name a partial bundle.
        def validate_differential_artifact_directory(plan: DifferentialArtifactDirectoryPlan&, index: DifferentialArtifactIndex&) -> DifferentialArtifactDirectoryCheck:
            cursor: mutable DifferentialArtifactDirectoryCheckCursor = DifferentialArtifactDirectoryCheckCursor{state: DifferentialArtifactDirectoryCheckState.Plan, result: DifferentialArtifactDirectoryCheck{valid: true, issue: DifferentialArtifactDirectoryIssue.None}}
            machine over cursor.state:
                state Validate
                start Validate

                Validate, DifferentialArtifactDirectoryCheckState.Plan if differential_artifact_directory_plan_valid(plan):
                    cursor.state <- DifferentialArtifactDirectoryCheckState.Index
                    -> Validate
                Validate, DifferentialArtifactDirectoryCheckState.Plan:
                    cursor.result <- differential_artifact_directory_failure(DifferentialArtifactDirectoryIssue.InvalidPlan, "artifact directory plan is invalid")
                    cursor.state <- DifferentialArtifactDirectoryCheckState.Done
                    -> Validate

                Validate, DifferentialArtifactDirectoryCheckState.Index if differential_artifact_index_valid(index):
                    cursor.state <- DifferentialArtifactDirectoryCheckState.Binding
                    -> Validate
                Validate, DifferentialArtifactDirectoryCheckState.Index:
                    cursor.result <- differential_artifact_directory_failure(DifferentialArtifactDirectoryIssue.InvalidIndex, "artifact directory index is invalid")
                    cursor.state <- DifferentialArtifactDirectoryCheckState.Done
                    -> Validate

                Validate, DifferentialArtifactDirectoryCheckState.Binding if plan.manifest_fingerprint == index.manifest_fingerprint:
                    cursor.state <- DifferentialArtifactDirectoryCheckState.Publication
                    -> Validate
                Validate, DifferentialArtifactDirectoryCheckState.Binding:
                    cursor.result <- differential_artifact_directory_failure(DifferentialArtifactDirectoryIssue.ManifestFingerprintMismatch, "artifact directory and index use different manifests")
                    cursor.state <- DifferentialArtifactDirectoryCheckState.Done
                    -> Validate

                Validate, DifferentialArtifactDirectoryCheckState.Publication if plan.state == DifferentialArtifactDirectoryState.Staging and index.publication == DifferentialArtifactPublicationState.Prepared:
                    cursor.state <- DifferentialArtifactDirectoryCheckState.Done
                    -> Validate
                Validate, DifferentialArtifactDirectoryCheckState.Publication if plan.state != DifferentialArtifactDirectoryState.Staging and index.publication == DifferentialArtifactPublicationState.Complete:
                    cursor.state <- DifferentialArtifactDirectoryCheckState.Done
                    -> Validate
                Validate, DifferentialArtifactDirectoryCheckState.Publication:
                    cursor.result <- differential_artifact_directory_failure(DifferentialArtifactDirectoryIssue.InvalidPublicationState, "artifact directory state and index publication state are incompatible")
                    cursor.state <- DifferentialArtifactDirectoryCheckState.Done
                    -> Validate

                Validate, DifferentialArtifactDirectoryCheckState.Done:
                    break

            return cursor.result


        # Advance exactly one publication edge. The index must already be
        # Complete for both edges; the caller writes it last in the staging
        # directory and only then requests Ready or Published.
        def advance_differential_artifact_directory(plan: mutable DifferentialArtifactDirectoryPlan&, index: DifferentialArtifactIndex&, next_state: DifferentialArtifactDirectoryState) -> DifferentialArtifactDirectoryCheck:
            return differential_artifact_directory_failure(DifferentialArtifactDirectoryIssue.InvalidPlan, "artifact directory plan is invalid") if not differential_artifact_directory_plan_valid(plan)
            return differential_artifact_directory_failure(DifferentialArtifactDirectoryIssue.InvalidIndex, "artifact directory index is invalid") if not differential_artifact_index_valid(index)
            return differential_artifact_directory_failure(DifferentialArtifactDirectoryIssue.ManifestFingerprintMismatch, "artifact directory and index use different manifests") if plan.manifest_fingerprint != index.manifest_fingerprint
            valid_edge: bool = (plan.state == DifferentialArtifactDirectoryState.Staging and next_state == DifferentialArtifactDirectoryState.Ready) or (plan.state == DifferentialArtifactDirectoryState.Ready and next_state == DifferentialArtifactDirectoryState.Published)
            return differential_artifact_directory_failure(DifferentialArtifactDirectoryIssue.InvalidTransition, "artifact directory transition is not a single forward publication edge") if not valid_edge
            return differential_artifact_directory_failure(DifferentialArtifactDirectoryIssue.InvalidPublicationState, "artifact directory transition requires a Complete index") if index.publication != DifferentialArtifactPublicationState.Complete
            plan.state <- next_state
            return DifferentialArtifactDirectoryCheck{valid: true, issue: DifferentialArtifactDirectoryIssue.None}


        const DIFFERENTIAL_WAIT_NOHANG: int = 1
        const DIFFERENTIAL_SIGNAL_TERM: int = 15
        const DIFFERENTIAL_SIGNAL_KILL: int = 9
        const DIFFERENTIAL_TERM_GRACE_POLLS: u64 = 100
        const DIFFERENTIAL_MAX_EINTR_RETRIES: usize = 8


        const enum DifferentialPrepareState of u8:
            PrefixEntry
            Arguments
            Done


        struct DifferentialPrepareCursor:
            state: mutable DifferentialPrepareState
            argument_index: mutable usize


        def differential_process_text_bytes_add_fits(total: mutable usize&, value: sview, limit: usize) -> bool:
            return false if total > limit
            length: usize = sview_len(value)
            # Every process-facing text value becomes a terminated C string.
            # Use a strict comparison so `length + 1` cannot wrap or exceed
            # the aggregate limit.
            return false if length >= limit - total
            total <- total + length + 1
            return true


        def differential_process_text_byte_add_fits(total: mutable usize&, limit: usize) -> bool:
            return false if total >= limit
            total <- total + 1
            return true


        # Reject overlong borrowed fields before any NUL scan. Every process
        # text value becomes a terminated C string, so the strict bound leaves
        # one byte for that terminator on all host widths.
        def differential_process_text_field_lengths_fit(executable: sview, entry: sview, arguments: darray[sview], working_directory: sview, environment: darray[DifferentialEnvironmentEntry]) -> bool:
            return false if sview_len(executable) >= DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES or sview_len(entry) >= DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES
            return false if working_directory != "" and sview_len(working_directory) >= DIFFERENTIAL_DEFAULT_MAX_PROCESS_PATH_BYTES
            return false if arguments.count > DIFFERENTIAL_DEFAULT_MAX_ARGUMENTS or environment.count > DIFFERENTIAL_DEFAULT_MAX_ENVIRONMENT_ENTRIES
            for argument in arguments:
                return false if sview_len(argument) >= DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES
            for variable in environment:
                return false if sview_len(variable.name) >= DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES or sview_len(variable.value) >= DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES
            return true


        def differential_process_text_bytes_fits(executable: sview, entry: sview, arguments: darray[sview], working_directory: sview, environment: darray[DifferentialEnvironmentEntry]) -> bool:
            total: mutable usize = 0
            return false if not differential_process_text_bytes_add_fits(total, executable, DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES)
            if entry != "":
                return false if not differential_process_text_bytes_add_fits(total, entry, DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES)
            if working_directory != "":
                return false if not differential_process_text_bytes_add_fits(total, working_directory, DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES)
            for argument in arguments:
                return false if not differential_process_text_bytes_add_fits(total, argument, DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES)
            for variable in environment:
                return false if not differential_process_text_bytes_add_fits(total, variable.name, DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES)
                # The host setenv boundary materializes `name=value\0`; the
                # two terminated fields above do not include this separator.
                return false if not differential_process_text_byte_add_fits(total, DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES)
                return false if not differential_process_text_bytes_add_fits(total, variable.value, DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES)
            return true


        def differential_sview_has_nul(value: sview) -> bool:
            index: mutable usize = 0
            found: mutable bool = false
            machine over sview_at(value, index) while index < sview_len(value):
                state Scan
                start Scan

                Scan, 0:
                    found <- true
                    break
                Scan, _:
                    index <- index + 1
                    -> Scan

            return found


        def differential_runner_needs_entry(kind: DifferentialRunnerKind) -> bool:
            return kind == DifferentialRunnerKind.ElisascriptFile or kind == DifferentialRunnerKind.PythonAdapter or kind == DifferentialRunnerKind.CAbiFunction or kind == DifferentialRunnerKind.WasmModule or kind == DifferentialRunnerKind.Service


        def differential_environment_valid(environment: darray[DifferentialEnvironmentEntry]) -> bool:
            for index in 0..<environment.count |environment|:
                entry: DifferentialEnvironmentEntry = environment[index]
                false return if sview_len(entry.name) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES or sview_len(entry.value) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_TEXT_BYTES
                false return if entry.name == "" or differential_sview_has_nul(entry.name) or sview_contains_byte(entry.name, 61) or differential_sview_has_nul(entry.value)
                for prior in 0..<index |environment, entry|:
                    false return if environment[prior].name == entry.name
            return true


        def differential_environment_has_equals_name(environment: darray[DifferentialEnvironmentEntry]) -> bool:
            for entry in environment:
                true return if sview_contains_byte(entry.name, 61)
            return false


        def differential_runner_name_valid(value: sview) -> bool:
            return false if sview_len(value) == 0 or sview_len(value) > DIFFERENTIAL_DEFAULT_MAX_WORLD_METADATA_BYTES
            return not differential_sview_has_nul(value)


    public:
        # Validate the complete runner contract before an adapter is allowed to
        # launch. The machine makes the validation order deterministic: name,
        # target, optional entry, argv, then timeout.
        def validate_differential_runner(runner: DifferentialRunner&) -> DifferentialRunnerCheck:
            cursor: mutable DifferentialRunnerCursor = DifferentialRunnerCursor{state: DifferentialRunnerCheckState.Name, argument_index: 0, result: DifferentialRunnerCheck{valid: true, issue: DifferentialRunnerIssueKind.None}}
            machine over cursor.state while cursor.result.valid:
                state Validate
                start Validate

                Validate, DifferentialRunnerCheckState.Name if differential_runner_name_valid(runner.name):
                    cursor.state <- DifferentialRunnerCheckState.Target
                    -> Validate
                Validate, DifferentialRunnerCheckState.Name:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.MissingName
                    cursor.result.reason <- "runner name is required"
                    -> Validate

                Validate, DifferentialRunnerCheckState.Target if runner.target == "":
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.MissingTarget
                    cursor.result.reason <- "runner target is required"
                    -> Validate
                Validate, DifferentialRunnerCheckState.Target if runner.arguments.count > DIFFERENTIAL_DEFAULT_MAX_ARGUMENTS:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.TooManyArguments
                    cursor.result.reason <- "runner argument vector exceeds the one-million-entry process budget"
                    -> Validate
                Validate, DifferentialRunnerCheckState.Target if runner.environment.count > DIFFERENTIAL_DEFAULT_MAX_ENVIRONMENT_ENTRIES:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.TooManyEnvironmentEntries
                    cursor.result.reason <- "runner environment exceeds the one-million-entry process budget"
                    -> Validate
                Validate, DifferentialRunnerCheckState.Target if not differential_process_text_field_lengths_fit(runner.target, runner.entry, runner.arguments, runner.working_directory, runner.environment):
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.TooMuchProcessText
                    cursor.result.reason <- "runner process text or working-directory path exceeds its field budget"
                    -> Validate
                Validate, DifferentialRunnerCheckState.Target if differential_sview_has_nul(runner.target):
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.EmbeddedNul
                    cursor.result.reason <- "runner target contains NUL"
                    -> Validate
                Validate, DifferentialRunnerCheckState.Target if differential_runner_needs_entry(runner.kind):
                    cursor.state <- DifferentialRunnerCheckState.Entry
                    -> Validate
                Validate, DifferentialRunnerCheckState.Target if runner.entry != "":
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.UnexpectedEntry
                    cursor.result.reason <- "runner entry is not valid for this runner kind"
                    -> Validate
                Validate, DifferentialRunnerCheckState.Target:
                    cursor.state <- DifferentialRunnerCheckState.Arguments
                    -> Validate

                Validate, DifferentialRunnerCheckState.Entry if runner.entry == "":
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.MissingEntry
                    cursor.result.reason <- "runner entry is required"
                    -> Validate
                Validate, DifferentialRunnerCheckState.Entry if differential_sview_has_nul(runner.entry):
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.EmbeddedNul
                    cursor.result.reason <- "runner entry contains NUL"
                    -> Validate
                Validate, DifferentialRunnerCheckState.Entry:
                    cursor.state <- DifferentialRunnerCheckState.Arguments
                    -> Validate

                Validate, DifferentialRunnerCheckState.Arguments if runner.arguments.count > DIFFERENTIAL_DEFAULT_MAX_ARGUMENTS:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.TooManyArguments
                    cursor.result.reason <- "runner argument vector exceeds the one-million-entry process budget"
                    -> Validate
                Validate, DifferentialRunnerCheckState.Arguments if cursor.argument_index >= runner.arguments.count:
                    cursor.state <- DifferentialRunnerCheckState.WorkingDirectory
                    -> Validate
                Validate, DifferentialRunnerCheckState.Arguments if differential_sview_has_nul(runner.arguments[cursor.argument_index]):
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.EmbeddedNul
                    cursor.result.reason <- "runner argument contains NUL"
                    cursor.result.argument_index <- cursor.argument_index.u32()
                    -> Validate
                Validate, DifferentialRunnerCheckState.Arguments:
                    cursor.argument_index <- cursor.argument_index + 1
                    -> Validate

                Validate, DifferentialRunnerCheckState.WorkingDirectory if differential_sview_has_nul(runner.working_directory):
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.EmbeddedNul
                    cursor.result.reason <- "runner working directory contains NUL"
                    -> Validate
                Validate, DifferentialRunnerCheckState.WorkingDirectory:
                    cursor.state <- DifferentialRunnerCheckState.Environment
                    -> Validate

                Validate, DifferentialRunnerCheckState.Environment if runner.environment.count > DIFFERENTIAL_DEFAULT_MAX_ENVIRONMENT_ENTRIES:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.TooManyEnvironmentEntries
                    cursor.result.reason <- "runner environment exceeds the one-million-entry process budget"
                    -> Validate
                Validate, DifferentialRunnerCheckState.Environment if not differential_environment_valid(runner.environment):
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.InvalidEnvironmentName if differential_environment_has_equals_name(runner.environment) else DifferentialRunnerIssueKind.EmbeddedNul
                    cursor.result.reason <- "runner environment name contains '='" if cursor.result.issue == DifferentialRunnerIssueKind.InvalidEnvironmentName else "runner environment contains an empty or NUL value"
                    cursor.state <- DifferentialRunnerCheckState.Done
                    -> Validate
                Validate, DifferentialRunnerCheckState.Environment:
                    cursor.state <- DifferentialRunnerCheckState.ProcessBounds
                    -> Validate

                Validate, DifferentialRunnerCheckState.ProcessBounds if not differential_process_text_bytes_fits(runner.target, runner.entry, runner.arguments, runner.working_directory, runner.environment):
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.TooManyProcessTextBytes
                    cursor.result.reason <- "runner process text exceeds the 64 MiB aggregate C-string budget"
                    cursor.state <- DifferentialRunnerCheckState.Done
                    -> Validate
                Validate, DifferentialRunnerCheckState.ProcessBounds if sview_len(runner.stdin) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_INPUT_BYTES:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.TooMuchProcessInput
                    cursor.result.reason <- "runner stdin exceeds the 64 MiB process-input budget"
                    cursor.state <- DifferentialRunnerCheckState.Done
                    -> Validate
                Validate, DifferentialRunnerCheckState.ProcessBounds if runner.stdin_binary and runner.stdin != "":
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.InvalidProcessInputPayload
                    cursor.result.reason <- "binary stdin cannot carry a text payload"
                    cursor.state <- DifferentialRunnerCheckState.Done
                    -> Validate
                Validate, DifferentialRunnerCheckState.ProcessBounds if not runner.stdin_binary and runner.stdin_bytes.count != 0:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.InvalidProcessInputPayload
                    cursor.result.reason <- "text stdin cannot carry a binary payload"
                    cursor.state <- DifferentialRunnerCheckState.Done
                    -> Validate
                Validate, DifferentialRunnerCheckState.ProcessBounds if runner.stdin_bytes.count > DIFFERENTIAL_DEFAULT_MAX_PROCESS_INPUT_BYTES:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.TooMuchProcessInput
                    cursor.result.reason <- "binary stdin exceeds the 64 MiB process-input budget"
                    cursor.state <- DifferentialRunnerCheckState.Done
                    -> Validate
                Validate, DifferentialRunnerCheckState.ProcessBounds:
                    cursor.state <- DifferentialRunnerCheckState.Timeout
                    -> Validate

                Validate, DifferentialRunnerCheckState.Timeout if runner.timeout_steps > 0 and runner.timeout_steps <= DIFFERENTIAL_DEFAULT_MAX_TIMEOUT_STEPS:
                    cursor.state <- DifferentialRunnerCheckState.OutputLimit
                    -> Validate
                Validate, DifferentialRunnerCheckState.Timeout:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.InvalidTimeout
                    cursor.result.reason <- "runner timeout must be positive and no greater than the shared step/poll budget"
                    -> Validate

                Validate, DifferentialRunnerCheckState.OutputLimit if runner.max_output_bytes > DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.InvalidOutputLimit
                    cursor.result.reason <- "runner output limit exceeds the 64 MiB hard capture budget"
                    cursor.state <- DifferentialRunnerCheckState.Done
                    -> Validate
                Validate, DifferentialRunnerCheckState.OutputLimit if runner.max_output_bytes > 0:
                    cursor.state <- DifferentialRunnerCheckState.Done
                    -> Validate
                Validate, DifferentialRunnerCheckState.OutputLimit:
                    cursor.result.valid <- false
                    cursor.result.issue <- DifferentialRunnerIssueKind.InvalidOutputLimit
                    cursor.result.reason <- "runner output limit must be positive"
                    -> Validate

                Validate, DifferentialRunnerCheckState.Done:
                    break

            return cursor.result


        # Prepare only the process-shaped runner kinds. Execution is deliberately
        # left to the host adapter, which can apply cwd and timeout policy using
        # the same invocation without exposing a shell.
        def prepare_differential_process(runner: DifferentialRunner&) -> DifferentialProcessInvocation error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            check: DifferentialRunnerCheck = validate_differential_runner(runner)
            raise DifferentialRunnerError.Invalid if not check.valid
            raise DifferentialRunnerError.UnsupportedKind if runner.kind != DifferentialRunnerKind.NativeProcess and runner.kind != DifferentialRunnerKind.PythonAdapter
            cursor: mutable DifferentialPrepareCursor = DifferentialPrepareCursor{state: DifferentialPrepareState.PrefixEntry, argument_index: 0}
            machine over cursor.state:
                state Prepare
                start Prepare

                Prepare, DifferentialPrepareState.PrefixEntry if runner.kind == DifferentialRunnerKind.PythonAdapter:
                    cursor.state <- DifferentialPrepareState.Arguments
                    -> Prepare
                Prepare, DifferentialPrepareState.PrefixEntry:
                    cursor.state <- DifferentialPrepareState.Arguments
                    -> Prepare

                Prepare, DifferentialPrepareState.Arguments if cursor.argument_index >= runner.arguments.count:
                    cursor.state <- DifferentialPrepareState.Done
                    -> Prepare
                Prepare, DifferentialPrepareState.Arguments:
                    cursor.argument_index <- cursor.argument_index + 1
                    -> Prepare

                Prepare, DifferentialPrepareState.Done:
                    break

            entry: sview = runner.entry if runner.kind == DifferentialRunnerKind.PythonAdapter else ""
            return DifferentialProcessInvocation{executable: runner.target, entry: entry, arguments: runner.arguments, working_directory: runner.working_directory, environment: runner.environment, stdin: runner.stdin, stdin_bytes: runner.stdin_bytes, stdin_binary: runner.stdin_binary, protocol: runner.protocol, timeout_steps: runner.timeout_steps, max_output_bytes: runner.max_output_bytes}


        # Adapt the differential invocation to the shared command contract
        # before any host-specific fork/exec work. The adapter intentionally
        # keeps the environment flat and ordered, preserving duplicate-name
        # rejection and terminated-byte accounting in one validator. Stdin is
        # still carried separately because binary input is length-delimited,
        # not a C string; the stdio mode records the capture policy only.
        def differential_process_command_valid(invocation: DifferentialProcessInvocation) -> bool:
            command_arguments: mutable darray[sview] = []
            if invocation.entry != "":
                command_arguments.push(invocation.entry)
            for argument in invocation.arguments |command_arguments|:
                command_arguments.push(argument)
            flat_environment: mutable darray[sview] = []
            for entry in invocation.environment |flat_environment|:
                flat_environment.push(entry.name)
                flat_environment.push(entry.value)
            command: ProcessCommand = ProcessCommand{executable: invocation.executable, arguments: command_arguments, working_directory: invocation.working_directory, environment: flat_environment, stdin_mode: ProcessStdioMode.Capture, stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Capture, failure_mode: ProcessFailureMode.Allow}
            catch validate_process_command(command):
                ok:
                    return true
                error failure:
                    return false


    private:
        def differential_cstring(value: sview) -> dstr can[Memory.Allocate, Abort.Panic]:
            length: usize = sview_len(value)
            allocation_length: usize = length + 1
            return [] if allocation_length == 0
            allocation_i64: i64 = allocation_length.i64()
            return [] if allocation_i64 < 0 or allocation_i64.usize() != allocation_length
            bytes: mutable dstr = ctx_fstr_alloc(allocation_length)
            ctx_fstr_append(bytes, value.data, sview_len(value))
            ctx_fstr_append(bytes, "\0", 1)
            return bytes


        # Exact-size temporary-file reads tolerate positive short progress but
        # reject zero/over-count reports or a host error indicator. This mirrors stdin staging and keeps
        # a child-output snapshot all-or-fail when a file is truncated or raced.
        def differential_read_stream_fully(stream: heap void&, data: mutable u8&, length: usize) -> usize can[Blocking.IO]:
            offset: mutable usize = 0
            while offset < length:
                remaining: usize = length - offset
                buffer: mutable u8& = data + offset
                amount: usize = fread(buffer.cast[mutable void&], 1, remaining, stream)
                return offset if amount == 0 or amount > remaining or ferror(stream) != 0
                offset <- offset + amount
            return offset


        def differential_read_stream(stream: heap void&, max_output_bytes: u64) -> sview error[DifferentialRunnerError] can[Memory.Allocate, Memory.Release, Blocking.IO]:
            if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                _ = fclose(stream)
                raise DifferentialRunnerError.Process
            size: i64 = ftell(stream)
            if size < 0:
                _ = fclose(stream)
                raise DifferentialRunnerError.Process
            if size.u64() > max_output_bytes:
                _ = fclose(stream)
                raise DifferentialRunnerError.OutputLimit
            host_size: usize = size.usize()
            if host_size.i64() != size:
                _ = fclose(stream)
                raise DifferentialRunnerError.Process
            if fseek(stream, 0, FILEIO_SEEK_SET) != 0:
                _ = fclose(stream)
                raise DifferentialRunnerError.Process
            if size == 0:
                if fclose(stream) != 0:
                    raise DifferentialRunnerError.Process
                return sview("", 0, 0)
            bytes: mutable dstr = ctx_fstr_alloc(host_size)
            if bytes.items == null:
                _ = fclose(stream)
                raise DifferentialRunnerError.Process
            byte_items: mutable u8& = bytes.items
            read_count: usize = differential_read_stream_fully(stream, byte_items, host_size)
            close_status: int = fclose(stream)
            if read_count != host_size or close_status != 0:
                raise DifferentialRunnerError.Process
            bytes.count <- host_size
            return bytes_view(bytes)


        # Temporary files prevent pipe deadlocks, but they do not by themselves
        # bound a child's output while it is still running.  Poll the file size
        # and let the caller terminate the private process group as soon as a
        # stream crosses its declared ceiling.
        def differential_stream_size(stream: heap void&) -> i64 error[DifferentialRunnerError] can[Blocking.IO]:
            if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                raise DifferentialRunnerError.Process
            size: i64 = ftell(stream)
            raise DifferentialRunnerError.Process if size < 0
            return size


        # stdout and stderr share one run budget, matching the interpreter's
        # aggregate output ledger. Check the first channel before subtracting
        # so signed host sizes and the unsigned ceiling cannot wrap.
        def differential_stream_pair_within_limit(stdout_size: i64, stderr_size: i64, max_output_bytes: u64) -> bool:
            return false if stdout_size < 0 or stderr_size < 0
            stdout_bytes: u64 = stdout_size.u64()
            stderr_bytes: u64 = stderr_size.u64()
            return false if stdout_bytes > max_output_bytes
            return stderr_bytes <= max_output_bytes - stdout_bytes


        # Read both temporary output streams as one ownership boundary. Each
        # `differential_read_stream` call closes the stream it owns, including
        # its own error paths; if the first read fails, this helper closes the
        # still-open sibling before propagating the exact typed failure. This
        # prevents a large differential campaign from leaking one descriptor
        # per failed candidate while preserving OutputLimit/Process identity.
        def differential_read_stream_pair(stdout_stream: heap void&, stderr_stream: heap void&, max_output_bytes: u64, stdout_text: mutable sview&, stderr_text: mutable sview&) -> void error[DifferentialRunnerError] can[Memory.Allocate, Memory.Release, Blocking.IO]:
            stdout_size: mutable i64 = 0
            catch differential_stream_size(stdout_stream):
                ok size:
                    stdout_size <- size
                error failure:
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    raise failure
            stderr_size: mutable i64 = 0
            catch differential_stream_size(stderr_stream):
                ok size:
                    stderr_size <- size
                error failure:
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    raise failure
            if not differential_stream_pair_within_limit(stdout_size, stderr_size, max_output_bytes):
                _ = fclose(stdout_stream)
                _ = fclose(stderr_stream)
                raise DifferentialRunnerError.OutputLimit
            catch differential_read_stream(stdout_stream, max_output_bytes):
                ok value:
                    stdout_text <- value
                error failure:
                    _ = fclose(stderr_stream)
                    raise failure
            catch differential_read_stream(stderr_stream, max_output_bytes):
                ok value:
                    stderr_text <- value
                error failure:
                    raise failure


        # Complete a temporary-file write across short stdio progress reports;
        # a zero-byte report or host error indicator is terminal. The caller
        # retains its existing typed error and cleanup policy.
        def differential_write_stream_fully(stream: heap void&, data: u8&, length: usize) -> usize can[Blocking.IO]:
            offset: mutable usize = 0
            while offset < length:
                remaining: usize = length - offset
                buffer: mutable u8& = data + offset
                amount: usize = fwrite(buffer.cast[void&], 1, remaining, stream)
                return offset if amount == 0 or amount > remaining or ferror(stream) != 0
                offset <- offset + amount
            return offset


        def differential_process_status(status: int) -> i64:
            signal_number: int = status & 0x7f
            return ((status >> 8) & 0xff).i64() if signal_number == 0 else (128 + signal_number).i64()


        def differential_process_was_signaled(status: int) -> bool:
            return (status & 0x7f) != 0


        def differential_process_signal_number(status: int) -> u32:
            return (status & 0x7f).u32()


        def differential_process_result_from_status(status: int, stdout: sview, stderr: sview) -> ProcessResult error[DifferentialRunnerError]:
            result: ProcessResult = ProcessResult{kind: ProcessResultKind.Signaled if differential_process_was_signaled(status) else ProcessResultKind.Exited, exit_status: differential_process_status(status), signal: differential_process_signal_number(status), stdout: stdout, stderr: stderr}
            catch validate_process_result(result):
                ok:
                    return result
                error failure:
                    raise DifferentialRunnerError.Process


        def differential_signal_process(pid: int, signal: int) -> void can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= DIFFERENTIAL_MAX_EINTR_RETRIES:
                return if elisascript_posix_kill(pid, signal) == 0
                errno: mutable int& = elisascript_posix_errno()
                return if errno[0] != ES_RUNTIME_ERRNO_EINTR
                retries <- retries + 1


        def differential_setpgid_parent(pid: int) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= DIFFERENTIAL_MAX_EINTR_RETRIES:
                return true if elisascript_posix_setpgid(pid, pid) == 0
                errno: mutable int& = elisascript_posix_errno()
                return true if errno[0] == ES_RUNTIME_ERRNO_EACCES
                return false if errno[0] != ES_RUNTIME_ERRNO_EINTR
                retries <- retries + 1
            return false


        def differential_dup2_child(source: int, destination: int) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= DIFFERENTIAL_MAX_EINTR_RETRIES:
                return true if elisascript_posix_dup2(source, destination) >= 0
                errno: mutable int& = elisascript_posix_errno()
                return false if errno[0] != ES_RUNTIME_ERRNO_EINTR
                retries <- retries + 1
            return false


        def differential_setpgid_child() -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= DIFFERENTIAL_MAX_EINTR_RETRIES:
                return true if elisascript_posix_setpgid(0, 0) == 0
                errno: mutable int& = elisascript_posix_errno()
                return false if errno[0] != ES_RUNTIME_ERRNO_EINTR
                retries <- retries + 1
            return false


        # Best-effort termination used on every parent-side failure after fork.
        # Request cooperative TERM first, wait a bounded number of no-hang
        # polls, then force KILL and reap. The negative PID targets the private
        # process group only after the parent confirms group creation; the
        # direct PID is always signaled and reaped. This prevents a failed
        # setpgid from targeting an unrelated group while still closing the
        # direct-child race safely. Both signaling and the blocking reap
        # tolerate bounded EINTR interruptions.
        def differential_terminate_process(pid: int, group_ready: bool, status: mutable int&) -> void can[Blocking.IO]:
            differential_signal_process(-pid, DIFFERENTIAL_SIGNAL_TERM) if group_ready
            differential_signal_process(pid, DIFFERENTIAL_SIGNAL_TERM)
            grace_polls: mutable u64 = 0
            leader_reaped: mutable bool = false
            while grace_polls < DIFFERENTIAL_TERM_GRACE_POLLS:
                waited: int = elisascript_posix_waitpid(pid, status, DIFFERENTIAL_WAIT_NOHANG)
                if waited == pid or waited > 0:
                    leader_reaped <- true
                    break
                if waited < 0:
                    errno: mutable int& = elisascript_posix_errno()
                    break if errno[0] != ES_RUNTIME_ERRNO_EINTR
                break if not differential_wait_sleep()
                grace_polls <- grace_polls + 1
            differential_signal_process(-pid, DIFFERENTIAL_SIGNAL_KILL) if group_ready
            differential_signal_process(pid, DIFFERENTIAL_SIGNAL_KILL) if not leader_reaped
            return if leader_reaped
            retries: mutable usize = 0
            while retries <= DIFFERENTIAL_MAX_EINTR_RETRIES:
                waited: int = elisascript_posix_waitpid(pid, status, 0)
                return if waited == pid or waited >= 0
                errno: mutable int& = elisascript_posix_errno()
                return if errno[0] != ES_RUNTIME_ERRNO_EINTR
                retries <- retries + 1


        def differential_wait_sleep() -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= DIFFERENTIAL_MAX_EINTR_RETRIES:
                return true if elisascript_posix_usleep(1000) == 0
                errno: mutable int& = elisascript_posix_errno()
                return false if errno[0] != ES_RUNTIME_ERRNO_EINTR
                retries <- retries + 1
            return false


    public:
        # Execute a validated process invocation without a shell.  The optional
        # entry is the first argv element for adapter-style invocations (for
        # example `python3 adapter.py ...`).  stdout, stderr, and stdin use
        # temporary files so a child cannot deadlock the parent by filling a
        # pipe while it runs.  `timeout_steps` counts bounded wait polls; a
        # timed-out child is killed and reported through the typed error channel.
        def execute_differential_process(invocation: DifferentialProcessInvocation) -> DifferentialRun error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            # Keep the direct host boundary as strict as the runner validator:
            # callers that bypass `prepare_differential_process` must still
            # provide a positive output ceiling before any child is launched.
            raise DifferentialRunnerError.Invalid if invocation.executable == "" or invocation.timeout_steps == 0 or invocation.timeout_steps > DIFFERENTIAL_DEFAULT_MAX_TIMEOUT_STEPS or invocation.max_output_bytes == 0 or invocation.max_output_bytes > DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES
            raise DifferentialRunnerError.Invalid if not differential_process_text_field_lengths_fit(invocation.executable, invocation.entry, invocation.arguments, invocation.working_directory, invocation.environment)
            raise DifferentialRunnerError.Invalid if differential_sview_has_nul(invocation.executable) or differential_sview_has_nul(invocation.entry) or differential_sview_has_nul(invocation.working_directory)
            raise DifferentialRunnerError.Invalid if invocation.arguments.count > DIFFERENTIAL_DEFAULT_MAX_ARGUMENTS or invocation.environment.count > DIFFERENTIAL_DEFAULT_MAX_ENVIRONMENT_ENTRIES
            raise DifferentialRunnerError.Invalid if not differential_process_text_bytes_fits(invocation.executable, invocation.entry, invocation.arguments, invocation.working_directory, invocation.environment) or sview_len(invocation.stdin) > DIFFERENTIAL_DEFAULT_MAX_PROCESS_INPUT_BYTES or invocation.stdin_bytes.count > DIFFERENTIAL_DEFAULT_MAX_PROCESS_INPUT_BYTES
            raise DifferentialRunnerError.Invalid if invocation.stdin_binary and invocation.stdin != ""
            raise DifferentialRunnerError.Invalid if not invocation.stdin_binary and invocation.stdin_bytes.count != 0
            raise DifferentialRunnerError.Invalid if not differential_process_command_valid(invocation)
            for argument in invocation.arguments:
                raise DifferentialRunnerError.Invalid if differential_sview_has_nul(argument)
            for entry in invocation.environment:
                raise DifferentialRunnerError.Invalid if entry.name == "" or differential_sview_has_nul(entry.name) or sview_contains_byte(entry.name, 61) or differential_sview_has_nul(entry.value)
            for index in 0..<invocation.environment.count |invocation|:
                for prior in 0..<index |invocation|:
                    raise DifferentialRunnerError.Invalid if invocation.environment[prior].name == invocation.environment[index].name

            executable_bytes: dstr = differential_cstring(invocation.executable)
            if executable_bytes.items == null:
                raise DifferentialRunnerError.Process
            executable_items: u8& = executable_bytes.items
            owned_arguments: mutable darray[dstr] = []
            argv: mutable darray[cstr] = []
            owned_environment_names: mutable darray[dstr] = []
            owned_environment_values: mutable darray[dstr] = []
            owned_arguments.reserve(invocation.arguments.count)
            argv.reserve(invocation.arguments.count)
            owned_environment_names.reserve(invocation.environment.count)
            owned_environment_values.reserve(invocation.environment.count)
            argv.push(executable_items.cast[cstr])
            if invocation.entry != "":
                entry_bytes: dstr = differential_cstring(invocation.entry)
                if entry_bytes.items == null:
                    raise DifferentialRunnerError.Process
                owned_arguments.push(entry_bytes)
                entry_items: mutable u8&? = owned_arguments[owned_arguments.count - 1].items
                if entry_items == null:
                    raise DifferentialRunnerError.Process
                argv.push(entry_items.cast[cstr])
            for argument in invocation.arguments |owned_arguments, argv|:
                argument_bytes: dstr = differential_cstring(argument)
                if argument_bytes.items == null:
                    raise DifferentialRunnerError.Process
                owned_arguments.push(argument_bytes)
                argument_items: mutable u8&? = owned_arguments[owned_arguments.count - 1].items
                if argument_items == null:
                    raise DifferentialRunnerError.Process
                argv.push(argument_items.cast[cstr])
            for entry in invocation.environment |owned_environment_names, owned_environment_values|:
                name_bytes: dstr = differential_cstring(entry.name)
                value_bytes: dstr = differential_cstring(entry.value)
                if name_bytes.items == null or value_bytes.items == null:
                    raise DifferentialRunnerError.Process
                owned_environment_names.push(name_bytes)
                owned_environment_values.push(value_bytes)
            argv.push(executable_items.cast[cstr])
            terminator: mutable void& = (&argv[argv.count - 1]).cast[mutable void&] can Unsafe.PointerCast
            _ = memset(terminator, 0, size_of(uintptr))
            argv_items: void& = (&argv[0]).cast[void&] can Unsafe.PointerCast

            can Blocking.IO, Memory.Allocate, Memory.Release:
                input_handle: mutable heap void&? = elisascript_posix_tmpfile()
                if input_handle == null:
                    raise DifferentialRunnerError.Process
                input_stream: mutable heap void& = input_handle
                if invocation.stdin_binary and invocation.stdin_bytes.count > 0 and differential_write_stream_fully(input_stream, (&invocation.stdin_bytes[0]).cast[mutable u8&], invocation.stdin_bytes.count) != invocation.stdin_bytes.count:
                    _ = fclose(input_stream)
                    raise DifferentialRunnerError.Process
                if not invocation.stdin_binary and sview_len(invocation.stdin) > 0 and differential_write_stream_fully(input_stream, invocation.stdin.data, sview_len(invocation.stdin)) != sview_len(invocation.stdin):
                    _ = fclose(input_stream)
                    raise DifferentialRunnerError.Process
                if fseek(input_stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = fclose(input_stream)
                    raise DifferentialRunnerError.Process
                input_descriptor: int = elisascript_posix_fileno(input_stream)
                if input_descriptor < 0:
                    _ = fclose(input_stream)
                    raise DifferentialRunnerError.Process

                stdout_handle: mutable heap void&? = elisascript_posix_tmpfile()
                if stdout_handle == null:
                    _ = fclose(input_stream)
                    raise DifferentialRunnerError.Process
                stdout_stream: mutable heap void& = stdout_handle
                stdout_descriptor: int = elisascript_posix_fileno(stdout_stream)
                if stdout_descriptor < 0:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    raise DifferentialRunnerError.Process

                stderr_handle: mutable heap void&? = elisascript_posix_tmpfile()
                if stderr_handle == null:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    raise DifferentialRunnerError.Process
                stderr_stream: mutable heap void& = stderr_handle
                stderr_descriptor: int = elisascript_posix_fileno(stderr_stream)
                if stderr_descriptor < 0:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    raise DifferentialRunnerError.Process

                pid: int = elisascript_posix_fork()
                if pid < 0:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    raise DifferentialRunnerError.Process
                if pid == 0:
                    # Keep the reference process and every descendant in one
                    # private group so timeout cleanup cannot leak a child.
                    elisascript_posix_exit(126) if not differential_setpgid_child()
                    elisascript_posix_exit(126) if not differential_dup2_child(input_descriptor, 0)
                    elisascript_posix_exit(126) if not differential_dup2_child(stdout_descriptor, 1)
                    elisascript_posix_exit(126) if not differential_dup2_child(stderr_descriptor, 2)
                    if invocation.working_directory != "":
                        working_directory_bytes: dstr = differential_cstring(invocation.working_directory)
                        elisascript_posix_exit(126) if working_directory_bytes.items == null or elisascript_posix_chdir(working_directory_bytes.items.cast[cstr]) != 0
                    for offset in 0..<owned_environment_names.count |owned_environment_names, owned_environment_values|:
                        name_storage: mutable u8&? = owned_environment_names[offset].items
                        value_storage: mutable u8&? = owned_environment_values[offset].items
                        if name_storage == null or value_storage == null:
                            elisascript_posix_exit(126)
                        else:
                            name_items: mutable u8& = name_storage
                            value_items: mutable u8& = value_storage
                            elisascript_posix_exit(126) if elisascript_posix_setenv(name_items.cast[cstr], value_items.cast[cstr], 1) != 0
                    _ = elisascript_posix_execvp(executable_items.cast[cstr], argv_items)
                    elisascript_posix_exit(127)
                    return DifferentialRun{observations: []}

                status: mutable int = 0
                group_ready: bool = differential_setpgid_parent(pid)
                if not group_ready:
                    # Never continue with an unowned child. A direct PID kill
                    # cannot contain descendants once group admission fails,
                    # so terminate/reap before releasing the streams and
                    # report a typed process error.
                    differential_terminate_process(pid, false, status)
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    raise DifferentialRunnerError.Process
                polls: mutable u64 = 0
                eintr_retries: mutable usize = 0
                finished: mutable bool = false
                while not finished:
                    waited: int = elisascript_posix_waitpid(pid, status, DIFFERENTIAL_WAIT_NOHANG)
                    if waited == pid:
                        eintr_retries <- 0
                        finished <- true
                    elif waited < 0:
                        errno: mutable int& = elisascript_posix_errno()
                        if errno[0] == ES_RUNTIME_ERRNO_EINTR and eintr_retries < DIFFERENTIAL_MAX_EINTR_RETRIES:
                            eintr_retries <- eintr_retries + 1
                            if not differential_wait_sleep():
                                differential_terminate_process(pid, group_ready, status)
                                _ = fclose(input_stream)
                                _ = fclose(stdout_stream)
                                _ = fclose(stderr_stream)
                                raise DifferentialRunnerError.Process
                        else:
                            differential_terminate_process(pid, group_ready, status)
                            _ = fclose(input_stream)
                            _ = fclose(stdout_stream)
                            _ = fclose(stderr_stream)
                            raise DifferentialRunnerError.Process
                    else:
                        eintr_retries <- 0
                        stdout_size: mutable i64 = 0
                        stderr_size: mutable i64 = 0
                        catch differential_stream_size(stdout_stream):
                            ok size:
                                stdout_size <- size
                            error failure:
                                differential_terminate_process(pid, group_ready, status)
                                _ = fclose(input_stream)
                                _ = fclose(stdout_stream)
                                _ = fclose(stderr_stream)
                                raise failure
                        catch differential_stream_size(stderr_stream):
                            ok size:
                                stderr_size <- size
                            error failure:
                                differential_terminate_process(pid, group_ready, status)
                                _ = fclose(input_stream)
                                _ = fclose(stdout_stream)
                                _ = fclose(stderr_stream)
                                raise failure
                        if not differential_stream_pair_within_limit(stdout_size, stderr_size, invocation.max_output_bytes):
                            differential_terminate_process(pid, group_ready, status)
                            _ = fclose(input_stream)
                            _ = fclose(stdout_stream)
                            _ = fclose(stderr_stream)
                            raise DifferentialRunnerError.OutputLimit
                        # `timeout_steps` is positive by contract. Compare
                        # against its predecessor before incrementing so a
                        # maximum-width timeout cannot wrap the poll counter,
                        # while preserving the existing one-poll timeout
                        # semantics.
                        if polls >= invocation.timeout_steps - 1:
                            differential_terminate_process(pid, group_ready, status)
                            _ = fclose(input_stream)
                            _ = fclose(stdout_stream)
                            _ = fclose(stderr_stream)
                            raise DifferentialRunnerError.Timeout
                        polls <- polls + 1
                        if not differential_wait_sleep():
                            differential_terminate_process(pid, group_ready, status)
                            _ = fclose(input_stream)
                            _ = fclose(stdout_stream)
                            _ = fclose(stderr_stream)
                            raise DifferentialRunnerError.Process
                if fclose(input_stream) != 0:
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    raise DifferentialRunnerError.Process
                stdout_text: mutable sview = ""
                stderr_text: mutable sview = ""
                catch differential_read_stream_pair(stdout_stream, stderr_stream, invocation.max_output_bytes, stdout_text, stderr_text):
                    ok:
                        pass
                    error failure:
                        raise failure
                process_result: ProcessResult = try differential_process_result_from_status(status, stdout_text, stderr_text)
                return DifferentialRun{exit_status: process_result.exit_status, stdout: process_result.stdout, stderr: process_result.stderr, observations: [], return_value: DifferentialValue{kind: DifferentialValueKind.Int, integer: process_result.exit_status}, outcome: DifferentialRunOutcome.Crash if process_result.kind == ProcessResultKind.Signaled else DifferentialRunOutcome.Completed}


        # End-to-end process boundary for ordinary runner values. Preparation
        # remains a separate public operation for hosts that need to inspect or
        # rewrite an invocation, while this helper makes the safe default a
        # single typed call.
        def run_differential_process(runner: DifferentialRunner&) -> DifferentialRun error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            region process_run(1048576):
                invocation: DifferentialProcessInvocation = try prepare_differential_process(runner)
                return try execute_differential_process(invocation)


    private:
        # In-process execution deliberately shares the host's filesystem,
        # environment, and standard input. Applying process-shaped overrides
        # here would mutate global state or make stdin nondeterministic, so the
        # adapter rejects them rather than silently ignoring a runner field.
        def differential_elisascript_world_configuration_supported(runner: DifferentialRunner&) -> bool:
            return runner.working_directory == "" and runner.environment.count == 0 and runner.stdin == "" and runner.protocol == ""


    public:
        # Execute an Elisascript file in-process through the same source loader,
        # verifier, and bytecode boundary used by ordinary launchers. Arguments
        # remain typed text values and observations are copied into the owned
        # differential pool before the temporary runtime storage is released.
        def run_differential_elisascript[@r](runner: DifferentialRunner&, result: mutable DifferentialRun& @r) -> void error[DifferentialRunnerError, ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            check: DifferentialRunnerCheck = validate_differential_runner(runner)
            raise DifferentialRunnerError.Invalid if not check.valid
            raise DifferentialRunnerError.UnsupportedKind if runner.kind != DifferentialRunnerKind.ElisascriptFile
            raise DifferentialRunnerError.UnsupportedConfiguration if not differential_elisascript_world_configuration_supported(runner)
            target_length: usize = sview_len(runner.target)
            raise DifferentialRunnerError.Invalid if target_length >= EsIr::ELISASCRIPT_MAX_FILENAME_BYTES
            allocation_length: usize = target_length + 1
            allocation_i64: i64 = allocation_length.i64()
            raise DifferentialRunnerError.Invalid if allocation_length == 0 or allocation_i64 < 0 or allocation_i64.usize() != allocation_length
            path_bytes: mutable dstr = ctx_fstr_alloc(allocation_length)
            if path_bytes.items == null:
                raise DifferentialRunnerError.Process
            ctx_fstr_append(path_bytes, runner.target.data, target_length)
            ctx_fstr_append(path_bytes, "\0", 1)
            path_items: mutable u8& = path_bytes.items
            arguments: mutable darray[RuntimeValue] = []
            for argument in runner.arguments |arguments|:
                arguments.push(runtime_text(argument))
            observations: mutable darray[Observation] = []
            runtime_storage: mutable darray[RuntimeValue] = []
            execution: Execution = try execute_elisascript_file_with_handlers(path_items, "differential", runner.entry, arguments, observations, runtime_storage, runner.handlers, runner.timeout_steps, runner.max_output_bytes.usize())
            result.engine_known <- true
            result.engine <- execution.engine
            result.capability_known <- execution.capability_known
            result.capability <- execution.capability
            result.resource_policy_known <- true
            result.resource_policy <- execution.policy
            result.resource_usage <- execution.usage
            result.return_value <- try differential_value_from_runtime(runtime_storage, execution.value, result.values)
            try append_differential_observations_from_runtime(runtime_storage, observations, result.values, result.observations)


        # Execute a standard `.elisascript` program through its launcher ABI.
        # The signed i64 returned by main is both the typed return observation and
        # the process-style exit status, so a native reference and an in-process
        # Elisascript candidate can be compared without an adapter-specific rule.
        def run_differential_elisascript_program[@r](runner: DifferentialRunner&, result: mutable DifferentialRun& @r) -> void error[DifferentialRunnerError, ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            check: DifferentialRunnerCheck = validate_differential_runner(runner)
            raise DifferentialRunnerError.Invalid if not check.valid
            raise DifferentialRunnerError.UnsupportedKind if runner.kind != DifferentialRunnerKind.ElisascriptProgram
            raise DifferentialRunnerError.UnsupportedConfiguration if not differential_elisascript_world_configuration_supported(runner)
            raise DifferentialRunnerError.Invalid if sview_len(runner.target) >= EsIr::ELISASCRIPT_MAX_FILENAME_BYTES
            path_bytes: dstr = differential_cstring(runner.target)
            if path_bytes.items == null:
                raise DifferentialRunnerError.Process
            path_items: mutable u8& = path_bytes.items
            observations: mutable darray[Observation] = []
            runtime_storage: mutable darray[RuntimeValue] = []
            execution: Execution = try execute_elisascript_program_file_with_handlers(path_items, runner.arguments, observations, runtime_storage, runner.handlers, runner.timeout_steps, runner.max_output_bytes.usize())
            result.engine_known <- true
            result.engine <- execution.engine
            result.capability_known <- execution.capability_known
            result.capability <- execution.capability
            result.resource_policy_known <- true
            result.resource_policy <- execution.policy
            result.resource_usage <- execution.usage
            result.return_value <- try differential_value_from_runtime(runtime_storage, execution.value, result.values)
            result.exit_status <- execution.value.integer if execution.value.kind == RuntimeValueKind.Int else 1
            try append_differential_observations_from_runtime(runtime_storage, observations, result.values, result.observations)


        const enum DifferentialDifferenceKind of u8:
            Equal
            Engine
            ExitStatus
            Error
            Stdout
            Stderr
            ReturnValue
            ObservationCount
            ObservationTrace
            ObservationValue
            Outcome
            CaseInvalid
            ObservationContract


        struct DifferentialComparison:
            equal: mutable bool
            kind: mutable DifferentialDifferenceKind
            index: mutable u32 = 0
            observation_schema_digest_0: mutable u64 = 0
            observation_schema_digest_1: mutable u64 = 0
            observation_schema_digest_2: mutable u64 = 0
            observation_schema_digest_3: mutable u64 = 0
            reason: mutable sview = ""
            reference_text: mutable sview = ""
            candidate_text: mutable sview = ""
            reference_value: mutable DifferentialValue = DifferentialValue{kind: DifferentialValueKind.Void}
            candidate_value: mutable DifferentialValue = DifferentialValue{kind: DifferentialValueKind.Void}
            reference_engine: mutable EsIr::ExecutionEngine = EsIr::ExecutionEngine.ReferenceInterpreter
            candidate_engine: mutable EsIr::ExecutionEngine = EsIr::ExecutionEngine.ReferenceInterpreter
            reference_outcome: mutable DifferentialRunOutcome = DifferentialRunOutcome.Completed
            candidate_outcome: mutable DifferentialRunOutcome = DifferentialRunOutcome.Completed


        error DifferentialCaseReplayError:
            InvalidOrder
            InvalidCase
            InvalidSession
            ManifestMismatch
            RunnerNotReady
            RunOrderInvalid
            ComparisonNotReady
            ArtifactNotReady


        # Host adapters own this case-bound lifecycle while performing actual
        # filesystem and process I/O. It composes the existing replay and world
        # materialization state machines, retains the exact typed runs, and
        # stores a comparison only after both sides have completed.
        struct DifferentialCaseReplaySession:
            format_version: u8 = 1
            manifest: DifferentialArtifactManifest
            world_snapshot: DifferentialWorldSnapshot
            materialization: DifferentialWorldMaterializationPlan
            replay: EsDifferentialReplay::DifferentialReplaySession
            reference_root_binding: darray[u8] = []
            candidate_root_binding: darray[u8] = []
            reference_runner_fingerprint: u64 = 0
            candidate_runner_fingerprint: u64 = 0
            case_timeout_steps: u64 = 0
            case_max_output_bytes: u64 = 0
            reference_run: DifferentialRun = DifferentialRun{observations: []}
            candidate_run: DifferentialRun = DifferentialRun{observations: []}
            reference_run_fingerprint: u64 = 0
            candidate_run_fingerprint: u64 = 0
            has_reference_run: bool = false
            has_candidate_run: bool = false
            comparison: DifferentialComparison = DifferentialComparison{equal: false, kind: DifferentialDifferenceKind.Equal}
            has_comparison: bool = false


        const enum DifferentialResourceDifferenceKind of u8:
            Equal
            Unknown
            Policy
            Steps
            Elapsed
            Memory
            OpenHandles
            Processes
            Output
            RegexWork
            RetainedTraces
            ConcurrentTasks


        struct DifferentialResourceComparison:
            equal: bool
            kind: DifferentialResourceDifferenceKind
            reason: sview = ""


        # A comparison report is the bounded, machine-readable portion of a
        # differential artifact. Large aggregate values remain in separate
        # payload files; this sidecar still identifies the first mismatch and
        # preserves enough typed metadata to reject an ambiguous parity claim.
        struct DifferentialComparisonArtifact:
            format_version: u8 = 2
            manifest_fingerprint: u64 = 0
            equal: bool = false
            kind: DifferentialDifferenceKind
            index: u32 = 0
            reference_engine: EsIr::ExecutionEngine = EsIr::ExecutionEngine.ReferenceInterpreter
            candidate_engine: EsIr::ExecutionEngine = EsIr::ExecutionEngine.ReferenceInterpreter
            reference_value_kind: DifferentialValueKind = DifferentialValueKind.Void
            candidate_value_kind: DifferentialValueKind = DifferentialValueKind.Void
            reference_outcome: DifferentialRunOutcome = DifferentialRunOutcome.Completed
            candidate_outcome: DifferentialRunOutcome = DifferentialRunOutcome.Completed
            reason: sview = ""
            reference_text: sview = ""
            candidate_text: sview = ""


        struct DifferentialComparisonArtifactDecode:
            valid: bool
            artifact: DifferentialComparisonArtifact


    private:
        const enum DifferentialCompareState of u8:
            Outcome
            ExitStatus
            Error
            Stdout
            Stderr
            ReturnValue
            ObservationCount
            Observation
            Done


        struct DifferentialCompareCursor:
            state: mutable DifferentialCompareState
            index: mutable usize
            result: mutable DifferentialComparison
            policy: DifferentialComparatorPolicy


        const enum DifferentialValueEqualState of u8:
            Select
            Scalar
            ArrayValidate
            ArrayPush
            MapValidate
            Done


        struct DifferentialValueEqualPair:
            left: DifferentialValue
            right: DifferentialValue
            depth: usize


        struct DifferentialValueEqualCursor:
            state: mutable DifferentialValueEqualState
            index: mutable usize
            current: mutable DifferentialValueEqualPair
            pending: mutable darray[DifferentialValueEqualPair]
            equal: mutable bool
            comparisons: mutable usize
            policy: DifferentialComparatorPolicy


        # Equality uses an explicit pair stack rather than recursive array calls.
        # Pair depth and total selections are bounded as well, so cyclic or
        # heavily shared flat views cannot exhaust the host stack or loop
        # forever through the map helper.
        def differential_float_equal(left: f64, right: f64, tolerance: DifferentialFloatTolerance) -> bool:
            return false if tolerance.absolute < 0.0 or tolerance.relative < 0.0
            # Preserve exact equality for the same infinity, while rejecting a
            # finite value that could otherwise appear equal through `inf <=
            # inf` after relative scaling. NaN is rejected by `value == value`.
            return true if left == right
            left_finite: bool = left == left and left * 0.0 == 0.0
            right_finite: bool = right == right and right * 0.0 == 0.0
            return false if not left_finite or not right_finite
            difference: mutable f64 = left - right
            difference <- -difference if difference < 0.0
            left_scale: mutable f64 = left
            left_scale <- -left_scale if left_scale < 0.0
            right_scale: mutable f64 = right
            right_scale <- -right_scale if right_scale < 0.0
            scale: f64 = left_scale if left_scale > right_scale else right_scale
            return difference <= tolerance.absolute + tolerance.relative * scale


        def differential_text_length(value: sview, comparison: DifferentialTextComparison) -> usize:
            length: mutable usize = sview_len(value)
            return length if comparison == DifferentialTextComparison.Exact or length == 0
            if sview_at(value, length - 1) == 10:
                length <- length - 1
                length <- length - 1 if length > 0 and sview_at(value, length - 1) == 13
            return length


        def differential_text_equal(left: sview, right: sview, comparison: DifferentialTextComparison) -> bool:
            left_length: usize = differential_text_length(left, comparison)
            right_length: usize = differential_text_length(right, comparison)
            return false if left_length != right_length
            index: mutable usize = 0
            while index < left_length:
                return false if sview_at(left, index) != sview_at(right, index)
                index <- index + 1
            return true


        def differential_values_equal(left_storage: darray[DifferentialValue]&, left: DifferentialValue, right_storage: darray[DifferentialValue]&, right: DifferentialValue, policy: DifferentialComparatorPolicy = DifferentialComparatorPolicy{}, depth: usize = 0) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if left_storage.count > DIFFERENTIAL_DEFAULT_MAX_VALUES or right_storage.count > DIFFERENTIAL_DEFAULT_MAX_VALUES
            return false if depth > DIFFERENTIAL_DEFAULT_MAX_VALUE_DEPTH
            return false if not differential_comparator_policy_valid(policy)
            cursor: mutable DifferentialValueEqualCursor = DifferentialValueEqualCursor{state: DifferentialValueEqualState.Select, index: 0, current: DifferentialValueEqualPair{left: left, right: right, depth: depth}, pending: [DifferentialValueEqualPair{left: left, right: right, depth: depth}], equal: true, comparisons: 0, policy: policy}
            machine over cursor.state while cursor.equal:
                state Compare
                start Compare

                Compare, DifferentialValueEqualState.Select if cursor.pending.count == 0:
                    cursor.state <- DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.Select if cursor.comparisons >= DIFFERENTIAL_DEFAULT_MAX_COMPARISON_PAIRS:
                    cursor.equal <- false
                    cursor.state <- DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.Select if not differential_value_kind_valid(cursor.pending[cursor.pending.count - 1].left.kind) or not differential_value_kind_valid(cursor.pending[cursor.pending.count - 1].right.kind):
                    cursor.equal <- false
                    cursor.state <- DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.Select if cursor.pending[cursor.pending.count - 1].depth > DIFFERENTIAL_DEFAULT_MAX_VALUE_DEPTH:
                    cursor.equal <- false
                    cursor.state <- DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.Select:
                    cursor.comparisons <- cursor.comparisons + 1
                    cursor.current <- cursor.pending.pop()
                    cursor.state <- DifferentialValueEqualState.ArrayValidate if cursor.current.left.kind == DifferentialValueKind.Array else DifferentialValueEqualState.MapValidate if cursor.current.left.kind == DifferentialValueKind.Map else DifferentialValueEqualState.Scalar
                    -> Compare
                Compare, DifferentialValueEqualState.Scalar if cursor.current.left.kind != cursor.current.right.kind:
                    cursor.equal <- false
                    cursor.state <- DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.Scalar if cursor.current.left.kind == DifferentialValueKind.Void:
                    cursor.state <- DifferentialValueEqualState.Select
                    -> Compare
                Compare, DifferentialValueEqualState.Scalar if cursor.current.left.kind == DifferentialValueKind.Bool:
                    cursor.equal <- cursor.current.left.boolean == cursor.current.right.boolean
                    cursor.state <- DifferentialValueEqualState.Select if cursor.equal else DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.Scalar if cursor.current.left.kind == DifferentialValueKind.Int:
                    cursor.equal <- cursor.current.left.integer == cursor.current.right.integer
                    cursor.state <- DifferentialValueEqualState.Select if cursor.equal else DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.Scalar if cursor.current.left.kind == DifferentialValueKind.Float:
                    cursor.equal <- differential_float_equal(cursor.current.left.decimal, cursor.current.right.decimal, cursor.policy.float_tolerance)
                    cursor.state <- DifferentialValueEqualState.Select if cursor.equal else DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.Scalar if cursor.current.left.kind == DifferentialValueKind.ProcessCapture:
                    cursor.equal <- cursor.current.left.process_exit_status == cursor.current.right.process_exit_status and differential_text_equal(cursor.current.left.process_stdout, cursor.current.right.process_stdout, cursor.policy.text) and differential_text_equal(cursor.current.left.process_stderr, cursor.current.right.process_stderr, cursor.policy.text)
                    cursor.state <- DifferentialValueEqualState.Select if cursor.equal else DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.Scalar:
                    cursor.equal <- differential_text_equal(cursor.current.left.text, cursor.current.right.text, cursor.policy.text)
                    cursor.state <- DifferentialValueEqualState.Select if cursor.equal else DifferentialValueEqualState.Done
                    -> Compare

                Compare, DifferentialValueEqualState.ArrayValidate if cursor.current.left.kind != cursor.current.right.kind:
                    cursor.equal <- false
                    cursor.state <- DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.ArrayValidate if cursor.current.left.array_count != cursor.current.right.array_count:
                    cursor.equal <- false
                    cursor.state <- DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.ArrayValidate if not differential_array_value_range_valid(left_storage, cursor.current.left) or not differential_array_value_range_valid(right_storage, cursor.current.right):
                    cursor.equal <- false
                    cursor.state <- DifferentialValueEqualState.Done
                    -> Compare
                Compare, DifferentialValueEqualState.ArrayValidate:
                    cursor.index <- 0
                    cursor.state <- DifferentialValueEqualState.ArrayPush
                    -> Compare

                Compare, DifferentialValueEqualState.ArrayPush if cursor.index >= cursor.current.left.array_count.usize():
                    cursor.state <- DifferentialValueEqualState.Select
                    -> Compare
                Compare, DifferentialValueEqualState.ArrayPush:
                    cursor.pending.push(DifferentialValueEqualPair{left: left_storage[cursor.current.left.array_start.usize() + cursor.index], right: right_storage[cursor.current.right.array_start.usize() + cursor.index], depth: cursor.current.depth + 1})
                    cursor.index <- cursor.index + 1
                    -> Compare

                Compare, DifferentialValueEqualState.MapValidate:
                    cursor.equal <- differential_map_values_equal(left_storage, cursor.current.left, right_storage, cursor.current.right, cursor.policy, cursor.current.depth)
                    cursor.state <- DifferentialValueEqualState.Select if cursor.equal else DifferentialValueEqualState.Done
                    -> Compare

                Compare, DifferentialValueEqualState.Done:
                    break

            return cursor.equal


        # Map snapshots use the same order-insensitive key/value semantics as the
        # interpreter.  A key/value pair is considered present when both members
        # compare equal; duplicate entries therefore remain deterministic data.
        def differential_map_values_equal(left_storage: darray[DifferentialValue]&, left: DifferentialValue, right_storage: darray[DifferentialValue]&, right: DifferentialValue, policy: DifferentialComparatorPolicy = DifferentialComparatorPolicy{}, depth: usize = 0) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if depth > DIFFERENTIAL_DEFAULT_MAX_VALUE_DEPTH
            false return if left.kind != DifferentialValueKind.Map or right.kind != DifferentialValueKind.Map
            false return if left.map_count != right.map_count
            false return if left_storage.count > DIFFERENTIAL_DEFAULT_MAX_VALUES or right_storage.count > DIFFERENTIAL_DEFAULT_MAX_VALUES
            false return if left.map_count.usize() > DIFFERENTIAL_DEFAULT_MAX_VALUES / 2 or right.map_count.usize() > DIFFERENTIAL_DEFAULT_MAX_VALUES / 2
            false return if not differential_map_value_range_valid(left_storage, left) or not differential_map_value_range_valid(right_storage, right)
            if policy.maps == DifferentialMapComparison.Ordered:
                for offset in 0..<left.map_count.usize() |left_storage, right_storage, left, right, policy|:
                    left_pair: usize = left.map_start.usize() + offset * 2
                    right_pair: usize = right.map_start.usize() + offset * 2
                    return false if not differential_values_equal(left_storage, left_storage[left_pair], right_storage, right_storage[right_pair], policy, depth + 1)
                    return false if not differential_values_equal(left_storage, left_storage[left_pair + 1], right_storage, right_storage[right_pair + 1], policy, depth + 1)
                return true
            # Matching is a bijection, even for malformed snapshots that contain
            # duplicate pairs. Without ownership tracking, one right-hand pair
            # could satisfy several left-hand entries and hide a real difference.
            matched: mutable darray[bool] = []
            for _ in 0..<right.map_count.usize() |matched|:
                matched.push(false)
            for left_offset in 0..<left.map_count.usize() |left_storage, right_storage, left, right|:
                left_pair: usize = left.map_start.usize() + left_offset * 2
                left_key: DifferentialValue = left_storage[left_pair]
                left_value: DifferentialValue = left_storage[left_pair + 1]
                found: mutable bool = false
                for right_offset in 0..<right.map_count.usize() |left_storage, right_storage, right, left_key, left_value, found, matched|:
                    right_pair: usize = right.map_start.usize() + right_offset * 2
                    right_key: DifferentialValue = right_storage[right_pair]
                    right_value: DifferentialValue = right_storage[right_pair + 1]
                    if not matched[right_offset] and differential_values_equal(left_storage, left_key, right_storage, right_key, policy, depth + 1) and differential_values_equal(left_storage, left_value, right_storage, right_value, policy, depth + 1):
                        found <- true
                        matched[right_offset] <- true
                false return if not found
            return true


        def differential_comparison(kind: DifferentialDifferenceKind, index: u32, reason: sview) -> DifferentialComparison:
            return DifferentialComparison{equal: false, kind: kind, index: index, reason: reason}


        def differential_engine_metadata_valid(run: DifferentialRun&) -> bool:
            return true if not run.engine_known and not run.capability_known
            return false if run.capability_known and not run.engine_known
            return false if run.engine != EsIr::ExecutionEngine.ReferenceInterpreter and run.engine != EsIr::ExecutionEngine.DirectBytecode and run.engine != EsIr::ExecutionEngine.BytecodeInterpreterFallback
            return true if not run.capability_known
            return false if run.engine == EsIr::ExecutionEngine.DirectBytecode and not run.capability.direct_supported
            return false if run.engine == EsIr::ExecutionEngine.BytecodeInterpreterFallback and run.capability.direct_supported
            return false if run.engine == EsIr::ExecutionEngine.ReferenceInterpreter and run.capability.direct_supported
            return true


        def differential_engine_requirement_satisfied(reference: DifferentialRun&, candidate: DifferentialRun&, requirement: DifferentialEngineRequirement) -> bool:
            return false if requirement != DifferentialEngineRequirement.Ignore and (not differential_engine_metadata_valid(reference) or not differential_engine_metadata_valid(candidate))
            match requirement:
                DifferentialEngineRequirement.Ignore:
                    return true
                DifferentialEngineRequirement.RequireKnown:
                    return reference.engine_known and candidate.engine_known
                DifferentialEngineRequirement.RequireDistinct:
                    return reference.engine_known and candidate.engine_known and reference.engine != candidate.engine
                DifferentialEngineRequirement.RequireDirectBytecodeCandidate:
                    return candidate.engine_known and candidate.capability_known and candidate.engine == EsIr::ExecutionEngine.DirectBytecode and candidate.capability.direct_supported


        # Compare values using the ordinary deterministic state machine, but
        # reject an unqualified backend before any value mismatch can be
        # reported. The returned comparison carries both engine identities so a
        # machine-readable artifact can explain why a parity claim was refused.
    public:
        # Resource usage is a separate parity dimension from observable output.
        # External processes may leave it unknown, but known in-process runs
        # must agree on the policy and every bounded counter before a caller
        # claims equivalent cleanup and resource behavior.
        def compare_differential_resource_usage(reference: DifferentialRun&, candidate: DifferentialRun&) -> DifferentialResourceComparison:
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.Unknown, reason: "resource snapshots are not known for both runs"} if not reference.resource_policy_known or not candidate.resource_policy_known
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.Policy, reason: "resource policies differ"} if reference.resource_policy.steps != candidate.resource_policy.steps or reference.resource_policy.elapsed_micros != candidate.resource_policy.elapsed_micros or reference.resource_policy.memory_bytes != candidate.resource_policy.memory_bytes or reference.resource_policy.open_handles != candidate.resource_policy.open_handles or reference.resource_policy.processes != candidate.resource_policy.processes or reference.resource_policy.output_bytes != candidate.resource_policy.output_bytes or reference.resource_policy.regex_work != candidate.resource_policy.regex_work or reference.resource_policy.retained_traces != candidate.resource_policy.retained_traces or reference.resource_policy.concurrent_tasks != candidate.resource_policy.concurrent_tasks
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.Steps, reason: "resource step usage differs"} if reference.resource_usage.steps != candidate.resource_usage.steps
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.Elapsed, reason: "resource elapsed usage differs"} if reference.resource_usage.elapsed_micros != candidate.resource_usage.elapsed_micros
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.Memory, reason: "resource memory usage differs"} if reference.resource_usage.memory_bytes != candidate.resource_usage.memory_bytes
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.OpenHandles, reason: "open-handle cleanup usage differs"} if reference.resource_usage.open_handles != candidate.resource_usage.open_handles
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.Processes, reason: "process cleanup usage differs"} if reference.resource_usage.processes != candidate.resource_usage.processes
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.Output, reason: "resource output usage differs"} if reference.resource_usage.output_bytes != candidate.resource_usage.output_bytes
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.RegexWork, reason: "regex work usage differs"} if reference.resource_usage.regex_work != candidate.resource_usage.regex_work
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.RetainedTraces, reason: "retained trace usage differs"} if reference.resource_usage.retained_traces != candidate.resource_usage.retained_traces
            return DifferentialResourceComparison{equal: false, kind: DifferentialResourceDifferenceKind.ConcurrentTasks, reason: "concurrent-task cleanup usage differs"} if reference.resource_usage.concurrent_tasks != candidate.resource_usage.concurrent_tasks
            return DifferentialResourceComparison{equal: true, kind: DifferentialResourceDifferenceKind.Equal, reason: "resource usage is equal"}


        def compare_differential_runs_with_engine_requirement_policy(reference: DifferentialRun&, candidate: DifferentialRun&, requirement: DifferentialEngineRequirement, policy: DifferentialComparatorPolicy = DifferentialComparatorPolicy{}) -> DifferentialComparison:
            if not differential_comparator_policy_valid(policy):
                return differential_comparison(DifferentialDifferenceKind.ReturnValue, 0, "comparison policy is invalid")
            if not differential_engine_requirement_satisfied(reference, candidate, requirement):
                mismatch: mutable DifferentialComparison = differential_comparison(DifferentialDifferenceKind.Engine, 0, "engine requirement not satisfied")
                mismatch.reference_engine <- reference.engine
                mismatch.candidate_engine <- candidate.engine
                return mismatch
            return compare_differential_runs_with_policy(reference, candidate, policy)


        def compare_differential_runs_with_engine_requirement(reference: DifferentialRun&, candidate: DifferentialRun&, requirement: DifferentialEngineRequirement, tolerance: DifferentialFloatTolerance = DifferentialFloatTolerance{}) -> DifferentialComparison:
            return compare_differential_runs_with_engine_requirement_policy(reference, candidate, requirement, DifferentialComparatorPolicy{float_tolerance: tolerance})


        # Strong case-aware comparison first preserves ordinary first-difference
        # precedence, then checks each run against the case's closed observation
        # schema. This catches shared omissions that pairwise run comparison
        # cannot detect while keeping that low-level comparator source-compatible.
        def compare_differential_case_runs(case: DifferentialCase&, reference: DifferentialRun&, candidate: DifferentialRun&) -> DifferentialComparison can[Memory.Allocate, Abort.Panic]:
            case_check: DifferentialCaseCheck = validate_differential_case(case)
            if not case_check.valid:
                invalid_case: mutable DifferentialComparison = differential_comparison(DifferentialDifferenceKind.CaseInvalid, 0, "differential case is invalid")
                invalid_case.reference_text <- case_check.reason
                return invalid_case
            comparison: mutable DifferentialComparison = compare_differential_runs_with_engine_requirement_policy(reference, candidate, case.engine_requirement, differential_case_comparator(case))
            return comparison if not comparison.equal
            schema_bytes: darray[u8] = differential_observation_schema_canonical_bytes(case.observation_schema)
            schema_digest: darray[u8] = EsIr::canonical_bytes_sha256(schema_bytes)
            if schema_digest.count != 32:
                fingerprint_failure: mutable DifferentialComparison = differential_comparison(DifferentialDifferenceKind.CaseInvalid, 0, "case observation schema could not be fingerprinted")
                return fingerprint_failure
            reference_schema_check: DifferentialObservationSchemaCheck = differential_run_observation_schema_check(reference, case.observation_schema)
            if not reference_schema_check.valid:
                mismatch: mutable DifferentialComparison = differential_comparison(DifferentialDifferenceKind.ObservationContract, reference_schema_check.index, "reference run violates the case observation schema")
                mismatch.reference_text <- reference_schema_check.reason
                mismatch.observation_schema_digest_0 <- EsIr::canonical_digest_word(schema_digest, 0)
                mismatch.observation_schema_digest_1 <- EsIr::canonical_digest_word(schema_digest, 1)
                mismatch.observation_schema_digest_2 <- EsIr::canonical_digest_word(schema_digest, 2)
                mismatch.observation_schema_digest_3 <- EsIr::canonical_digest_word(schema_digest, 3)
                return mismatch
            candidate_schema_check: DifferentialObservationSchemaCheck = differential_run_observation_schema_check(candidate, case.observation_schema)
            if not candidate_schema_check.valid:
                mismatch: mutable DifferentialComparison = differential_comparison(DifferentialDifferenceKind.ObservationContract, candidate_schema_check.index, "candidate run violates the case observation schema")
                mismatch.candidate_text <- candidate_schema_check.reason
                mismatch.observation_schema_digest_0 <- EsIr::canonical_digest_word(schema_digest, 0)
                mismatch.observation_schema_digest_1 <- EsIr::canonical_digest_word(schema_digest, 1)
                mismatch.observation_schema_digest_2 <- EsIr::canonical_digest_word(schema_digest, 2)
                mismatch.observation_schema_digest_3 <- EsIr::canonical_digest_word(schema_digest, 3)
                return mismatch
            return comparison


        # The policy-aware entry point is the only comparison path that can
        # opt into text normalization or ordered maps.  The legacy tolerance
        # wrapper below remains source-compatible and selects exact text plus
        # unordered maps.
        def compare_differential_runs_with_policy(reference: DifferentialRun&, candidate: DifferentialRun&, policy: DifferentialComparatorPolicy = DifferentialComparatorPolicy{}) -> DifferentialComparison:
            return differential_comparison(DifferentialDifferenceKind.ReturnValue, 0, "comparison policy is invalid") if not differential_comparator_policy_valid(policy)
            return differential_comparison(DifferentialDifferenceKind.ReturnValue, 0, "run text exceeds differential budget") if not differential_run_text_bytes_fits(reference) or not differential_run_text_bytes_fits(candidate)
            return differential_comparison(DifferentialDifferenceKind.ObservationCount, 0, "observation count exceeds differential budget") if reference.observations.count > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS or candidate.observations.count > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS
            return differential_comparison(DifferentialDifferenceKind.ReturnValue, 0, "owned value pool exceeds differential budget") if reference.values.count > DIFFERENTIAL_DEFAULT_MAX_VALUES or candidate.values.count > DIFFERENTIAL_DEFAULT_MAX_VALUES
            return differential_comparison(DifferentialDifferenceKind.ReturnValue, 0, "owned value text exceeds differential budget") if not differential_run_value_text_bytes_fits(reference) or not differential_run_value_text_bytes_fits(candidate)
            cursor: mutable DifferentialCompareCursor = DifferentialCompareCursor{state: DifferentialCompareState.Outcome, index: 0, result: DifferentialComparison{equal: true, kind: DifferentialDifferenceKind.Equal}, policy: policy}
            machine over cursor.state while cursor.result.equal:
                state Compare
                start Compare

                Compare, DifferentialCompareState.Outcome if reference.outcome == candidate.outcome:
                    cursor.state <- DifferentialCompareState.ExitStatus
                    -> Compare
                Compare, DifferentialCompareState.Outcome:
                    cursor.result <- differential_comparison(DifferentialDifferenceKind.Outcome, 0, "run outcome differs")
                    cursor.result.reference_outcome <- reference.outcome
                    cursor.result.candidate_outcome <- candidate.outcome
                    cursor.state <- DifferentialCompareState.Done
                    -> Compare

                Compare, DifferentialCompareState.ExitStatus if reference.exit_status == candidate.exit_status:
                    cursor.state <- DifferentialCompareState.Error
                    -> Compare
                Compare, DifferentialCompareState.ExitStatus:
                    cursor.result <- differential_comparison(DifferentialDifferenceKind.ExitStatus, 0, "exit status differs")
                    cursor.state <- DifferentialCompareState.Done
                    -> Compare

                Compare, DifferentialCompareState.Error if differential_text_equal(reference.error_text, candidate.error_text, cursor.policy.text):
                    cursor.state <- DifferentialCompareState.Stdout
                    -> Compare
                Compare, DifferentialCompareState.Error:
                    cursor.result <- differential_comparison(DifferentialDifferenceKind.Error, 0, "error differs")
                    cursor.result.reference_text <- reference.error_text
                    cursor.result.candidate_text <- candidate.error_text
                    cursor.state <- DifferentialCompareState.Done
                    -> Compare

                Compare, DifferentialCompareState.Stdout if differential_text_equal(reference.stdout, candidate.stdout, cursor.policy.text):
                    cursor.state <- DifferentialCompareState.Stderr
                    -> Compare
                Compare, DifferentialCompareState.Stdout:
                    cursor.result <- differential_comparison(DifferentialDifferenceKind.Stdout, 0, "stdout differs")
                    cursor.result.reference_text <- reference.stdout
                    cursor.result.candidate_text <- candidate.stdout
                    cursor.state <- DifferentialCompareState.Done
                    -> Compare

                Compare, DifferentialCompareState.Stderr if differential_text_equal(reference.stderr, candidate.stderr, cursor.policy.text):
                    cursor.state <- DifferentialCompareState.ReturnValue
                    -> Compare
                Compare, DifferentialCompareState.Stderr:
                    cursor.result <- differential_comparison(DifferentialDifferenceKind.Stderr, 0, "stderr differs")
                    cursor.result.reference_text <- reference.stderr
                    cursor.result.candidate_text <- candidate.stderr
                    cursor.state <- DifferentialCompareState.Done
                    -> Compare

                Compare, DifferentialCompareState.ReturnValue if differential_values_equal(reference.values, reference.return_value, candidate.values, candidate.return_value, cursor.policy):
                    cursor.state <- DifferentialCompareState.ObservationCount
                    -> Compare
                Compare, DifferentialCompareState.ReturnValue:
                    cursor.result <- differential_comparison(DifferentialDifferenceKind.ReturnValue, 0, "return value differs")
                    cursor.result.reference_value <- reference.return_value
                    cursor.result.candidate_value <- candidate.return_value
                    cursor.state <- DifferentialCompareState.Done
                    -> Compare

                Compare, DifferentialCompareState.ObservationCount if reference.observations.count == candidate.observations.count:
                    cursor.index <- 0
                    cursor.state <- DifferentialCompareState.Observation
                    -> Compare
                Compare, DifferentialCompareState.ObservationCount:
                    cursor.result <- differential_comparison(DifferentialDifferenceKind.ObservationCount, 0, "observation count differs")
                    cursor.state <- DifferentialCompareState.Done
                    -> Compare

                Compare, DifferentialCompareState.Observation if cursor.index >= reference.observations.count:
                    cursor.state <- DifferentialCompareState.Done
                    -> Compare
                Compare, DifferentialCompareState.Observation if reference.observations[cursor.index].trace == candidate.observations[cursor.index].trace and differential_values_equal(reference.values, reference.observations[cursor.index].value, candidate.values, candidate.observations[cursor.index].value, cursor.policy):
                    cursor.index <- cursor.index + 1
                    -> Compare
                Compare, DifferentialCompareState.Observation if reference.observations[cursor.index].trace != candidate.observations[cursor.index].trace:
                    cursor.result <- differential_comparison(DifferentialDifferenceKind.ObservationTrace, cursor.index.u32(), "observation trace differs")
                    cursor.state <- DifferentialCompareState.Done
                    -> Compare
                Compare, DifferentialCompareState.Observation:
                    cursor.result <- differential_comparison(DifferentialDifferenceKind.ObservationValue, cursor.index.u32(), "observation value differs")
                    cursor.result.reference_value <- reference.observations[cursor.index].value
                    cursor.result.candidate_value <- candidate.observations[cursor.index].value
                    cursor.state <- DifferentialCompareState.Done
                    -> Compare

                Compare, DifferentialCompareState.Done:
                    break

            return cursor.result


        def compare_differential_runs(reference: DifferentialRun&, candidate: DifferentialRun&, tolerance: DifferentialFloatTolerance = DifferentialFloatTolerance{}) -> DifferentialComparison:
            return compare_differential_runs_with_policy(reference, candidate, DifferentialComparatorPolicy{float_tolerance: tolerance})


    private:
        const DIFFERENTIAL_MAX_COMPARISON_ARTIFACT_BYTES: usize = 1048576
        const DIFFERENTIAL_MAX_COMPARISON_TEXT_BYTES: usize = 1048512


        def differential_difference_kind_valid(kind: DifferentialDifferenceKind) -> bool:
            return kind in {DifferentialDifferenceKind.Equal, DifferentialDifferenceKind.Engine, DifferentialDifferenceKind.ExitStatus, DifferentialDifferenceKind.Error, DifferentialDifferenceKind.Stdout, DifferentialDifferenceKind.Stderr, DifferentialDifferenceKind.ReturnValue, DifferentialDifferenceKind.ObservationCount, DifferentialDifferenceKind.ObservationTrace, DifferentialDifferenceKind.ObservationValue, DifferentialDifferenceKind.Outcome, DifferentialDifferenceKind.CaseInvalid, DifferentialDifferenceKind.ObservationContract}


        def differential_run_outcome_valid(outcome: DifferentialRunOutcome) -> bool:
            return outcome in {DifferentialRunOutcome.Completed, DifferentialRunOutcome.NormalError, DifferentialRunOutcome.SpawnFailure, DifferentialRunOutcome.Crash, DifferentialRunOutcome.Timeout, DifferentialRunOutcome.OutputLimit, DifferentialRunOutcome.CompileFailure}


        def differential_execution_engine_valid(engine: EsIr::ExecutionEngine) -> bool:
            return engine in {EsIr::ExecutionEngine.ReferenceInterpreter, EsIr::ExecutionEngine.DirectBytecode, EsIr::ExecutionEngine.BytecodeInterpreterFallback}


        def differential_comparison_artifact_text_bytes_fits(artifact: DifferentialComparisonArtifact&) -> bool:
            total: mutable usize = 0
            length: usize = sview_len(artifact.reason)
            return false if length > DIFFERENTIAL_MAX_COMPARISON_TEXT_BYTES - total
            total <- total + length
            length <- sview_len(artifact.reference_text)
            return false if length > DIFFERENTIAL_MAX_COMPARISON_TEXT_BYTES - total
            total <- total + length
            length <- sview_len(artifact.candidate_text)
            return false if length > DIFFERENTIAL_MAX_COMPARISON_TEXT_BYTES - total
            total <- total + length
            return total <= DIFFERENTIAL_MAX_COMPARISON_TEXT_BYTES


        def differential_comparison_artifact_valid(artifact: DifferentialComparisonArtifact&) -> bool:
            return false if artifact.format_version != 2 and artifact.format_version != 3
            return false if artifact.manifest_fingerprint == 0
            return false if artifact.equal and artifact.kind != DifferentialDifferenceKind.Equal
            return false if not artifact.equal and artifact.kind == DifferentialDifferenceKind.Equal
            return false if artifact.format_version == 2 and (artifact.kind == DifferentialDifferenceKind.CaseInvalid or artifact.kind == DifferentialDifferenceKind.ObservationContract)
            return false if not differential_difference_kind_valid(artifact.kind)
            return false if not differential_execution_engine_valid(artifact.reference_engine) or not differential_execution_engine_valid(artifact.candidate_engine)
            return false if not differential_value_kind_valid(artifact.reference_value_kind) or not differential_value_kind_valid(artifact.candidate_value_kind)
            return false if not differential_run_outcome_valid(artifact.reference_outcome) or not differential_run_outcome_valid(artifact.candidate_outcome)
            return differential_comparison_artifact_text_bytes_fits(artifact)


    public:
        # Materialize only the bounded comparison evidence. The manifest
        # fingerprint binds this report to the case/world identity; callers can
        # store larger value pools and process streams in separate files.
        def make_differential_comparison_artifact(manifest: DifferentialArtifactManifest&, comparison: DifferentialComparison&) -> DifferentialComparisonArtifact error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialRunnerError.Invalid if not differential_artifact_manifest_valid(manifest)
            raise DifferentialRunnerError.Invalid if comparison.kind == DifferentialDifferenceKind.ObservationContract and manifest.format_version != 5
            raise DifferentialRunnerError.Invalid if comparison.kind == DifferentialDifferenceKind.ObservationContract and (manifest.observation_schema_digest_0 != comparison.observation_schema_digest_0 or manifest.observation_schema_digest_1 != comparison.observation_schema_digest_1 or manifest.observation_schema_digest_2 != comparison.observation_schema_digest_2 or manifest.observation_schema_digest_3 != comparison.observation_schema_digest_3)
            artifact_version: u8 = 3 if comparison.kind == DifferentialDifferenceKind.CaseInvalid or comparison.kind == DifferentialDifferenceKind.ObservationContract else 2
            artifact: DifferentialComparisonArtifact = DifferentialComparisonArtifact{format_version: artifact_version, manifest_fingerprint: differential_artifact_manifest_fingerprint(manifest), equal: comparison.equal, kind: comparison.kind, index: comparison.index, reference_engine: comparison.reference_engine, candidate_engine: comparison.candidate_engine, reference_value_kind: comparison.reference_value.kind, candidate_value_kind: comparison.candidate_value.kind, reference_outcome: comparison.reference_outcome, candidate_outcome: comparison.candidate_outcome, reason: comparison.reason, reference_text: comparison.reference_text, candidate_text: comparison.candidate_text}
            raise DifferentialRunnerError.Invalid if artifact.manifest_fingerprint == 0 or not differential_difference_kind_valid(artifact.kind)
            raise DifferentialRunnerError.OutputLimit if not differential_comparison_artifact_text_bytes_fits(artifact)
            return artifact


        # ESCR is a versioned, length-delimited report envelope. Text is not
        # treated as C strings, so embedded process-output bytes remain intact.
        def canonical_differential_comparison_artifact_bytes(artifact: DifferentialComparisonArtifact) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not differential_comparison_artifact_valid(artifact)
            output: mutable darray[u8] = []
            EsIr::canonical_artifact_emit_byte(output, 69)
            EsIr::canonical_artifact_emit_byte(output, 83)
            EsIr::canonical_artifact_emit_byte(output, 67)
            EsIr::canonical_artifact_emit_byte(output, 82)
            EsIr::canonical_artifact_emit_byte(output, artifact.format_version)
            EsIr::canonical_artifact_emit_u64(output, artifact.manifest_fingerprint)
            EsIr::canonical_artifact_emit_byte(output, 1 if artifact.equal else 0)
            EsIr::canonical_artifact_emit_byte(output, artifact.kind.u8())
            EsIr::canonical_artifact_emit_u64(output, artifact.index.u64())
            EsIr::canonical_artifact_emit_byte(output, artifact.reference_engine.u8())
            EsIr::canonical_artifact_emit_byte(output, artifact.candidate_engine.u8())
            EsIr::canonical_artifact_emit_byte(output, artifact.reference_value_kind.u8())
            EsIr::canonical_artifact_emit_byte(output, artifact.candidate_value_kind.u8())
            EsIr::canonical_artifact_emit_byte(output, artifact.reference_outcome.u8())
            EsIr::canonical_artifact_emit_byte(output, artifact.candidate_outcome.u8())
            EsIr::canonical_artifact_emit_text(output, artifact.reason)
            EsIr::canonical_artifact_emit_text(output, artifact.reference_text)
            EsIr::canonical_artifact_emit_text(output, artifact.candidate_text)
            return [] if output.count > DIFFERENTIAL_MAX_COMPARISON_ARTIFACT_BYTES
            return output


        def differential_comparison_artifact_fingerprint(artifact: DifferentialComparisonArtifact) -> u64 can[Memory.Allocate, Abort.Panic]:
            encoded: darray[u8] = canonical_differential_comparison_artifact_bytes(artifact)
            return 0 if encoded.count == 0
            fingerprint: mutable u64 = 14695981039346656037
            for byte in encoded |fingerprint|:
                fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, byte)
            return fingerprint


    private:
        def differential_decode_comparison_artifact(bytes: darray[u8]&) -> DifferentialComparisonArtifactDecode can[Unsafe.PointerCast]:
            invalid: DifferentialComparisonArtifact = DifferentialComparisonArtifact{}
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if bytes.count < 5 or bytes.count > DIFFERENTIAL_MAX_COMPARISON_ARTIFACT_BYTES
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if bytes[0] != 69 or bytes[1] != 83 or bytes[2] != 67 or bytes[3] != 82 or (bytes[4] != 2 and bytes[4] != 3)
            format_version: u8 = bytes[4]
            offset: mutable usize = 5
            manifest_fingerprint: mutable u64 = 0
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_u64(bytes, offset, manifest_fingerprint)
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if offset >= bytes.count
            equal_byte: u8 = bytes[offset]
            offset <- offset + 1
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if equal_byte > 1
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if offset >= bytes.count
            kind_byte: u8 = bytes[offset]
            offset <- offset + 1
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if not differential_difference_kind_byte_valid(kind_byte)
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if format_version == 2 and (kind_byte == DifferentialDifferenceKind.CaseInvalid.u8() or kind_byte == DifferentialDifferenceKind.ObservationContract.u8())
            index_value: mutable u64 = 0
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_u64(bytes, offset, index_value) or index_value > 4294967295
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if offset > bytes.count
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if bytes.count - offset < 4
            reference_engine_byte: u8 = bytes[offset]
            candidate_engine_byte: u8 = bytes[offset + 1]
            reference_value_kind_byte: u8 = bytes[offset + 2]
            candidate_value_kind_byte: u8 = bytes[offset + 3]
            offset <- offset + 4
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if not differential_execution_engine_byte_valid(reference_engine_byte) or not differential_execution_engine_byte_valid(candidate_engine_byte)
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if not differential_value_kind_byte_valid(reference_value_kind_byte) or not differential_value_kind_byte_valid(candidate_value_kind_byte)
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if offset > bytes.count
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if bytes.count - offset < 2
            reference_outcome_byte: u8 = bytes[offset]
            candidate_outcome_byte: u8 = bytes[offset + 1]
            offset <- offset + 2
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if not differential_run_outcome_byte_valid(reference_outcome_byte) or not differential_run_outcome_byte_valid(candidate_outcome_byte)
            reason_start: mutable usize = 0
            reason_end: mutable usize = 0
            reference_start: mutable usize = 0
            reference_end: mutable usize = 0
            candidate_start: mutable usize = 0
            candidate_end: mutable usize = 0
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if not differential_manifest_read_text_bounds(bytes, offset, reason_start, reason_end) or not differential_manifest_read_text_bounds(bytes, offset, reference_start, reference_end) or not differential_manifest_read_text_bounds(bytes, offset, candidate_start, candidate_end) or offset != bytes.count
            kind: DifferentialDifferenceKind = DifferentialDifferenceKind.Equal
            kind <- DifferentialDifferenceKind.Engine if kind_byte == DifferentialDifferenceKind.Engine.u8()
            kind <- DifferentialDifferenceKind.ExitStatus if kind_byte == DifferentialDifferenceKind.ExitStatus.u8()
            kind <- DifferentialDifferenceKind.Error if kind_byte == DifferentialDifferenceKind.Error.u8()
            kind <- DifferentialDifferenceKind.Stdout if kind_byte == DifferentialDifferenceKind.Stdout.u8()
            kind <- DifferentialDifferenceKind.Stderr if kind_byte == DifferentialDifferenceKind.Stderr.u8()
            kind <- DifferentialDifferenceKind.ReturnValue if kind_byte == DifferentialDifferenceKind.ReturnValue.u8()
            kind <- DifferentialDifferenceKind.ObservationCount if kind_byte == DifferentialDifferenceKind.ObservationCount.u8()
            kind <- DifferentialDifferenceKind.ObservationTrace if kind_byte == DifferentialDifferenceKind.ObservationTrace.u8()
            kind <- DifferentialDifferenceKind.ObservationValue if kind_byte == DifferentialDifferenceKind.ObservationValue.u8()
            kind <- DifferentialDifferenceKind.Outcome if kind_byte == DifferentialDifferenceKind.Outcome.u8()
            kind <- DifferentialDifferenceKind.CaseInvalid if kind_byte == DifferentialDifferenceKind.CaseInvalid.u8()
            kind <- DifferentialDifferenceKind.ObservationContract if kind_byte == DifferentialDifferenceKind.ObservationContract.u8()
            reference_engine: EsIr::ExecutionEngine = EsIr::ExecutionEngine.ReferenceInterpreter
            reference_engine <- EsIr::ExecutionEngine.DirectBytecode if reference_engine_byte == EsIr::ExecutionEngine.DirectBytecode.u8()
            reference_engine <- EsIr::ExecutionEngine.BytecodeInterpreterFallback if reference_engine_byte == EsIr::ExecutionEngine.BytecodeInterpreterFallback.u8()
            candidate_engine: EsIr::ExecutionEngine = EsIr::ExecutionEngine.ReferenceInterpreter
            candidate_engine <- EsIr::ExecutionEngine.DirectBytecode if candidate_engine_byte == EsIr::ExecutionEngine.DirectBytecode.u8()
            candidate_engine <- EsIr::ExecutionEngine.BytecodeInterpreterFallback if candidate_engine_byte == EsIr::ExecutionEngine.BytecodeInterpreterFallback.u8()
            reference_value_kind: DifferentialValueKind = DifferentialValueKind.Void
            reference_value_kind <- DifferentialValueKind.Bool if reference_value_kind_byte == DifferentialValueKind.Bool.u8()
            reference_value_kind <- DifferentialValueKind.Int if reference_value_kind_byte == DifferentialValueKind.Int.u8()
            reference_value_kind <- DifferentialValueKind.Float if reference_value_kind_byte == DifferentialValueKind.Float.u8()
            reference_value_kind <- DifferentialValueKind.Array if reference_value_kind_byte == DifferentialValueKind.Array.u8()
            reference_value_kind <- DifferentialValueKind.Map if reference_value_kind_byte == DifferentialValueKind.Map.u8()
            reference_value_kind <- DifferentialValueKind.Text if reference_value_kind_byte == DifferentialValueKind.Text.u8()
            reference_value_kind <- DifferentialValueKind.ProcessCapture if reference_value_kind_byte == DifferentialValueKind.ProcessCapture.u8()
            candidate_value_kind: DifferentialValueKind = DifferentialValueKind.Void
            candidate_value_kind <- DifferentialValueKind.Bool if candidate_value_kind_byte == DifferentialValueKind.Bool.u8()
            candidate_value_kind <- DifferentialValueKind.Int if candidate_value_kind_byte == DifferentialValueKind.Int.u8()
            candidate_value_kind <- DifferentialValueKind.Float if candidate_value_kind_byte == DifferentialValueKind.Float.u8()
            candidate_value_kind <- DifferentialValueKind.Array if candidate_value_kind_byte == DifferentialValueKind.Array.u8()
            candidate_value_kind <- DifferentialValueKind.Map if candidate_value_kind_byte == DifferentialValueKind.Map.u8()
            candidate_value_kind <- DifferentialValueKind.Text if candidate_value_kind_byte == DifferentialValueKind.Text.u8()
            candidate_value_kind <- DifferentialValueKind.ProcessCapture if candidate_value_kind_byte == DifferentialValueKind.ProcessCapture.u8()
            reference_outcome: DifferentialRunOutcome = DifferentialRunOutcome.Completed
            reference_outcome <- DifferentialRunOutcome.NormalError if reference_outcome_byte == DifferentialRunOutcome.NormalError.u8()
            reference_outcome <- DifferentialRunOutcome.SpawnFailure if reference_outcome_byte == DifferentialRunOutcome.SpawnFailure.u8()
            reference_outcome <- DifferentialRunOutcome.Crash if reference_outcome_byte == DifferentialRunOutcome.Crash.u8()
            reference_outcome <- DifferentialRunOutcome.Timeout if reference_outcome_byte == DifferentialRunOutcome.Timeout.u8()
            reference_outcome <- DifferentialRunOutcome.OutputLimit if reference_outcome_byte == DifferentialRunOutcome.OutputLimit.u8()
            reference_outcome <- DifferentialRunOutcome.CompileFailure if reference_outcome_byte == DifferentialRunOutcome.CompileFailure.u8()
            candidate_outcome: DifferentialRunOutcome = DifferentialRunOutcome.Completed
            candidate_outcome <- DifferentialRunOutcome.NormalError if candidate_outcome_byte == DifferentialRunOutcome.NormalError.u8()
            candidate_outcome <- DifferentialRunOutcome.SpawnFailure if candidate_outcome_byte == DifferentialRunOutcome.SpawnFailure.u8()
            candidate_outcome <- DifferentialRunOutcome.Crash if candidate_outcome_byte == DifferentialRunOutcome.Crash.u8()
            candidate_outcome <- DifferentialRunOutcome.Timeout if candidate_outcome_byte == DifferentialRunOutcome.Timeout.u8()
            candidate_outcome <- DifferentialRunOutcome.OutputLimit if candidate_outcome_byte == DifferentialRunOutcome.OutputLimit.u8()
            candidate_outcome <- DifferentialRunOutcome.CompileFailure if candidate_outcome_byte == DifferentialRunOutcome.CompileFailure.u8()
            artifact: DifferentialComparisonArtifact = DifferentialComparisonArtifact{format_version: format_version, manifest_fingerprint: manifest_fingerprint, equal: equal_byte == 1, kind: kind, index: index_value.u32(), reference_engine: reference_engine, candidate_engine: candidate_engine, reference_value_kind: reference_value_kind, candidate_value_kind: candidate_value_kind, reference_outcome: reference_outcome, candidate_outcome: candidate_outcome, reason: differential_manifest_text_view(bytes, reason_start, reason_end), reference_text: differential_manifest_text_view(bytes, reference_start, reference_end), candidate_text: differential_manifest_text_view(bytes, candidate_start, candidate_end)}
            return DifferentialComparisonArtifactDecode{valid: false, artifact: invalid} if not differential_comparison_artifact_valid(artifact)
            return DifferentialComparisonArtifactDecode{valid: true, artifact: artifact}


    public:
        def differential_comparison_artifact_bytes_valid(bytes: darray[u8]&) -> bool can[Unsafe.PointerCast]:
            return differential_decode_comparison_artifact(bytes).valid


        def decode_differential_comparison_artifact(bytes: darray[u8]&) -> DifferentialComparisonArtifactDecode can[Unsafe.PointerCast]:
            return differential_decode_comparison_artifact(bytes)


    private:
        const enum DifferentialArtifactReplayState of u8:
            Manifest
            Index
            ManifestBinding
            Comparison
            ReferenceProcess
            CandidateProcess
            Reproduction
            ReferenceValuePool
            CandidateValuePool
            Fingerprints
            Done


        struct DifferentialArtifactReplayCursor:
            state: mutable DifferentialArtifactReplayState
            result: mutable DifferentialArtifactReplayCheck
            manifest_fingerprint: mutable u64 = 0


        def differential_artifact_replay_failure(issue: DifferentialArtifactReplayIssue, reason: sview) -> DifferentialArtifactReplayCheck:
            return DifferentialArtifactReplayCheck{valid: false, issue: issue, reason: reason}


    public:
        # Admit only a self-consistent, complete artifact bundle. This is a
        # pre-replay boundary: it does not execute the reproduction entry or
        # trust any sidecar merely because its bytes are individually valid.
        # The state machine keeps the order explicit so a prepared, mixed, or
        # stale directory fails before a replay adapter can launch anything.
        def validate_differential_artifact_bundle(manifest: DifferentialArtifactManifest&, index: DifferentialArtifactIndex&, comparison: DifferentialComparisonArtifact&, reference_process: DifferentialProcessStreamArtifact&, candidate_process: DifferentialProcessStreamArtifact&, reproduction: DifferentialReproductionArtifact&, reference_values: DifferentialValuePoolArtifact&, candidate_values: DifferentialValuePoolArtifact&) -> DifferentialArtifactReplayCheck can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            cursor: mutable DifferentialArtifactReplayCursor = DifferentialArtifactReplayCursor{state: DifferentialArtifactReplayState.Manifest, result: DifferentialArtifactReplayCheck{valid: true, issue: DifferentialArtifactReplayIssue.None}}
            machine over cursor.state:
                state Validate
                start Validate

                Validate, DifferentialArtifactReplayState.Manifest if differential_artifact_manifest_valid(manifest):
                    cursor.manifest_fingerprint <- differential_artifact_manifest_fingerprint(manifest)
                    cursor.state <- DifferentialArtifactReplayState.Index
                    -> Validate
                Validate, DifferentialArtifactReplayState.Manifest:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.InvalidManifest, "artifact replay manifest is invalid")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate

                Validate, DifferentialArtifactReplayState.Index if differential_artifact_index_valid(index):
                    cursor.state <- DifferentialArtifactReplayState.ManifestBinding
                    -> Validate
                Validate, DifferentialArtifactReplayState.Index:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.InvalidIndex, "artifact replay index is invalid")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate

                Validate, DifferentialArtifactReplayState.ManifestBinding if index.publication == DifferentialArtifactPublicationState.Complete and index.manifest_fingerprint == cursor.manifest_fingerprint:
                    cursor.state <- DifferentialArtifactReplayState.Comparison
                    -> Validate
                Validate, DifferentialArtifactReplayState.ManifestBinding if index.publication != DifferentialArtifactPublicationState.Complete:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.Incomplete, "artifact replay index is not complete")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.ManifestBinding:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ManifestFingerprintMismatch, "artifact replay index is bound to another manifest")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate

                Validate, DifferentialArtifactReplayState.Comparison if differential_comparison_artifact_valid(comparison) and comparison.manifest_fingerprint == cursor.manifest_fingerprint:
                    cursor.state <- DifferentialArtifactReplayState.ReferenceProcess
                    -> Validate
                Validate, DifferentialArtifactReplayState.Comparison if not differential_comparison_artifact_valid(comparison):
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ComparisonInvalid, "comparison sidecar is invalid")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.Comparison:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ManifestFingerprintMismatch, "comparison sidecar is bound to another manifest")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate

                Validate, DifferentialArtifactReplayState.ReferenceProcess if differential_process_stream_artifact_valid(reference_process) and reference_process.manifest_fingerprint == cursor.manifest_fingerprint and reference_process.side == DifferentialArtifactSide.Reference:
                    cursor.state <- DifferentialArtifactReplayState.CandidateProcess
                    -> Validate
                Validate, DifferentialArtifactReplayState.ReferenceProcess if not differential_process_stream_artifact_valid(reference_process):
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ReferenceProcessInvalid, "reference process sidecar is invalid")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.ReferenceProcess if reference_process.manifest_fingerprint != cursor.manifest_fingerprint:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ManifestFingerprintMismatch, "reference process sidecar is bound to another manifest")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.ReferenceProcess:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.SideMismatch, "reference process sidecar has candidate side identity")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate

                Validate, DifferentialArtifactReplayState.CandidateProcess if differential_process_stream_artifact_valid(candidate_process) and candidate_process.manifest_fingerprint == cursor.manifest_fingerprint and candidate_process.side == DifferentialArtifactSide.Candidate:
                    cursor.state <- DifferentialArtifactReplayState.Reproduction
                    -> Validate
                Validate, DifferentialArtifactReplayState.CandidateProcess if not differential_process_stream_artifact_valid(candidate_process):
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.CandidateProcessInvalid, "candidate process sidecar is invalid")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.CandidateProcess if candidate_process.manifest_fingerprint != cursor.manifest_fingerprint:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ManifestFingerprintMismatch, "candidate process sidecar is bound to another manifest")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.CandidateProcess:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.SideMismatch, "candidate process sidecar has reference side identity")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate

                Validate, DifferentialArtifactReplayState.Reproduction if differential_reproduction_artifact_valid(reproduction) and reproduction.manifest_fingerprint == cursor.manifest_fingerprint:
                    cursor.state <- DifferentialArtifactReplayState.ReferenceValuePool
                    -> Validate
                Validate, DifferentialArtifactReplayState.Reproduction if not differential_reproduction_artifact_valid(reproduction):
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ReproductionInvalid, "reproduction sidecar is invalid")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.Reproduction:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ManifestFingerprintMismatch, "reproduction sidecar is bound to another manifest")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate

                Validate, DifferentialArtifactReplayState.ReferenceValuePool if differential_value_pool_artifact_valid(reference_values) and reference_values.manifest_fingerprint == cursor.manifest_fingerprint and reference_values.side == DifferentialArtifactSide.Reference:
                    cursor.state <- DifferentialArtifactReplayState.CandidateValuePool
                    -> Validate
                Validate, DifferentialArtifactReplayState.ReferenceValuePool if not differential_value_pool_artifact_valid(reference_values):
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ReferenceValuePoolInvalid, "reference value-pool sidecar is invalid")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.ReferenceValuePool if reference_values.manifest_fingerprint != cursor.manifest_fingerprint:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ManifestFingerprintMismatch, "reference value-pool sidecar is bound to another manifest")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.ReferenceValuePool:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.SideMismatch, "reference value-pool sidecar has candidate side identity")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate

                Validate, DifferentialArtifactReplayState.CandidateValuePool if differential_value_pool_artifact_valid(candidate_values) and candidate_values.manifest_fingerprint == cursor.manifest_fingerprint and candidate_values.side == DifferentialArtifactSide.Candidate:
                    cursor.state <- DifferentialArtifactReplayState.Fingerprints
                    -> Validate
                Validate, DifferentialArtifactReplayState.CandidateValuePool if not differential_value_pool_artifact_valid(candidate_values):
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.CandidateValuePoolInvalid, "candidate value-pool sidecar is invalid")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.CandidateValuePool if candidate_values.manifest_fingerprint != cursor.manifest_fingerprint:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.ManifestFingerprintMismatch, "candidate value-pool sidecar is bound to another manifest")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.CandidateValuePool:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.SideMismatch, "candidate value-pool sidecar has reference side identity")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate

                Validate, DifferentialArtifactReplayState.Fingerprints if index.comparison_fingerprint == differential_comparison_artifact_fingerprint(comparison) and index.reference_process_fingerprint == differential_process_stream_artifact_fingerprint(reference_process) and index.candidate_process_fingerprint == differential_process_stream_artifact_fingerprint(candidate_process) and index.reproduction_fingerprint == differential_reproduction_artifact_fingerprint(reproduction) and index.reference_value_pool_fingerprint == differential_value_pool_artifact_fingerprint(reference_values) and index.candidate_value_pool_fingerprint == differential_value_pool_artifact_fingerprint(candidate_values):
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate
                Validate, DifferentialArtifactReplayState.Fingerprints:
                    cursor.result <- differential_artifact_replay_failure(DifferentialArtifactReplayIssue.FingerprintMismatch, "artifact index does not match one or more sidecars")
                    cursor.state <- DifferentialArtifactReplayState.Done
                    -> Validate

                Validate, DifferentialArtifactReplayState.Done:
                    break

            return cursor.result


    private:
        const DIFFERENTIAL_DEFAULT_MAX_SHRINK_CANDIDATES: usize = 64


        const enum DifferentialShrinkState of u8:
            WorldFiles
            WorldFileBytes
            WorldArguments
            WorldEnvironment
            WorldStdin
            Done


        struct DifferentialShrinkCursor:
            state: mutable DifferentialShrinkState
            index: mutable usize
            result: mutable DifferentialShrinkResult


        def differential_append_shrink_candidate(result: mutable DifferentialShrinkResult&, candidate: DifferentialCase, kind: DifferentialShrinkKind, limit: usize) -> void:
            return if result.candidates.count >= limit
            check: DifferentialCaseCheck = validate_differential_case(candidate)
            result.candidates.push(DifferentialShrinkCandidate{kind: kind, reduced_case: candidate}) if check.valid


    public:
        # Produce deterministic, bounded, validity-preserving reduction steps.
        # Candidate arrays own only their structural containers; text and runner
        # fields remain borrowed exactly like the input case. The original case
        # is never mutated, and an invalid input produces no replay candidates.
        def shrink_differential_case(case: DifferentialCase&, max_candidates: usize = DIFFERENTIAL_DEFAULT_MAX_SHRINK_CANDIDATES) -> DifferentialShrinkResult can[Memory.Allocate, Abort.Panic]:
            initial: DifferentialCaseCheck = validate_differential_case(case)
            return DifferentialShrinkResult{valid: false, candidates: []} if not initial.valid
            return DifferentialShrinkResult{valid: true, candidates: []} if max_candidates == 0
            limit: usize = max_candidates if max_candidates <= DIFFERENTIAL_DEFAULT_MAX_SHRINK_CANDIDATES else DIFFERENTIAL_DEFAULT_MAX_SHRINK_CANDIDATES
            cursor: mutable DifferentialShrinkCursor = DifferentialShrinkCursor{state: DifferentialShrinkState.WorldFiles, index: 0, result: DifferentialShrinkResult{valid: true, candidates: []}}
            machine over cursor.state:
                state Shrink
                start Shrink

                Shrink, DifferentialShrinkState.WorldFiles if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialShrinkState.Done
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldFiles if cursor.index < case.world.files.count:
                    candidate: mutable DifferentialCase = case
                    candidate.world.files <- []
                    for offset in 0..<case.world.files.count |candidate, case, cursor|:
                        if offset != cursor.index:
                            candidate.world.files.push(case.world.files[offset])
                    differential_append_shrink_candidate(cursor.result, candidate, DifferentialShrinkKind.RemoveWorldFile, limit)
                    cursor.index <- cursor.index + 1
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldFiles:
                    cursor.state <- DifferentialShrinkState.WorldFileBytes
                    cursor.index <- 0
                    -> Shrink

                Shrink, DifferentialShrinkState.WorldFileBytes if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialShrinkState.Done
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldFileBytes if cursor.index < case.world.files.count:
                    fixture: DifferentialWorldFile = case.world.files[cursor.index]
                    candidate: mutable DifferentialCase = case
                    candidate.world.files[cursor.index].bytes <- [] if fixture.kind == DifferentialWorldFileKind.Bytes and fixture.bytes.count > 0
                    differential_append_shrink_candidate(cursor.result, candidate, DifferentialShrinkKind.ClearWorldFileBytes, limit) if fixture.kind == DifferentialWorldFileKind.Bytes and fixture.bytes.count > 0
                    cursor.index <- cursor.index + 1
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldFileBytes:
                    cursor.state <- DifferentialShrinkState.WorldArguments
                    cursor.index <- 0
                    -> Shrink

                Shrink, DifferentialShrinkState.WorldArguments if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialShrinkState.Done
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldArguments if cursor.index < case.world.argv.count:
                    candidate: mutable DifferentialCase = case
                    candidate.world.argv <- []
                    for offset in 0..<case.world.argv.count |candidate, case, cursor|:
                        if offset != cursor.index:
                            candidate.world.argv.push(case.world.argv[offset])
                    differential_append_shrink_candidate(cursor.result, candidate, DifferentialShrinkKind.RemoveWorldArgument, limit)
                    cursor.index <- cursor.index + 1
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldArguments:
                    cursor.state <- DifferentialShrinkState.WorldEnvironment
                    cursor.index <- 0
                    -> Shrink

                Shrink, DifferentialShrinkState.WorldEnvironment if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialShrinkState.Done
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldEnvironment if cursor.index < case.world.environment.count:
                    candidate: mutable DifferentialCase = case
                    candidate.world.environment <- []
                    for offset in 0..<case.world.environment.count |candidate, case, cursor|:
                        if offset != cursor.index:
                            candidate.world.environment.push(case.world.environment[offset])
                    differential_append_shrink_candidate(cursor.result, candidate, DifferentialShrinkKind.RemoveWorldEnvironment, limit)
                    cursor.index <- cursor.index + 1
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldEnvironment:
                    cursor.state <- DifferentialShrinkState.WorldStdin
                    -> Shrink

                Shrink, DifferentialShrinkState.WorldStdin if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialShrinkState.Done
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldStdin if case.world.stdin != "":
                    candidate: mutable DifferentialCase = case
                    candidate.world.stdin <- ""
                    differential_append_shrink_candidate(cursor.result, candidate, DifferentialShrinkKind.ClearWorldStdin, limit)
                    cursor.state <- DifferentialShrinkState.Done
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldStdin if case.world.stdin_binary and case.world.stdin_bytes.count > 0:
                    candidate: mutable DifferentialCase = case
                    candidate.world.stdin_bytes <- []
                    differential_append_shrink_candidate(cursor.result, candidate, DifferentialShrinkKind.ClearWorldStdinBytes, limit)
                    cursor.state <- DifferentialShrinkState.Done
                    -> Shrink
                Shrink, DifferentialShrinkState.WorldStdin:
                    cursor.state <- DifferentialShrinkState.Done
                    -> Shrink

                Shrink, DifferentialShrinkState.Done:
                    break

            return cursor.result


    private:
        const enum DifferentialRunShrinkState of u8:
            ReferenceStdout
            CandidateStdout
            ReferenceStderr
            CandidateStderr
            ReferenceObservation
            CandidateObservation
            ReferenceValue
            CandidateValue
            Done


        struct DifferentialRunShrinkCursor:
            state: mutable DifferentialRunShrinkState
            index: mutable usize
            result: mutable DifferentialRunShrinkResult


        def differential_run_shrink_input_valid(run: DifferentialRun&) -> bool:
            return false if run.observations.count > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS or run.values.count > DIFFERENTIAL_DEFAULT_MAX_VALUES
            return false if not differential_value_kind_valid(run.return_value.kind)
            return false if run.return_value.kind == DifferentialValueKind.Array and not differential_array_value_range_valid(run.values, run.return_value)
            return false if run.return_value.kind == DifferentialValueKind.Map and not differential_map_value_range_valid(run.values, run.return_value)
            for value in run.values:
                return false if not differential_value_kind_valid(value.kind)
                return false if value.kind == DifferentialValueKind.Array and not differential_array_value_range_valid(run.values, value)
                return false if value.kind == DifferentialValueKind.Map and not differential_map_value_range_valid(run.values, value)
            for observation in run.observations:
                return false if not differential_value_kind_valid(observation.value.kind)
                return false if observation.value.kind == DifferentialValueKind.Array and not differential_array_value_range_valid(run.values, observation.value)
                return false if observation.value.kind == DifferentialValueKind.Map and not differential_map_value_range_valid(run.values, observation.value)
            return true


        def differential_append_run_shrink_candidate(result: mutable DifferentialRunShrinkResult&, reference: DifferentialRun, candidate: DifferentialRun, kind: DifferentialRunShrinkKind, original_kind: DifferentialDifferenceKind, limit: usize) -> void:
            return if result.candidates.count >= limit
            comparison: DifferentialComparison = compare_differential_runs(reference, candidate)
            if not comparison.equal and comparison.kind == original_kind:
                result.candidates.push(DifferentialRunShrinkCandidate{kind: kind, reference: reference, candidate: candidate})


        def differential_run_with_value_slot_cleared(run: DifferentialRun&, slot: usize) -> DifferentialRun:
            reduced: mutable DifferentialRun = run
            reduced.values <- []
            for offset in 0..<run.values.count |reduced, run|:
                value: mutable DifferentialValue = run.values[offset]
                if offset == slot and value.kind in {DifferentialValueKind.Array, DifferentialValueKind.Map}:
                    value <- DifferentialValue{kind: DifferentialValueKind.Void}
                reduced.values.push(value)
            return reduced


    public:
        # Shrink bounded run evidence without rerunning either side. A
        # candidate is retained only when the original first-difference kind
        # survives, so clearing a stream cannot accidentally turn a stdout
        # mismatch into an unrelated observation mismatch or an apparent pass.
        # Candidate order is fixed and the input runs are never mutated.
        def shrink_differential_runs(reference: DifferentialRun&, candidate: DifferentialRun&, max_candidates: usize = DIFFERENTIAL_DEFAULT_MAX_SHRINK_CANDIDATES) -> DifferentialRunShrinkResult can[Memory.Allocate, Abort.Panic]:
            return DifferentialRunShrinkResult{valid: false, original_kind: DifferentialDifferenceKind.Equal, candidates: []} if not differential_run_shrink_input_valid(reference) or not differential_run_shrink_input_valid(candidate)
            original: DifferentialComparison = compare_differential_runs(reference, candidate)
            return DifferentialRunShrinkResult{valid: true, original_kind: original.kind, candidates: []} if original.equal or max_candidates == 0
            limit: usize = max_candidates if max_candidates <= DIFFERENTIAL_DEFAULT_MAX_SHRINK_CANDIDATES else DIFFERENTIAL_DEFAULT_MAX_SHRINK_CANDIDATES
            cursor: mutable DifferentialRunShrinkCursor = DifferentialRunShrinkCursor{state: DifferentialRunShrinkState.ReferenceStdout, index: 0, result: DifferentialRunShrinkResult{valid: true, original_kind: original.kind, candidates: []}}
            machine over cursor.state:
                state Shrink
                start Shrink

                Shrink, DifferentialRunShrinkState.ReferenceStdout if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialRunShrinkState.Done
                    -> Shrink
                Shrink, DifferentialRunShrinkState.ReferenceStdout if reference.stdout != "":
                    reduced_reference: mutable DifferentialRun = reference
                    reduced_reference.stdout <- ""
                    differential_append_run_shrink_candidate(cursor.result, reduced_reference, candidate, DifferentialRunShrinkKind.ClearReferenceStdout, original.kind, limit)
                    cursor.state <- DifferentialRunShrinkState.CandidateStdout
                    -> Shrink
                Shrink, DifferentialRunShrinkState.ReferenceStdout:
                    cursor.state <- DifferentialRunShrinkState.CandidateStdout
                    -> Shrink

                Shrink, DifferentialRunShrinkState.CandidateStdout if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialRunShrinkState.Done
                    -> Shrink
                Shrink, DifferentialRunShrinkState.CandidateStdout if candidate.stdout != "":
                    reduced_candidate: mutable DifferentialRun = candidate
                    reduced_candidate.stdout <- ""
                    differential_append_run_shrink_candidate(cursor.result, reference, reduced_candidate, DifferentialRunShrinkKind.ClearCandidateStdout, original.kind, limit)
                    cursor.state <- DifferentialRunShrinkState.ReferenceStderr
                    -> Shrink
                Shrink, DifferentialRunShrinkState.CandidateStdout:
                    cursor.state <- DifferentialRunShrinkState.ReferenceStderr
                    -> Shrink

                Shrink, DifferentialRunShrinkState.ReferenceStderr if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialRunShrinkState.Done
                    -> Shrink
                Shrink, DifferentialRunShrinkState.ReferenceStderr if reference.stderr != "":
                    reduced_reference: mutable DifferentialRun = reference
                    reduced_reference.stderr <- ""
                    differential_append_run_shrink_candidate(cursor.result, reduced_reference, candidate, DifferentialRunShrinkKind.ClearReferenceStderr, original.kind, limit)
                    cursor.state <- DifferentialRunShrinkState.CandidateStderr
                    -> Shrink
                Shrink, DifferentialRunShrinkState.ReferenceStderr:
                    cursor.state <- DifferentialRunShrinkState.CandidateStderr
                    -> Shrink

                Shrink, DifferentialRunShrinkState.CandidateStderr if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialRunShrinkState.Done
                    -> Shrink
                Shrink, DifferentialRunShrinkState.CandidateStderr if candidate.stderr != "":
                    reduced_candidate: mutable DifferentialRun = candidate
                    reduced_candidate.stderr <- ""
                    differential_append_run_shrink_candidate(cursor.result, reference, reduced_candidate, DifferentialRunShrinkKind.ClearCandidateStderr, original.kind, limit)
                    cursor.state <- DifferentialRunShrinkState.ReferenceObservation
                    -> Shrink
                Shrink, DifferentialRunShrinkState.CandidateStderr:
                    cursor.state <- DifferentialRunShrinkState.ReferenceObservation
                    -> Shrink

                Shrink, DifferentialRunShrinkState.ReferenceObservation if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialRunShrinkState.Done
                    -> Shrink
                Shrink, DifferentialRunShrinkState.ReferenceObservation if cursor.index < reference.observations.count:
                    reduced_reference: mutable DifferentialRun = reference
                    reduced_reference.observations <- []
                    for offset in 0..<reference.observations.count |reduced_reference, reference, cursor|:
                        if offset != cursor.index:
                            reduced_reference.observations.push(reference.observations[offset])
                    differential_append_run_shrink_candidate(cursor.result, reduced_reference, candidate, DifferentialRunShrinkKind.RemoveReferenceObservation, original.kind, limit)
                    cursor.index <- cursor.index + 1
                    -> Shrink
                Shrink, DifferentialRunShrinkState.ReferenceObservation:
                    cursor.state <- DifferentialRunShrinkState.CandidateObservation
                    cursor.index <- 0
                    -> Shrink

                Shrink, DifferentialRunShrinkState.CandidateObservation if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialRunShrinkState.Done
                    -> Shrink
                Shrink, DifferentialRunShrinkState.CandidateObservation if cursor.index < candidate.observations.count:
                    reduced_candidate: mutable DifferentialRun = candidate
                    reduced_candidate.observations <- []
                    for offset in 0..<candidate.observations.count |reduced_candidate, candidate, cursor|:
                        if offset != cursor.index:
                            reduced_candidate.observations.push(candidate.observations[offset])
                    differential_append_run_shrink_candidate(cursor.result, reference, reduced_candidate, DifferentialRunShrinkKind.RemoveCandidateObservation, original.kind, limit)
                    cursor.index <- cursor.index + 1
                    -> Shrink
                Shrink, DifferentialRunShrinkState.CandidateObservation:
                    cursor.state <- DifferentialRunShrinkState.ReferenceValue
                    cursor.index <- 0
                    -> Shrink

                Shrink, DifferentialRunShrinkState.ReferenceValue if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialRunShrinkState.Done
                    -> Shrink
                Shrink, DifferentialRunShrinkState.ReferenceValue if cursor.index < reference.values.count:
                    value: DifferentialValue = reference.values[cursor.index]
                    if value.kind in {DifferentialValueKind.Array, DifferentialValueKind.Map}:
                        reduced_reference: DifferentialRun = differential_run_with_value_slot_cleared(reference, cursor.index)
                        differential_append_run_shrink_candidate(cursor.result, reduced_reference, candidate, DifferentialRunShrinkKind.ClearReferenceValueSlot, original.kind, limit)
                    cursor.index <- cursor.index + 1
                    -> Shrink
                Shrink, DifferentialRunShrinkState.ReferenceValue:
                    cursor.state <- DifferentialRunShrinkState.CandidateValue
                    cursor.index <- 0
                    -> Shrink

                Shrink, DifferentialRunShrinkState.CandidateValue if cursor.result.candidates.count >= limit:
                    cursor.state <- DifferentialRunShrinkState.Done
                    -> Shrink
                Shrink, DifferentialRunShrinkState.CandidateValue if cursor.index < candidate.values.count:
                    value: DifferentialValue = candidate.values[cursor.index]
                    if value.kind in {DifferentialValueKind.Array, DifferentialValueKind.Map}:
                        reduced_candidate: DifferentialRun = differential_run_with_value_slot_cleared(candidate, cursor.index)
                        differential_append_run_shrink_candidate(cursor.result, reference, reduced_candidate, DifferentialRunShrinkKind.ClearCandidateValueSlot, original.kind, limit)
                    cursor.index <- cursor.index + 1
                    -> Shrink
                Shrink, DifferentialRunShrinkState.CandidateValue:
                    cursor.state <- DifferentialRunShrinkState.Done
                    -> Shrink

                Shrink, DifferentialRunShrinkState.Done:
                    break

            return cursor.result


    private:
        def differential_oracle_language_valid(language: DifferentialOracleLanguage) -> bool:
            return language in {DifferentialOracleLanguage.Python, DifferentialOracleLanguage.Perl, DifferentialOracleLanguage.Awk, DifferentialOracleLanguage.Shell, DifferentialOracleLanguage.C, DifferentialOracleLanguage.Cpp, DifferentialOracleLanguage.Native}


        def differential_oracle_runner_independent(language: DifferentialOracleLanguage, kind: DifferentialRunnerKind) -> bool:
            return kind == DifferentialRunnerKind.PythonAdapter if language == DifferentialOracleLanguage.Python
            return kind == DifferentialRunnerKind.NativeProcess if language == DifferentialOracleLanguage.Perl or language == DifferentialOracleLanguage.Awk or language == DifferentialOracleLanguage.Shell
            return kind == DifferentialRunnerKind.NativeProcess or kind == DifferentialRunnerKind.CAbiFunction if language == DifferentialOracleLanguage.C or language == DifferentialOracleLanguage.Cpp
            return kind == DifferentialRunnerKind.NativeProcess or kind == DifferentialRunnerKind.CAbiFunction or kind == DifferentialRunnerKind.WasmModule or kind == DifferentialRunnerKind.Service


        const enum DifferentialOracleCheckState of u8:
            Name
            Language
            Version
            Runner
            Independence
            Done


        struct DifferentialOracleCheckCursor:
            state: mutable DifferentialOracleCheckState
            result: mutable DifferentialOracleCheck


        def differential_oracle_failure(issue: DifferentialOracleIssue, reason: sview) -> DifferentialOracleCheck:
            return DifferentialOracleCheck{valid: false, issue: issue, reason: reason}


        def differential_oracle_name_valid(value: sview) -> bool:
            return false if sview_len(value) == 0 or sview_len(value) > DIFFERENTIAL_DEFAULT_MAX_WORLD_METADATA_BYTES
            return not differential_sview_has_nul(value)


    public:
        # Validate an independent reference without conflating its language or
        # process adapter with the Elisascript candidate. The external adapter
        # still uses the same typed argv/cwd/environment contract as any runner.
        def validate_differential_oracle(oracle: DifferentialOracle&) -> DifferentialOracleCheck:
            cursor: mutable DifferentialOracleCheckCursor = DifferentialOracleCheckCursor{state: DifferentialOracleCheckState.Name, result: DifferentialOracleCheck{valid: true, issue: DifferentialOracleIssue.None}}
            machine over cursor.state:
                state Validate
                start Validate

                Validate, DifferentialOracleCheckState.Name if differential_oracle_name_valid(oracle.name):
                    cursor.state <- DifferentialOracleCheckState.Language
                    -> Validate
                Validate, DifferentialOracleCheckState.Name:
                    cursor.result <- differential_oracle_failure(DifferentialOracleIssue.MissingName, "oracle name is required and must not contain NUL")
                    cursor.state <- DifferentialOracleCheckState.Done
                    -> Validate

                Validate, DifferentialOracleCheckState.Language if differential_oracle_language_valid(oracle.language):
                    cursor.state <- DifferentialOracleCheckState.Version
                    -> Validate
                Validate, DifferentialOracleCheckState.Language:
                    cursor.result <- differential_oracle_failure(DifferentialOracleIssue.InvalidLanguage, "oracle language ordinal is unknown")
                    cursor.state <- DifferentialOracleCheckState.Done
                    -> Validate

                Validate, DifferentialOracleCheckState.Version if sview_len(oracle.version) <= 128 and not differential_sview_has_nul(oracle.version):
                    cursor.state <- DifferentialOracleCheckState.Runner
                    -> Validate
                Validate, DifferentialOracleCheckState.Version:
                    cursor.result <- differential_oracle_failure(DifferentialOracleIssue.InvalidVersion, "oracle version is oversized or contains NUL")
                    cursor.state <- DifferentialOracleCheckState.Done
                    -> Validate

                Validate, DifferentialOracleCheckState.Runner if validate_differential_runner(oracle.runner).valid:
                    cursor.state <- DifferentialOracleCheckState.Independence
                    -> Validate
                Validate, DifferentialOracleCheckState.Runner:
                    cursor.result <- differential_oracle_failure(DifferentialOracleIssue.InvalidRunner, "oracle runner is invalid")
                    cursor.state <- DifferentialOracleCheckState.Done
                    -> Validate

                Validate, DifferentialOracleCheckState.Independence if differential_oracle_runner_independent(oracle.language, oracle.runner.kind):
                    cursor.state <- DifferentialOracleCheckState.Done
                    -> Validate
                Validate, DifferentialOracleCheckState.Independence:
                    cursor.result <- differential_oracle_failure(DifferentialOracleIssue.NotIndependent, "oracle runner does not match its independent source language")
                    cursor.state <- DifferentialOracleCheckState.Done
                    -> Validate

                Validate, DifferentialOracleCheckState.Done:
                    break

            return cursor.result


        def make_differential_oracle(language: DifferentialOracleLanguage, name: sview, runner: DifferentialRunner, version: sview = "") -> DifferentialOracle error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            oracle: DifferentialOracle = DifferentialOracle{name: name, language: language, runner: runner, version: version}
            raise DifferentialRunnerError.Invalid if not validate_differential_oracle(oracle).valid
            return oracle


    private:
        def differential_world_snapshot_valid(snapshot: DifferentialWorldSnapshot&) -> bool:
            return false if snapshot.format_version != 1 or snapshot.world_fingerprint == 0
            return false if differential_world_issue(snapshot.world) != DifferentialCaseIssueKind.None
            return differential_world_fingerprint(snapshot.world) == snapshot.world_fingerprint


        const enum DifferentialWorldSnapshotState of u8:
            World
            Snapshot
            Fingerprint
            Done


        struct DifferentialWorldSnapshotCursor:
            state: mutable DifferentialWorldSnapshotState
            result: mutable DifferentialWorldSnapshotCheck


        def differential_world_snapshot_failure(issue: DifferentialWorldSnapshotIssue, reason: sview) -> DifferentialWorldSnapshotCheck:
            return DifferentialWorldSnapshotCheck{valid: false, issue: issue, reason: reason}


    public:
        # Capture a deterministic identity for a validated hermetic world. The
        # snapshot retains the typed fixture/environment vectors so a host
        # materializer can later restore the same contract without rebuilding a
        # shell command or relying on ambient process state.
        def make_differential_world_snapshot(world: DifferentialWorld&) -> DifferentialWorldSnapshot error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialRunnerError.Invalid if differential_world_issue(world) != DifferentialCaseIssueKind.None
            fingerprint: u64 = differential_world_fingerprint(world)
            raise DifferentialRunnerError.Invalid if fingerprint == 0
            return DifferentialWorldSnapshot{world_fingerprint: fingerprint, world: world}


        # Verify both the stored snapshot and the post-run world before a case
        # is compared or replayed. A changed fixture, environment, argv, stdin,
        # locale, timezone, or seed is a typed contamination failure.
        def validate_differential_world_snapshot(world: DifferentialWorld&, snapshot: DifferentialWorldSnapshot&) -> DifferentialWorldSnapshotCheck:
            cursor: mutable DifferentialWorldSnapshotCursor = DifferentialWorldSnapshotCursor{state: DifferentialWorldSnapshotState.World, result: DifferentialWorldSnapshotCheck{valid: true, issue: DifferentialWorldSnapshotIssue.None}}
            machine over cursor.state:
                state Validate
                start Validate

                Validate, DifferentialWorldSnapshotState.World if differential_world_issue(world) == DifferentialCaseIssueKind.None:
                    cursor.state <- DifferentialWorldSnapshotState.Snapshot
                    -> Validate
                Validate, DifferentialWorldSnapshotState.World:
                    cursor.result <- differential_world_snapshot_failure(DifferentialWorldSnapshotIssue.InvalidWorld, "restored differential world is invalid")
                    cursor.state <- DifferentialWorldSnapshotState.Done
                    -> Validate

                Validate, DifferentialWorldSnapshotState.Snapshot if differential_world_snapshot_valid(snapshot):
                    cursor.state <- DifferentialWorldSnapshotState.Fingerprint
                    -> Validate
                Validate, DifferentialWorldSnapshotState.Snapshot:
                    cursor.result <- differential_world_snapshot_failure(DifferentialWorldSnapshotIssue.InvalidSnapshot, "differential world snapshot is invalid")
                    cursor.state <- DifferentialWorldSnapshotState.Done
                    -> Validate

                Validate, DifferentialWorldSnapshotState.Fingerprint if differential_world_fingerprint(world) == snapshot.world_fingerprint:
                    cursor.state <- DifferentialWorldSnapshotState.Done
                    -> Validate
                Validate, DifferentialWorldSnapshotState.Fingerprint:
                    cursor.result <- differential_world_snapshot_failure(DifferentialWorldSnapshotIssue.FingerprintMismatch, "restored differential world differs from its snapshot")
                    cursor.state <- DifferentialWorldSnapshotState.Done
                    -> Validate

                Validate, DifferentialWorldSnapshotState.Done:
                    break

            return cursor.result


    private:
        const DIFFERENTIAL_MAX_WORLD_MATERIALIZATION_ROOT_BYTES: usize = 4096


        def differential_world_materialization_state_valid(state: DifferentialWorldMaterializationState) -> bool:
            return state in {DifferentialWorldMaterializationState.Planned, DifferentialWorldMaterializationState.Materializing, DifferentialWorldMaterializationState.Materialized, DifferentialWorldMaterializationState.Running, DifferentialWorldMaterializationState.Restoring, DifferentialWorldMaterializationState.Restored}


        # Materializers receive absolute roots so neither side can accidentally
        # inherit the adapter's ambient cwd. Empty, dot, parent, repeated, and
        # trailing path components are rejected before mkdir or fixture writes.
        def differential_world_materialization_root_valid(root: sview) -> bool:
            length: usize = sview_len(root)
            return false if length < 2 or length > DIFFERENTIAL_MAX_WORLD_MATERIALIZATION_ROOT_BYTES or differential_sview_has_nul(root) or sview_at(root, 0) != 47
            segment_start: mutable usize = 1
            index: mutable usize = 1
            while index < length:
                if sview_at(root, index) == 47:
                    return false if not differential_world_path_segment_safe(root, segment_start, index)
                    segment_start <- index + 1
                index <- index + 1
            return differential_world_path_segment_safe(root, segment_start, length)


        # Roots are already normalized by root_valid. Require a path-component
        # boundary so sibling names such as /tmp/run and /tmp/run-2 stay legal.
        def differential_world_materialization_root_contains(parent: sview, child: sview) -> bool:
            parent_length: usize = sview_len(parent)
            return false if sview_len(child) <= parent_length
            return child[0:parent_length] == parent and sview_at(child, parent_length) == 47


        def differential_world_materialization_plan_valid(plan: DifferentialWorldMaterializationPlan&) -> bool:
            return false if plan.format_version != 1 or plan.snapshot_fingerprint == 0 or not differential_world_materialization_state_valid(plan.state)
            return false if not differential_world_materialization_root_valid(plan.reference_root) or not differential_world_materialization_root_valid(plan.candidate_root)
            return false if plan.reference_root == plan.candidate_root
            return false if differential_world_materialization_root_contains(plan.reference_root, plan.candidate_root)
            return false if differential_world_materialization_root_contains(plan.candidate_root, plan.reference_root)
            return false if plan.state == DifferentialWorldMaterializationState.Planned and (plan.has_materialization_attempt or plan.has_reference_restoration or plan.has_candidate_restoration or plan.reference_restored_world_fingerprint != 0 or plan.candidate_restored_world_fingerprint != 0)
            return false if plan.state != DifferentialWorldMaterializationState.Planned and not plan.has_materialization_attempt
            return false if plan.state == DifferentialWorldMaterializationState.Restored and (not plan.has_reference_restoration or not plan.has_candidate_restoration)
            return false if plan.state != DifferentialWorldMaterializationState.Restored and (plan.has_reference_restoration or plan.has_candidate_restoration or plan.reference_restored_world_fingerprint != 0 or plan.candidate_restored_world_fingerprint != 0)
            return false if plan.has_reference_restoration and plan.reference_restored_world_fingerprint != plan.snapshot_fingerprint
            return false if plan.has_candidate_restoration and plan.candidate_restored_world_fingerprint != plan.snapshot_fingerprint
            return true


        def differential_world_materialization_failure(issue: DifferentialWorldMaterializationIssue, reason: sview) -> DifferentialWorldMaterializationCheck:
            return DifferentialWorldMaterializationCheck{valid: false, issue: issue, reason: reason}


        def differential_world_materialization_transition_allowed(current: DifferentialWorldMaterializationState, next: DifferentialWorldMaterializationState) -> bool:
            match current:
                DifferentialWorldMaterializationState.Planned:
                    return next == DifferentialWorldMaterializationState.Materializing
                DifferentialWorldMaterializationState.Materializing:
                    return next == DifferentialWorldMaterializationState.Materialized or next == DifferentialWorldMaterializationState.Restoring
                DifferentialWorldMaterializationState.Materialized:
                    return next == DifferentialWorldMaterializationState.Running or next == DifferentialWorldMaterializationState.Restoring
                DifferentialWorldMaterializationState.Running:
                    return next == DifferentialWorldMaterializationState.Restoring
                DifferentialWorldMaterializationState.Restoring:
                    return false
                DifferentialWorldMaterializationState.Restored:
                    return false
                _:
                    return false


        const enum DifferentialWorldMaterializationCheckState of u8:
            Plan
            Snapshot
            Binding
            Done


        struct DifferentialWorldMaterializationCheckCursor:
            state: mutable DifferentialWorldMaterializationCheckState
            result: mutable DifferentialWorldMaterializationCheck


    public:
        # Describe the two isolated roots that a host adapter must prepare for
        # one snapshot. Construction is identity-only; it never creates or
        # removes a directory and therefore remains safe for compiler-free
        # admission and replay planning.
        def make_differential_world_materialization_plan(snapshot: DifferentialWorldSnapshot&, reference_root: sview, candidate_root: sview) -> DifferentialWorldMaterializationPlan error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialRunnerError.Invalid if not differential_world_snapshot_valid(snapshot)
            plan: DifferentialWorldMaterializationPlan = DifferentialWorldMaterializationPlan{snapshot_fingerprint: snapshot.world_fingerprint, reference_root: reference_root, candidate_root: candidate_root}
            raise DifferentialRunnerError.Invalid if not differential_world_materialization_plan_valid(plan)
            return plan


        # Validate the lifecycle identity before an adapter performs any host
        # operation. A changed world or cross-boundary root is rejected without
        # mutating the plan.
        def validate_differential_world_materialization(plan: DifferentialWorldMaterializationPlan&, snapshot: DifferentialWorldSnapshot&, world: DifferentialWorld&) -> DifferentialWorldMaterializationCheck:
            cursor: mutable DifferentialWorldMaterializationCheckCursor = DifferentialWorldMaterializationCheckCursor{state: DifferentialWorldMaterializationCheckState.Plan, result: DifferentialWorldMaterializationCheck{valid: true, issue: DifferentialWorldMaterializationIssue.None}}
            machine over cursor.state:
                state Validate
                start Validate

                Validate, DifferentialWorldMaterializationCheckState.Plan if differential_world_materialization_plan_valid(plan):
                    cursor.state <- DifferentialWorldMaterializationCheckState.Snapshot
                    -> Validate
                Validate, DifferentialWorldMaterializationCheckState.Plan:
                    cursor.result <- differential_world_materialization_failure(DifferentialWorldMaterializationIssue.InvalidPlan, "world materialization plan is invalid")
                    cursor.state <- DifferentialWorldMaterializationCheckState.Done
                    -> Validate

                Validate, DifferentialWorldMaterializationCheckState.Snapshot if validate_differential_world_snapshot(world, snapshot).valid:
                    cursor.state <- DifferentialWorldMaterializationCheckState.Binding
                    -> Validate
                Validate, DifferentialWorldMaterializationCheckState.Snapshot:
                    cursor.result <- differential_world_materialization_failure(DifferentialWorldMaterializationIssue.InvalidSnapshot, "world snapshot is invalid")
                    cursor.state <- DifferentialWorldMaterializationCheckState.Done
                    -> Validate

                Validate, DifferentialWorldMaterializationCheckState.Binding if plan.snapshot_fingerprint == snapshot.world_fingerprint:
                    cursor.state <- DifferentialWorldMaterializationCheckState.Done
                    -> Validate
                Validate, DifferentialWorldMaterializationCheckState.Binding:
                    cursor.result <- differential_world_materialization_failure(DifferentialWorldMaterializationIssue.SnapshotFingerprintMismatch, "materialization plan does not match the world snapshot")
                    cursor.state <- DifferentialWorldMaterializationCheckState.Done
                    -> Validate

                Validate, DifferentialWorldMaterializationCheckState.Done:
                    break

            return cursor.result


        # Advance one materialization/cleanup edge. The host adapter performs
        # mkdir/write/chdir/restore operations around these declarations; this
        # function never marks restoration complete and never performs I/O.
        def advance_differential_world_materialization(plan: mutable DifferentialWorldMaterializationPlan&, next_state: DifferentialWorldMaterializationState) -> DifferentialWorldMaterializationCheck:
            return differential_world_materialization_failure(DifferentialWorldMaterializationIssue.InvalidPlan, "world materialization plan is invalid") if not differential_world_materialization_plan_valid(plan)
            valid_edge: bool = differential_world_materialization_transition_allowed(plan.state, next_state)
            return differential_world_materialization_failure(DifferentialWorldMaterializationIssue.InvalidTransition, "world materialization transition is not a single lifecycle edge") if not valid_edge
            plan.has_materialization_attempt <- true if next_state == DifferentialWorldMaterializationState.Materializing
            plan.state <- next_state
            return DifferentialWorldMaterializationCheck{valid: true, issue: DifferentialWorldMaterializationIssue.None}


        # A host may report Restored only after proving both isolated worlds
        # match the original snapshot. Rejected restores remain in cleanup.
        def complete_differential_world_restoration(plan: mutable DifferentialWorldMaterializationPlan&, snapshot: DifferentialWorldSnapshot&, reference_restored_world: DifferentialWorld&, candidate_restored_world: DifferentialWorld&) -> DifferentialWorldMaterializationCheck:
            return differential_world_materialization_failure(DifferentialWorldMaterializationIssue.InvalidPlan, "world materialization plan is invalid") if not differential_world_materialization_plan_valid(plan)
            return differential_world_materialization_failure(DifferentialWorldMaterializationIssue.InvalidTransition, "world restoration is not pending") if plan.state != DifferentialWorldMaterializationState.Restoring
            reference_restored: DifferentialWorldMaterializationCheck = validate_differential_world_materialization(plan, snapshot, reference_restored_world)
            return reference_restored if not reference_restored.valid
            candidate_restored: DifferentialWorldMaterializationCheck = validate_differential_world_materialization(plan, snapshot, candidate_restored_world)
            return candidate_restored if not candidate_restored.valid
            plan.reference_restored_world_fingerprint <- differential_world_fingerprint(reference_restored_world)
            plan.candidate_restored_world_fingerprint <- differential_world_fingerprint(candidate_restored_world)
            plan.has_reference_restoration <- true
            plan.has_candidate_restoration <- true
            plan.state <- DifferentialWorldMaterializationState.Restored
            return DifferentialWorldMaterializationCheck{valid: true, issue: DifferentialWorldMaterializationIssue.None}


    private:
        def differential_case_replay_manifest_matches(case: DifferentialCase&, manifest: DifferentialArtifactManifest&) -> bool error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            return false if manifest.format_version != 5 or not differential_artifact_manifest_valid(manifest)
            expected: DifferentialArtifactManifest = make_differential_artifact_manifest(case, manifest.module_fingerprint, manifest.module_digest_0, manifest.module_digest_1, manifest.module_digest_2, manifest.module_digest_3, manifest.module_digest_present)
            expected_bytes: darray[u8] = canonical_differential_artifact_manifest_bytes(expected)
            actual_bytes: darray[u8] = canonical_differential_artifact_manifest_bytes(manifest)
            return false if expected_bytes.count == 0 or expected_bytes.count != actual_bytes.count
            for index in 0..<expected_bytes.count |expected_bytes, actual_bytes|:
                return false if expected_bytes[index] != actual_bytes[index]
            return true


        def differential_case_replay_hash_u32(hash: u64, value: u32) -> u64:
            result: mutable u64 = hash
            for shift in 0..<4 |result, value|:
                result <- EsIr::canonical_artifact_hash_byte(result, (value.u64() >> (shift * 8)).u8())
            return result


        def differential_case_replay_hash_value(hash: u64, value: DifferentialValue) -> u64 can[Unsafe.PointerCast]:
            result: mutable u64 = EsIr::canonical_artifact_hash_byte(hash, value.kind.u8())
            result <- EsIr::canonical_artifact_hash_byte(result, 1 if value.boolean else 0)
            result <- differential_world_hash_u64(result, value.integer.u64())
            result <- differential_world_hash_u64(result, differential_float_bits(value.decimal))
            result <- differential_world_hash_u64(result, value.process_exit_status.u64())
            result <- differential_world_hash_text(result, value.text)
            result <- differential_world_hash_text(result, value.process_stdout)
            result <- differential_world_hash_text(result, value.process_stderr)
            result <- differential_case_replay_hash_u32(result, value.array_start)
            result <- differential_case_replay_hash_u32(result, value.array_count)
            result <- differential_case_replay_hash_u32(result, value.map_start)
            result <- differential_case_replay_hash_u32(result, value.map_count)
            return result


        def differential_case_replay_value_encoded_size(value: DifferentialValue) -> usize:
            return 66 + sview_len(value.text) + sview_len(value.process_stdout) + sview_len(value.process_stderr)


        def differential_case_replay_run_fingerprint(manifest: DifferentialArtifactManifest&, side: DifferentialArtifactSide, run: DifferentialRun&) -> u64 can[Unsafe.PointerCast]:
            return 0 if not differential_artifact_manifest_valid(manifest) or not differential_artifact_side_valid(side) or not differential_run_outcome_valid(run.outcome)
            return 0 if not differential_execution_engine_valid(run.engine)
            return 0 if not differential_engine_metadata_valid(run)
            manifest_fingerprint: u64 = differential_artifact_manifest_fingerprint(manifest)
            return 0 if manifest_fingerprint == 0
            process: DifferentialProcessStreamArtifact = DifferentialProcessStreamArtifact{manifest_fingerprint: manifest_fingerprint, side: side, outcome: run.outcome, exit_status: run.exit_status, error_text: run.error_text, stdout: run.stdout, stderr: run.stderr}
            return 0 if not differential_process_stream_artifact_text_bytes_fits(process)
            values: DifferentialValuePoolArtifact = DifferentialValuePoolArtifact{manifest_fingerprint: manifest_fingerprint, side: side, outcome: run.outcome, exit_status: run.exit_status, root_value: run.return_value, values: run.values, observations: run.observations}
            return 0 if not differential_value_pool_artifact_valid(values)
            encoded_value_bytes: mutable usize = 39
            next_size: mutable usize = differential_case_replay_value_encoded_size(values.root_value)
            return 0 if next_size > DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_BYTES - encoded_value_bytes
            encoded_value_bytes <- encoded_value_bytes + next_size
            for value in values.values |encoded_value_bytes|:
                next_size <- differential_case_replay_value_encoded_size(value)
                return 0 if next_size > DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_BYTES - encoded_value_bytes
                encoded_value_bytes <- encoded_value_bytes + next_size
            for observation in values.observations |encoded_value_bytes|:
                return 0 if 8 > DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_BYTES - encoded_value_bytes
                encoded_value_bytes <- encoded_value_bytes + 8
                next_size <- differential_case_replay_value_encoded_size(observation.value)
                return 0 if next_size > DIFFERENTIAL_MAX_VALUE_POOL_ARTIFACT_BYTES - encoded_value_bytes
                encoded_value_bytes <- encoded_value_bytes + next_size
            fingerprint: mutable u64 = 14695981039346656037
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 69)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 83)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 80)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 83)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 1)
            fingerprint <- differential_world_hash_u64(fingerprint, manifest_fingerprint)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, side.u8())
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, run.outcome.u8())
            fingerprint <- differential_world_hash_u64(fingerprint, run.exit_status.u64())
            fingerprint <- differential_world_hash_text(fingerprint, run.error_text)
            fingerprint <- differential_world_hash_text(fingerprint, run.stdout)
            fingerprint <- differential_world_hash_text(fingerprint, run.stderr)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 69)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 83)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 86)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 80)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 1)
            fingerprint <- differential_world_hash_u64(fingerprint, manifest_fingerprint)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, side.u8())
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, run.outcome.u8())
            fingerprint <- differential_world_hash_u64(fingerprint, run.exit_status.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, values.values.count.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, values.observations.count.u64())
            fingerprint <- differential_case_replay_hash_value(fingerprint, values.root_value)
            for value in values.values |fingerprint|:
                fingerprint <- differential_case_replay_hash_value(fingerprint, value)
            for observation in values.observations |fingerprint|:
                fingerprint <- differential_world_hash_u64(fingerprint, observation.trace)
                fingerprint <- differential_case_replay_hash_value(fingerprint, observation.value)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 1 if run.engine_known else 0)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, run.engine.u8())
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 1 if run.capability_known else 0)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 1 if run.capability.direct_supported else 0)
            fingerprint <- differential_world_hash_u64(fingerprint, run.capability.function_count)
            fingerprint <- differential_world_hash_u64(fingerprint, run.capability.instruction_count)
            fingerprint <- differential_world_hash_u64(fingerprint, run.capability.global_count)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 1 if run.resource_policy_known else 0)
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_policy.steps)
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_policy.elapsed_micros)
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_policy.memory_bytes.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_policy.open_handles.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_policy.processes.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_policy.output_bytes.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_policy.regex_work)
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_policy.retained_traces.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_policy.concurrent_tasks.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_usage.steps)
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_usage.elapsed_micros)
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_usage.memory_bytes.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_usage.open_handles.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_usage.processes.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_usage.output_bytes.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_usage.regex_work)
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_usage.retained_traces.u64())
            fingerprint <- differential_world_hash_u64(fingerprint, run.resource_usage.concurrent_tasks.u64())
            return fingerprint


        def differential_runner_configuration_fingerprint(runner: DifferentialRunner&) -> u64:
            handler_module: EsIr::Module = EsIr::Module{name: "differential-runner-handlers", functions: [], handlers: runner.handlers}
            handler_fingerprint: u64 = EsIr::module_fingerprint(handler_module)
            return 0 if handler_fingerprint == 0
            fingerprint: mutable u64 = 14695981039346656037
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, runner.kind.u8())
            fingerprint <- differential_world_hash_text(fingerprint, runner.name)
            fingerprint <- differential_world_hash_text(fingerprint, runner.target)
            fingerprint <- differential_world_hash_text(fingerprint, runner.entry)
            fingerprint <- differential_world_hash_u64(fingerprint, runner.arguments.count.u64())
            for argument in runner.arguments |fingerprint|:
                fingerprint <- differential_world_hash_text(fingerprint, argument)
            fingerprint <- differential_world_hash_text(fingerprint, runner.working_directory)
            fingerprint <- differential_world_hash_u64(fingerprint, runner.environment.count.u64())
            for entry in runner.environment |fingerprint|:
                fingerprint <- differential_world_hash_text(fingerprint, entry.name)
                fingerprint <- differential_world_hash_text(fingerprint, entry.value)
            fingerprint <- differential_world_hash_text(fingerprint, runner.stdin)
            fingerprint <- differential_world_hash_bytes(fingerprint, runner.stdin_bytes)
            fingerprint <- EsIr::canonical_artifact_hash_byte(fingerprint, 1 if runner.stdin_binary else 0)
            fingerprint <- differential_world_hash_text(fingerprint, runner.protocol)
            fingerprint <- differential_world_hash_u64(fingerprint, runner.timeout_steps)
            fingerprint <- differential_world_hash_u64(fingerprint, runner.max_output_bytes)
            fingerprint <- differential_world_hash_u64(fingerprint, runner.required_effects.count.u64())
            for effect in runner.required_effects |fingerprint|:
                fingerprint <- differential_world_hash_text(fingerprint, effect)
            fingerprint <- differential_world_hash_u64(fingerprint, runner.required_errors.count.u64())
            for error_name in runner.required_errors |fingerprint|:
                fingerprint <- differential_world_hash_text(fingerprint, error_name)
            fingerprint <- differential_world_hash_u64(fingerprint, handler_fingerprint)
            return fingerprint


        def differential_case_replay_copy_root_binding(root: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            binding: mutable darray[u8] = []
            for byte in root |binding|:
                binding.push(byte)
            return binding


        def differential_case_replay_root_binding_matches(root: sview, binding: darray[u8]&) -> bool:
            return false if sview_len(root) != binding.count
            for index in 0..<binding.count |root, binding|:
                return false if sview_at(root, index) != binding[index]
            return true


        def differential_case_replay_components_synchronized(session: DifferentialCaseReplaySession&) -> bool error[EsDifferentialReplay::DifferentialReplayError]:
            try EsDifferentialReplay::validate_differential_replay_session(session.replay)
            return false if not differential_world_materialization_plan_valid(session.materialization)
            return false if session.materialization.snapshot_fingerprint != session.world_snapshot.world_fingerprint
            return false if session.has_reference_run != session.replay.has_reference or session.has_candidate_run != session.replay.has_candidate or session.has_comparison != session.replay.has_comparison
            return false if session.has_reference_run != (session.reference_run_fingerprint != 0) or session.has_candidate_run != (session.candidate_run_fingerprint != 0)
            return false if session.has_reference_run and session.reference_run_fingerprint != session.replay.reference_run_fingerprint
            return false if session.has_candidate_run and session.candidate_run_fingerprint != session.replay.candidate_run_fingerprint
            match session.replay.state:
                EsDifferentialReplay::DifferentialReplayState.Planned:
                    return false if session.materialization.state != DifferentialWorldMaterializationState.Planned
                EsDifferentialReplay::DifferentialReplayState.Admitted:
                    return false if session.materialization.state != DifferentialWorldMaterializationState.Planned
                EsDifferentialReplay::DifferentialReplayState.Materializing:
                    return false if session.materialization.state != DifferentialWorldMaterializationState.Materializing
                EsDifferentialReplay::DifferentialReplayState.Running:
                    return false if session.materialization.state != DifferentialWorldMaterializationState.Running
                EsDifferentialReplay::DifferentialReplayState.Comparing:
                    return false if session.materialization.state != DifferentialWorldMaterializationState.Running
                EsDifferentialReplay::DifferentialReplayState.Restoring:
                    return false if session.materialization.state != DifferentialWorldMaterializationState.Restoring
                EsDifferentialReplay::DifferentialReplayState.Completed:
                    return false if session.materialization.state != DifferentialWorldMaterializationState.Restored
                EsDifferentialReplay::DifferentialReplayState.Failed:
                    return false if session.replay.has_materialization_attempt and (session.materialization.state != DifferentialWorldMaterializationState.Restored or not session.replay.has_restoration)
                    return false if not session.replay.has_materialization_attempt and session.materialization.state != DifferentialWorldMaterializationState.Planned
                EsDifferentialReplay::DifferentialReplayState.Cancelled:
                    return false if session.replay.has_materialization_attempt and (session.materialization.state != DifferentialWorldMaterializationState.Restored or not session.replay.has_restoration)
                    return false if not session.replay.has_materialization_attempt and session.materialization.state != DifferentialWorldMaterializationState.Planned
                _:
                    return false
            return true


        def differential_case_replay_session_valid(case: DifferentialCase&, session: DifferentialCaseReplaySession&) -> bool error[DifferentialRunnerError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if session.format_version != 1
            return false if not differential_case_replay_manifest_matches(case, session.manifest)
            return false if not validate_differential_world_snapshot(case.world, session.world_snapshot).valid
            return false if session.replay.expected_manifest_fingerprint != differential_artifact_manifest_fingerprint(session.manifest)
            return false if session.replay.expected_world_fingerprint != session.world_snapshot.world_fingerprint
            return false if session.case_timeout_steps != case.timeout_steps or session.case_max_output_bytes != case.max_output_bytes
            return false if session.reference_runner_fingerprint == 0 or session.candidate_runner_fingerprint == 0
            return false if session.reference_runner_fingerprint != differential_runner_configuration_fingerprint(case.reference) or session.candidate_runner_fingerprint != differential_runner_configuration_fingerprint(case.candidate)
            return false if not differential_case_replay_root_binding_matches(session.materialization.reference_root, session.reference_root_binding) or not differential_case_replay_root_binding_matches(session.materialization.candidate_root, session.candidate_root_binding)
            components_synchronized: bool = try differential_case_replay_components_synchronized(session)
            return false if not components_synchronized
            return false if session.has_reference_run and differential_case_replay_run_fingerprint(session.manifest, DifferentialArtifactSide.Reference, session.reference_run) != session.reference_run_fingerprint
            return false if session.has_candidate_run and differential_case_replay_run_fingerprint(session.manifest, DifferentialArtifactSide.Candidate, session.candidate_run) != session.candidate_run_fingerprint
            return false if session.has_comparison and session.comparison.equal and session.comparison.kind != DifferentialDifferenceKind.Equal
            return false if session.has_comparison and not session.comparison.equal and session.comparison.kind == DifferentialDifferenceKind.Equal
            if session.has_comparison:
                artifact: DifferentialComparisonArtifact = make_differential_comparison_artifact(session.manifest, session.comparison)
                return false if differential_comparison_artifact_fingerprint(artifact) != session.replay.comparison_fingerprint
            return true


        def differential_case_replay_side_identity(side: DifferentialCaseSide) -> EsDifferentialReplay::DifferentialReplaySide error[DifferentialCaseReplayError]:
            match side:
                DifferentialCaseSide.Reference:
                    return EsDifferentialReplay::DifferentialReplaySide.Reference
                DifferentialCaseSide.Candidate:
                    return EsDifferentialReplay::DifferentialReplaySide.Candidate
                _:
                    raise DifferentialCaseReplayError.InvalidCase


        def differential_case_replay_expected_side(session: DifferentialCaseReplaySession&) -> EsDifferentialReplay::DifferentialReplaySide error[EsDifferentialReplay::DifferentialReplayError]:
            match session.replay.order:
                EsDifferentialReplay::DifferentialReplayOrder.ReferenceThenCandidate:
                    match session.replay.next_run:
                        0:
                            return EsDifferentialReplay::DifferentialReplaySide.Reference
                        1:
                            return EsDifferentialReplay::DifferentialReplaySide.Candidate
                        _:
                            raise EsDifferentialReplay::DifferentialReplayError.RunLimitExceeded
                EsDifferentialReplay::DifferentialReplayOrder.CandidateThenReference:
                    match session.replay.next_run:
                        0:
                            return EsDifferentialReplay::DifferentialReplaySide.Candidate
                        1:
                            return EsDifferentialReplay::DifferentialReplaySide.Reference
                        _:
                            raise EsDifferentialReplay::DifferentialReplayError.RunLimitExceeded
                _:
                    raise EsDifferentialReplay::DifferentialReplayError.InvalidOrder


        def request_differential_case_replay_termination(session: mutable DifferentialCaseReplaySession&, disposition: EsDifferentialReplay::DifferentialReplayDisposition) -> EsDifferentialReplay::DifferentialReplayState error[EsDifferentialReplay::DifferentialReplayError]:
            components_synchronized: bool = try differential_case_replay_components_synchronized(session)
            raise EsDifferentialReplay::DifferentialReplayError.InvalidState if not components_synchronized
            cleanup_needed: mutable bool = false
            match session.replay.state:
                EsDifferentialReplay::DifferentialReplayState.Planned:
                    cleanup_needed <- false
                EsDifferentialReplay::DifferentialReplayState.Admitted:
                    cleanup_needed <- false
                EsDifferentialReplay::DifferentialReplayState.Materializing:
                    cleanup_needed <- true
                EsDifferentialReplay::DifferentialReplayState.Running:
                    cleanup_needed <- true
                EsDifferentialReplay::DifferentialReplayState.Comparing:
                    cleanup_needed <- true
                EsDifferentialReplay::DifferentialReplayState.Restoring:
                    cleanup_needed <- false
                _:
                    raise EsDifferentialReplay::DifferentialReplayError.InvalidState
            raise EsDifferentialReplay::DifferentialReplayError.TerminationAlreadyRequested if session.replay.disposition != EsDifferentialReplay::DifferentialReplayDisposition.Normal
            if cleanup_needed:
                raise EsDifferentialReplay::DifferentialReplayError.InvalidState if not differential_world_materialization_transition_allowed(session.materialization.state, DifferentialWorldMaterializationState.Restoring)
            raise EsDifferentialReplay::DifferentialReplayError.InvalidState if disposition != EsDifferentialReplay::DifferentialReplayDisposition.Failed and disposition != EsDifferentialReplay::DifferentialReplayDisposition.Cancelled
            if cleanup_needed:
                cleanup: DifferentialWorldMaterializationCheck = advance_differential_world_materialization(session.materialization, DifferentialWorldMaterializationState.Restoring)
                raise EsDifferentialReplay::DifferentialReplayError.InvalidState if not cleanup.valid
            match disposition:
                EsDifferentialReplay::DifferentialReplayDisposition.Failed:
                    _ = EsDifferentialReplay::advance_differential_replay(session.replay, EsDifferentialReplay::DifferentialReplayEvent.Fail)
                EsDifferentialReplay::DifferentialReplayDisposition.Cancelled:
                    _ = EsDifferentialReplay::advance_differential_replay(session.replay, EsDifferentialReplay::DifferentialReplayEvent.Cancel)
                _:
                    raise EsDifferentialReplay::DifferentialReplayError.InvalidState
            return session.replay.state


    public:
        # Create a typed, case-bound paired-run lifecycle. The host adapter still
        # performs all filesystem/process work; this record binds its evidence,
        # run order, comparator, observation schema, and cleanup acknowledgments.
        def make_differential_case_replay_session(case: DifferentialCase&, order: EsDifferentialReplay::DifferentialReplayOrder, reference_root: sview, candidate_root: sview) -> DifferentialCaseReplaySession error[DifferentialRunnerError, DifferentialCaseReplayError] can[Memory.Allocate, Abort.Panic]:
            case_check: DifferentialCaseCheck = validate_differential_case(case)
            raise DifferentialCaseReplayError.InvalidCase if not case_check.valid
            raise DifferentialCaseReplayError.InvalidOrder if order != EsDifferentialReplay::DifferentialReplayOrder.ReferenceThenCandidate and order != EsDifferentialReplay::DifferentialReplayOrder.CandidateThenReference
            snapshot: DifferentialWorldSnapshot = make_differential_world_snapshot(case.world)
            manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(case)
            manifest_fingerprint: u64 = differential_artifact_manifest_fingerprint(manifest)
            raise DifferentialRunnerError.Invalid if manifest_fingerprint == 0
            reference_runner_fingerprint: u64 = differential_runner_configuration_fingerprint(case.reference)
            candidate_runner_fingerprint: u64 = differential_runner_configuration_fingerprint(case.candidate)
            raise DifferentialRunnerError.Invalid if reference_runner_fingerprint == 0 or candidate_runner_fingerprint == 0
            materialization: DifferentialWorldMaterializationPlan = make_differential_world_materialization_plan(snapshot, reference_root, candidate_root)
            replay: EsDifferentialReplay::DifferentialReplaySession = EsDifferentialReplay::DifferentialReplaySession{expected_manifest_fingerprint: manifest_fingerprint, expected_world_fingerprint: snapshot.world_fingerprint, order: order}
            session: DifferentialCaseReplaySession = DifferentialCaseReplaySession{manifest: manifest, world_snapshot: snapshot, materialization: materialization, reference_root_binding: differential_case_replay_copy_root_binding(reference_root), candidate_root_binding: differential_case_replay_copy_root_binding(candidate_root), reference_runner_fingerprint: reference_runner_fingerprint, candidate_runner_fingerprint: candidate_runner_fingerprint, case_timeout_steps: case.timeout_steps, case_max_output_bytes: case.max_output_bytes, replay: replay}
            raise DifferentialCaseReplayError.InvalidSession if not differential_case_replay_session_valid(case, session)
            return session


        def validate_differential_case_replay_session(case: DifferentialCase&, session: DifferentialCaseReplaySession&) -> bool error[DifferentialRunnerError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return differential_case_replay_session_valid(case, session)


        # Return borrowed views of the session-owned root bytes. Host adapters
        # should use these stable bindings for filesystem work instead of
        # retaining caller-provided path views.
        def differential_case_replay_bound_reference_root(session: DifferentialCaseReplaySession&) -> sview error[DifferentialCaseReplayError]:
            root: sview = bytes_view(session.reference_root_binding)
            raise DifferentialCaseReplayError.InvalidSession if not differential_world_materialization_root_valid(root)
            return root


        def differential_case_replay_bound_candidate_root(session: DifferentialCaseReplaySession&) -> sview error[DifferentialCaseReplayError]:
            root: sview = bytes_view(session.candidate_root_binding)
            raise DifferentialCaseReplayError.InvalidSession if not differential_world_materialization_root_valid(root)
            return root


        def admit_differential_case_replay(case: DifferentialCase&, session: mutable DifferentialCaseReplaySession&) -> EsDifferentialReplay::DifferentialReplayState error[DifferentialRunnerError, DifferentialCaseReplayError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise DifferentialCaseReplayError.InvalidSession if not differential_case_replay_session_valid(case, session)
            fingerprint: u64 = differential_artifact_manifest_fingerprint(session.manifest)
            return try EsDifferentialReplay::advance_differential_replay(session.replay, EsDifferentialReplay::DifferentialReplayEvent.Admit, fingerprint)


        def begin_differential_case_replay_materialization(case: DifferentialCase&, session: mutable DifferentialCaseReplaySession&) -> EsDifferentialReplay::DifferentialReplayState error[DifferentialRunnerError, DifferentialCaseReplayError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise DifferentialCaseReplayError.InvalidSession if not differential_case_replay_session_valid(case, session)
            _ = EsDifferentialReplay::advance_differential_replay(session.replay, EsDifferentialReplay::DifferentialReplayEvent.Materialize)
            materializing: DifferentialWorldMaterializationCheck = advance_differential_world_materialization(session.materialization, DifferentialWorldMaterializationState.Materializing)
            raise DifferentialCaseReplayError.InvalidSession if not materializing.valid
            return session.replay.state


        # Call only after the adapter has prepared both isolated roots. The typed
        # declarations and lifecycle are checked here; actual filesystem writes
        # remain the adapter's responsibility.
        def mark_differential_case_worlds_ready(case: DifferentialCase&, session: mutable DifferentialCaseReplaySession&, reference_world: DifferentialWorld&, candidate_world: DifferentialWorld&) -> EsDifferentialReplay::DifferentialReplayState error[DifferentialRunnerError, DifferentialCaseReplayError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise DifferentialCaseReplayError.InvalidSession if not differential_case_replay_session_valid(case, session)
            reference_check: DifferentialWorldMaterializationCheck = validate_differential_world_materialization(session.materialization, session.world_snapshot, reference_world)
            raise DifferentialCaseReplayError.InvalidSession if not reference_check.valid
            candidate_check: DifferentialWorldMaterializationCheck = validate_differential_world_materialization(session.materialization, session.world_snapshot, candidate_world)
            raise DifferentialCaseReplayError.InvalidSession if not candidate_check.valid
            materialized: DifferentialWorldMaterializationCheck = advance_differential_world_materialization(session.materialization, DifferentialWorldMaterializationState.Materialized)
            raise DifferentialCaseReplayError.InvalidSession if not materialized.valid
            _ = EsDifferentialReplay::advance_differential_replay(session.replay, EsDifferentialReplay::DifferentialReplayEvent.WorldReady, session.world_snapshot.world_fingerprint)
            running: DifferentialWorldMaterializationCheck = advance_differential_world_materialization(session.materialization, DifferentialWorldMaterializationState.Running)
            raise DifferentialCaseReplayError.InvalidSession if not running.valid
            return session.replay.state


        def prepare_differential_case_replay_runner(case: DifferentialCase&, session: DifferentialCaseReplaySession&, side: DifferentialCaseSide) -> DifferentialRunner error[DifferentialRunnerError, DifferentialCaseReplayError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise DifferentialCaseReplayError.InvalidSession if not differential_case_replay_session_valid(case, session)
            raise DifferentialCaseReplayError.RunnerNotReady if session.replay.state != EsDifferentialReplay::DifferentialReplayState.Running or session.materialization.state != DifferentialWorldMaterializationState.Running
            expected: EsDifferentialReplay::DifferentialReplaySide = try differential_case_replay_expected_side(session)
            selected: EsDifferentialReplay::DifferentialReplaySide = try differential_case_replay_side_identity(side)
            raise DifferentialCaseReplayError.RunOrderInvalid if selected != expected
            return try prepare_differential_case_runner(case, side)


        def complete_differential_case_replay_run(case: DifferentialCase&, session: mutable DifferentialCaseReplaySession&, side: DifferentialCaseSide, run: DifferentialRun&) -> EsDifferentialReplay::DifferentialReplayState error[DifferentialRunnerError, DifferentialCaseReplayError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise DifferentialCaseReplayError.InvalidSession if not differential_case_replay_session_valid(case, session)
            raise DifferentialCaseReplayError.RunnerNotReady if session.replay.state != EsDifferentialReplay::DifferentialReplayState.Running or session.materialization.state != DifferentialWorldMaterializationState.Running
            side_identity: EsDifferentialReplay::DifferentialReplaySide = try differential_case_replay_side_identity(side)
            expected: EsDifferentialReplay::DifferentialReplaySide = try differential_case_replay_expected_side(session)
            raise DifferentialCaseReplayError.RunOrderInvalid if side_identity != expected
            artifact_side: DifferentialArtifactSide = DifferentialArtifactSide.Reference if side_identity == EsDifferentialReplay::DifferentialReplaySide.Reference else DifferentialArtifactSide.Candidate
            run_fingerprint: u64 = differential_case_replay_run_fingerprint(session.manifest, artifact_side, run)
            raise DifferentialCaseReplayError.InvalidSession if run_fingerprint == 0
            if side_identity == EsDifferentialReplay::DifferentialReplaySide.Reference:
                session.reference_run <- run
            else:
                session.candidate_run <- run
            next_state: EsDifferentialReplay::DifferentialReplayState = EsDifferentialReplay::advance_differential_replay(session.replay, EsDifferentialReplay::DifferentialReplayEvent.RunComplete, run_fingerprint, side_identity)
            if side_identity == EsDifferentialReplay::DifferentialReplaySide.Reference:
                session.reference_run_fingerprint <- run_fingerprint
                session.has_reference_run <- true
            else:
                session.candidate_run_fingerprint <- run_fingerprint
                session.has_candidate_run <- true
            return next_state


        # Case-aware comparison is the only comparison path exposed by this
        # paired lifecycle. It must complete before restoration can finish;
        # adapters should publish no artifact until the session is Completed.
        def compare_differential_case_replay(case: DifferentialCase&, session: mutable DifferentialCaseReplaySession&) -> EsDifferentialReplay::DifferentialReplayState error[DifferentialRunnerError, DifferentialCaseReplayError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise DifferentialCaseReplayError.InvalidSession if not differential_case_replay_session_valid(case, session)
            raise DifferentialCaseReplayError.ComparisonNotReady if session.replay.state != EsDifferentialReplay::DifferentialReplayState.Comparing or not session.has_reference_run or not session.has_candidate_run
            raise DifferentialCaseReplayError.InvalidSession if differential_case_replay_run_fingerprint(session.manifest, DifferentialArtifactSide.Reference, session.reference_run) != session.reference_run_fingerprint or differential_case_replay_run_fingerprint(session.manifest, DifferentialArtifactSide.Candidate, session.candidate_run) != session.candidate_run_fingerprint
            comparison: DifferentialComparison = compare_differential_case_runs(case, session.reference_run, session.candidate_run)
            comparison_artifact: DifferentialComparisonArtifact = make_differential_comparison_artifact(session.manifest, comparison)
            comparison_fingerprint: u64 = differential_comparison_artifact_fingerprint(comparison_artifact)
            raise DifferentialCaseReplayError.InvalidSession if comparison_fingerprint == 0
            _ = EsDifferentialReplay::advance_differential_replay(session.replay, EsDifferentialReplay::DifferentialReplayEvent.CompareComplete, comparison_fingerprint)
            restoring: DifferentialWorldMaterializationCheck = advance_differential_world_materialization(session.materialization, DifferentialWorldMaterializationState.Restoring)
            raise DifferentialCaseReplayError.InvalidSession if not restoring.valid
            session.comparison <- comparison
            session.has_comparison <- true
            return session.replay.state


        def fail_differential_case_replay(session: mutable DifferentialCaseReplaySession&) -> EsDifferentialReplay::DifferentialReplayState error[EsDifferentialReplay::DifferentialReplayError]:
            return try request_differential_case_replay_termination(session, EsDifferentialReplay::DifferentialReplayDisposition.Failed)


        def cancel_differential_case_replay(session: mutable DifferentialCaseReplaySession&) -> EsDifferentialReplay::DifferentialReplayState error[EsDifferentialReplay::DifferentialReplayError]:
            return try request_differential_case_replay_termination(session, EsDifferentialReplay::DifferentialReplayDisposition.Cancelled)


        def restore_differential_case_replay_worlds(case: DifferentialCase&, session: mutable DifferentialCaseReplaySession&, reference_restored_world: DifferentialWorld&, candidate_restored_world: DifferentialWorld&) -> DifferentialWorldMaterializationCheck error[DifferentialRunnerError, DifferentialCaseReplayError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if session.replay.state == EsDifferentialReplay::DifferentialReplayState.Restoring and session.materialization.state == DifferentialWorldMaterializationState.Restoring:
                cleanup_state_valid: bool = try differential_case_replay_components_synchronized(session)
                raise DifferentialCaseReplayError.InvalidSession if not cleanup_state_valid
            else:
                raise DifferentialCaseReplayError.InvalidSession if not differential_case_replay_session_valid(case, session)
                raise DifferentialCaseReplayError.ArtifactNotReady
            restored: DifferentialWorldMaterializationCheck = complete_differential_world_restoration(session.materialization, session.world_snapshot, reference_restored_world, candidate_restored_world)
            return restored if not restored.valid
            _ = EsDifferentialReplay::advance_differential_replay(session.replay, EsDifferentialReplay::DifferentialReplayEvent.RestoreComplete, session.world_snapshot.world_fingerprint)
            return restored


        def differential_case_replay_comparison(case: DifferentialCase&, session: DifferentialCaseReplaySession&) -> DifferentialComparison error[DifferentialRunnerError, DifferentialCaseReplayError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise DifferentialCaseReplayError.InvalidSession if not differential_case_replay_session_valid(case, session)
            raise DifferentialCaseReplayError.ArtifactNotReady if session.replay.state != EsDifferentialReplay::DifferentialReplayState.Completed or session.materialization.state != DifferentialWorldMaterializationState.Restored or not session.has_comparison
            return session.comparison


        def make_differential_case_replay_comparison_artifact(case: DifferentialCase&, session: DifferentialCaseReplaySession&) -> DifferentialComparisonArtifact error[DifferentialRunnerError, DifferentialCaseReplayError, EsDifferentialReplay::DifferentialReplayError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            comparison: DifferentialComparison = try differential_case_replay_comparison(case, session)
            return try make_differential_comparison_artifact(session.manifest, comparison)


    public:
        const DIFFERENTIAL_SHRINK_TRACE_MAX_STEPS: usize = 64


        const enum DifferentialShrinkTraceState of u8:
            Planned
            Recording
            Complete
            Failed
            Cancelled


        const enum DifferentialShrinkTraceEvent of u8:
            Begin
            Record
            Complete
            Fail
            Cancel


        struct DifferentialShrinkTraceStep:
            ordinal: usize
            kind: DifferentialRunShrinkKind
            candidate_fingerprint: u64
            preserved_kind: DifferentialDifferenceKind


        struct DifferentialShrinkTrace:
            target_kind: DifferentialDifferenceKind
            max_steps: usize = DIFFERENTIAL_SHRINK_TRACE_MAX_STEPS
            state: DifferentialShrinkTraceState = DifferentialShrinkTraceState.Planned
            next_step: usize = 0
            steps: darray[DifferentialShrinkTraceStep] = []
            minimality_proven: bool = false


        error DifferentialShrinkTraceError:
            InvalidState
            InvalidEvent
            InvalidKind
            StepLimitExceeded
            StepOrderInvalid
            FingerprintMissing
            MismatchCategory
            MinimalityUnproven
            CancelNotReady


    private:
        def differential_shrink_trace_state_valid(state: DifferentialShrinkTraceState) -> bool:
            return state in {DifferentialShrinkTraceState.Planned, DifferentialShrinkTraceState.Recording, DifferentialShrinkTraceState.Complete, DifferentialShrinkTraceState.Failed, DifferentialShrinkTraceState.Cancelled}


        def differential_shrink_trace_event_valid(event: DifferentialShrinkTraceEvent) -> bool:
            return event in {DifferentialShrinkTraceEvent.Begin, DifferentialShrinkTraceEvent.Record, DifferentialShrinkTraceEvent.Complete, DifferentialShrinkTraceEvent.Fail, DifferentialShrinkTraceEvent.Cancel}


        def differential_shrink_trace_kind_valid(kind: DifferentialDifferenceKind) -> bool:
            return differential_difference_kind_valid(kind) and kind != DifferentialDifferenceKind.Equal and kind != DifferentialDifferenceKind.CaseInvalid and kind != DifferentialDifferenceKind.ObservationContract


        def differential_shrink_trace_run_kind_valid(kind: DifferentialRunShrinkKind) -> bool:
            return kind in {DifferentialRunShrinkKind.ClearReferenceStdout, DifferentialRunShrinkKind.ClearCandidateStdout, DifferentialRunShrinkKind.ClearReferenceStderr, DifferentialRunShrinkKind.ClearCandidateStderr, DifferentialRunShrinkKind.RemoveReferenceObservation, DifferentialRunShrinkKind.RemoveCandidateObservation}


    public:
        def validate_differential_shrink_trace(trace: DifferentialShrinkTrace&) -> bool error[DifferentialShrinkTraceError]:
            raise DifferentialShrinkTraceError.InvalidState if not differential_shrink_trace_state_valid(trace.state)
            raise DifferentialShrinkTraceError.InvalidKind if not differential_shrink_trace_kind_valid(trace.target_kind)
            raise DifferentialShrinkTraceError.StepLimitExceeded if trace.max_steps == 0 or trace.max_steps > DIFFERENTIAL_SHRINK_TRACE_MAX_STEPS or trace.steps.count > trace.max_steps
            raise DifferentialShrinkTraceError.StepOrderInvalid if trace.next_step != trace.steps.count
            raise DifferentialShrinkTraceError.InvalidState if trace.minimality_proven and trace.state != DifferentialShrinkTraceState.Complete
            for index in 0..<trace.steps.count |trace|:
                step: DifferentialShrinkTraceStep = trace.steps[index]
                raise DifferentialShrinkTraceError.StepOrderInvalid if step.ordinal != index
                raise DifferentialShrinkTraceError.InvalidKind if not differential_shrink_trace_run_kind_valid(step.kind) or not differential_shrink_trace_kind_valid(step.preserved_kind)
                raise DifferentialShrinkTraceError.MismatchCategory if step.preserved_kind != trace.target_kind
                raise DifferentialShrinkTraceError.FingerprintMissing if step.candidate_fingerprint == 0
            raise DifferentialShrinkTraceError.MinimalityUnproven if trace.state == DifferentialShrinkTraceState.Complete and not trace.minimality_proven
            return true


        def advance_differential_shrink_trace(trace: mutable DifferentialShrinkTrace&, event: DifferentialShrinkTraceEvent, step: DifferentialShrinkTraceStep = DifferentialShrinkTraceStep{ordinal: 0, kind: DifferentialRunShrinkKind.ClearReferenceStdout, candidate_fingerprint: 1, preserved_kind: DifferentialDifferenceKind.ReturnValue}, exhausted: bool = false) -> DifferentialShrinkTraceState error[DifferentialShrinkTraceError]:
            try validate_differential_shrink_trace(trace)
            raise DifferentialShrinkTraceError.InvalidEvent if not differential_shrink_trace_event_valid(event)
            if event == DifferentialShrinkTraceEvent.Begin:
                raise DifferentialShrinkTraceError.InvalidState if trace.state != DifferentialShrinkTraceState.Planned
                trace.state <- DifferentialShrinkTraceState.Recording
            elif event == DifferentialShrinkTraceEvent.Record:
                raise DifferentialShrinkTraceError.InvalidState if trace.state != DifferentialShrinkTraceState.Recording
                raise DifferentialShrinkTraceError.StepLimitExceeded if trace.steps.count >= trace.max_steps
                raise DifferentialShrinkTraceError.StepOrderInvalid if step.ordinal != trace.next_step
                raise DifferentialShrinkTraceError.InvalidKind if not differential_shrink_trace_run_kind_valid(step.kind) or not differential_shrink_trace_kind_valid(step.preserved_kind)
                raise DifferentialShrinkTraceError.MismatchCategory if step.preserved_kind != trace.target_kind
                raise DifferentialShrinkTraceError.FingerprintMissing if step.candidate_fingerprint == 0
                trace.steps.push(step)
                trace.next_step <- trace.next_step + 1
            elif event == DifferentialShrinkTraceEvent.Complete:
                raise DifferentialShrinkTraceError.InvalidState if trace.state != DifferentialShrinkTraceState.Recording
                raise DifferentialShrinkTraceError.MinimalityUnproven if not exhausted
                trace.minimality_proven <- true
                trace.state <- DifferentialShrinkTraceState.Complete
            elif event == DifferentialShrinkTraceEvent.Fail:
                raise DifferentialShrinkTraceError.InvalidState if trace.state != DifferentialShrinkTraceState.Recording
                trace.state <- DifferentialShrinkTraceState.Failed
            elif event == DifferentialShrinkTraceEvent.Cancel:
                raise DifferentialShrinkTraceError.CancelNotReady if trace.state != DifferentialShrinkTraceState.Planned and trace.state != DifferentialShrinkTraceState.Recording
                trace.state <- DifferentialShrinkTraceState.Cancelled
            return trace.state
