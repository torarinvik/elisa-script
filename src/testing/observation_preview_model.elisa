# Bounded byte previews for controlled fixture evidence, never an equality oracle.
# No UTF-8 decoding, normalization, host operation or process dependency.
# Hex is reversible, not redaction; callers must authorize the observed data.
include "../../vendor/elisa-compiler/elisacore_std/elisacore_runtime.elisa"

module EsObservationPreview:
    public:
        const module Limits:
            WINDOW_BYTES: usize = 64


        struct Preview:
            total_bytes: usize
            shown_bytes: usize
            truncated: bool
            hex: darray[u8] = []


        error PreviewError:
            InvalidBudget


        # sview is a byte span: embedded NUL and non-UTF-8 bytes are preserved.
        # This reads only the admitted prefix, not the entire observed stream.
        def preview(value: sview, prefix_bytes: usize = Limits::WINDOW_BYTES) -> Preview error[PreviewError] can[Memory.Allocate, Abort.Panic]:
            return try preview_window(value, prefix_bytes, false)


        # A tail exposes the error after a long path prefix. Windows may overlap;
        # neither is a complete observation or an equality oracle.
        def tail_preview(value: sview, tail_bytes: usize = Limits::WINDOW_BYTES) -> Preview error[PreviewError] can[Memory.Allocate, Abort.Panic]:
            return try preview_window(value, tail_bytes, true)

    private:
        def preview_window(value: sview, window_bytes: usize, from_end: bool) -> Preview error[PreviewError] can[Memory.Allocate, Abort.Panic]:
            raise PreviewError.InvalidBudget if window_bytes > Limits::WINDOW_BYTES
            count: usize = sview_len(value)
            shown: usize = count if count < window_bytes else window_bytes
            start: usize = count - shown if from_end else 0
            result: mutable Preview = Preview{total_bytes: count, shown_bytes: shown, truncated: count > shown}
            result.hex.reserve(shown * 2)
            for index in 0..<shown |result|:
                byte: u8 = sview_at(value, start + index)
                result.hex.push(hex_digit(byte >> 4))
                result.hex.push(hex_digit(byte & 15u8))
            return result

        # Both callers supply a nibble, so checked u8 addition cannot overflow.
        def hex_digit(value: u8) -> u8:
            return 48u8 + value if value < 10u8 else 87u8 + value
