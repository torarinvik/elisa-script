# Typed port of the scene-metadata byte replacements in
# elisa-engine/scripts/geometry_subset_cases.py.
module EsGeometrySubsetSceneCases:
    public:
        error SceneCasesError:
            MissingExpectedField


        const enum Verdict of u8:
            Reject


        struct Case:
            verdict: Verdict
            file_name: sview
            package_bytes: darray[u8]
            expected_diagnostic: sview


        # The caller supplies the complete cooker-produced scene package.
        def cases(scene_package: sview) -> darray[Case] error[SceneCasesError] can[Memory.Allocate, Abort.Panic]:
            bad_camera_projection: darray[u8] = try scene_replace_first(scene_package, Syntax::CAMERA_PROJECTION_ZERO, Syntax::CAMERA_PROJECTION_TWO)
            bad_light_kind: darray[u8] = try scene_replace_first(scene_package, Syntax::LIGHT_KIND_POINT, Syntax::LIGHT_KIND_INVALID)
            bad_camera_transform: darray[u8] = try scene_replace_first(scene_package, Syntax::CAMERA_TRANSFORM_BASE64, Syntax::CAMERA_TRANSFORM_TEXT)
            return [
                Case{verdict: Verdict.Reject, file_name: "scene-camera-projection.pkg", package_bytes: bad_camera_projection, expected_diagnostic: Syntax::CAMERA_DIAGNOSTIC},
                Case{verdict: Verdict.Reject, file_name: "scene-light-kind.pkg", package_bytes: bad_light_kind, expected_diagnostic: Syntax::LIGHT_DIAGNOSTIC},
                Case{verdict: Verdict.Reject, file_name: "scene-camera-transform.pkg", package_bytes: bad_camera_transform, expected_diagnostic: Syntax::CAMERA_DIAGNOSTIC}
            ]


    private:
        const module Syntax:
            CAMERA_PROJECTION_ZERO: sview = "camera_0_projection=0"
            CAMERA_PROJECTION_TWO: sview = "camera_0_projection=2"
            LIGHT_KIND_POINT: sview = "light_0_kind=0"
            LIGHT_KIND_INVALID: sview = "light_0_kind=3"
            CAMERA_TRANSFORM_BASE64: sview = "camera_0_transform_b64="
            CAMERA_TRANSFORM_TEXT: sview = "camera_0_transform="
            CAMERA_DIAGNOSTIC: sview = "camera metadata"
            LIGHT_DIAGNOSTIC: sview = "light metadata"


        def scene_replace_first(source: sview, needle: sview, replacement: sview) -> darray[u8] error[SceneCasesError] can[Memory.Allocate, Abort.Panic]:
            source_length: usize = len(source)
            needle_length: usize = len(needle)
            raise SceneCasesError.MissingExpectedField if needle_length == 0
            cursor: mutable usize = 0
            found: mutable bool = false
            while cursor <= source_length and needle_length <= source_length - cursor and not found |source, needle, cursor, found|:
                if source[cursor:cursor + needle_length] == needle:
                    found <- true
                else:
                    cursor <- cursor + 1
            raise SceneCasesError.MissingExpectedField if not found

            output: mutable darray[u8] = []
            output.reserve(source_length - needle_length + len(replacement))
            for byte in source[0:cursor] |output|:
                output.push(byte)
            for byte in replacement |output|:
                output.push(byte)
            for byte in source[cursor + needle_length:source_length] |output|:
                output.push(byte)
            return output
