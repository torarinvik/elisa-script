# Bounded algebraic-effect trace contract for differential testing.
#
# Effect traces make dynamic-handler behavior observable without exposing a
# handler implementation. Adapters record ordered operation identities and
# fingerprints for payload/result values plus resumption counts; comparison
# reports the first typed difference and never treats a missing effect as an
# equal run.

module EsDifferentialEffectTrace:
    public:
        const module Limits:
            EVENTS: usize = 1048576
            TEXT_BYTES: usize = 4096
            RESUMPTIONS: usize = 1024


        const enum DifferentialEffectTraceState of u8:
            Planned
            Collecting
            Sealed
            Failed
            Cancelled


        const enum DifferentialEffectTraceEvent of u8:
            Begin
            Record
            Seal
            Fail
            Cancel


        struct DifferentialEffectEvent:
            sequence_index: usize
            family: sview
            operation: sview
            payload_fingerprint: u64
            result_fingerprint: u64
            resumption_count: usize = 0
            multishot: bool = false


        struct DifferentialEffectTrace:
            state: DifferentialEffectTraceState = DifferentialEffectTraceState.Planned
            next_index: usize = 0
            events: darray[DifferentialEffectEvent] = []


        const enum DifferentialEffectDifferenceKind of u8:
            Equal
            Invalid
            TraceNotSealed
            Count
            Family
            Operation
            Payload
            Result
            Resumption


        struct DifferentialEffectDifference:
            equal: bool
            kind: DifferentialEffectDifferenceKind
            index: usize = 0
            reference_family: sview = ""
            candidate_family: sview = ""
            reference_operation: sview = ""
            candidate_operation: sview = ""
            reason: sview = ""


        error DifferentialEffectTraceError:
            InvalidState
            InvalidEvent
            InvalidText
            TextLimitExceeded
            EventLimitExceeded
            IndexInvalid
            FingerprintMissing
            ResumptionLimitExceeded
            MultishotInvalid
            TraceNotSealed
            ComparisonInvalid
            CancelNotReady


    private:
        const module Fingerprint:
            OFFSET: u64 = 14695981039346656037
            PRIME: u64 = 1099511628211


        def differential_effect_fingerprint_mix(result: u64, value: u64) -> u64:
            return EsHash::hash_wrapping_add_u64(EsHash::hash_wrapping_multiply_u64(result, Fingerprint::PRIME), value)


        def differential_effect_trace_state_valid(state: DifferentialEffectTraceState) -> bool:
            return state in {DifferentialEffectTraceState.Planned, DifferentialEffectTraceState.Collecting, DifferentialEffectTraceState.Sealed, DifferentialEffectTraceState.Failed, DifferentialEffectTraceState.Cancelled}


        def differential_effect_trace_event_valid(event: DifferentialEffectTraceEvent) -> bool:
            return event in {DifferentialEffectTraceEvent.Begin, DifferentialEffectTraceEvent.Record, DifferentialEffectTraceEvent.Seal, DifferentialEffectTraceEvent.Fail, DifferentialEffectTraceEvent.Cancel}


        def differential_effect_difference_kind_valid(kind: DifferentialEffectDifferenceKind) -> bool:
            return kind in {DifferentialEffectDifferenceKind.Equal, DifferentialEffectDifferenceKind.Invalid, DifferentialEffectDifferenceKind.TraceNotSealed, DifferentialEffectDifferenceKind.Count, DifferentialEffectDifferenceKind.Family, DifferentialEffectDifferenceKind.Operation, DifferentialEffectDifferenceKind.Payload, DifferentialEffectDifferenceKind.Result, DifferentialEffectDifferenceKind.Resumption}


        def differential_effect_trace_text_valid(value: sview) -> bool:
            return sview_len(value) != 0 and sview_len(value) <= Limits::TEXT_BYTES and not sview_contains_byte(value, 0)


        def differential_effect_fingerprint_valid(value: u64) -> bool:
            return value != 0


        def differential_effect_event_valid(event: DifferentialEffectEvent) -> bool:
            return differential_effect_trace_text_valid(event.family) and differential_effect_trace_text_valid(event.operation) and differential_effect_fingerprint_valid(event.payload_fingerprint) and differential_effect_fingerprint_valid(event.result_fingerprint) and event.resumption_count <= Limits::RESUMPTIONS and (not event.multishot or event.resumption_count > 0)


    public:
        def validate_differential_effect_trace(trace: DifferentialEffectTrace&) -> bool error[DifferentialEffectTraceError]:
            raise DifferentialEffectTraceError.InvalidState if not differential_effect_trace_state_valid(trace.state)
            raise DifferentialEffectTraceError.EventLimitExceeded if trace.events.count > Limits::EVENTS
            raise DifferentialEffectTraceError.IndexInvalid if trace.next_index != trace.events.count
            for index in 0..<trace.events.count |trace|:
                event: DifferentialEffectEvent = trace.events[index]
                raise DifferentialEffectTraceError.IndexInvalid if event.sequence_index != index
                raise DifferentialEffectTraceError.InvalidText if not differential_effect_trace_text_valid(event.family) or not differential_effect_trace_text_valid(event.operation)
                raise DifferentialEffectTraceError.FingerprintMissing if not differential_effect_fingerprint_valid(event.payload_fingerprint) or not differential_effect_fingerprint_valid(event.result_fingerprint)
                raise DifferentialEffectTraceError.ResumptionLimitExceeded if event.resumption_count > Limits::RESUMPTIONS
                raise DifferentialEffectTraceError.MultishotInvalid if event.multishot and event.resumption_count == 0
            return true


        def advance_differential_effect_trace(trace: mutable DifferentialEffectTrace&, event: DifferentialEffectTraceEvent, effect: DifferentialEffectEvent = DifferentialEffectEvent{sequence_index: 0, family: "effect", operation: "operation", payload_fingerprint: 1, result_fingerprint: 1}) -> DifferentialEffectTraceState error[DifferentialEffectTraceError]:
            try validate_differential_effect_trace(trace)
            raise DifferentialEffectTraceError.InvalidEvent if not differential_effect_trace_event_valid(event)
            if event == DifferentialEffectTraceEvent.Begin:
                raise DifferentialEffectTraceError.InvalidState if trace.state != DifferentialEffectTraceState.Planned
                trace.state <- DifferentialEffectTraceState.Collecting
            elif event == DifferentialEffectTraceEvent.Record:
                raise DifferentialEffectTraceError.InvalidState if trace.state != DifferentialEffectTraceState.Collecting
                raise DifferentialEffectTraceError.EventLimitExceeded if trace.events.count >= Limits::EVENTS
                raise DifferentialEffectTraceError.IndexInvalid if effect.sequence_index != trace.next_index
                raise DifferentialEffectTraceError.InvalidText if not differential_effect_trace_text_valid(effect.family) or not differential_effect_trace_text_valid(effect.operation)
                raise DifferentialEffectTraceError.FingerprintMissing if not differential_effect_fingerprint_valid(effect.payload_fingerprint) or not differential_effect_fingerprint_valid(effect.result_fingerprint)
                raise DifferentialEffectTraceError.ResumptionLimitExceeded if effect.resumption_count > Limits::RESUMPTIONS
                raise DifferentialEffectTraceError.MultishotInvalid if effect.multishot and effect.resumption_count == 0
                trace.events.push(effect)
                trace.next_index <- trace.next_index + 1
            elif event == DifferentialEffectTraceEvent.Seal:
                raise DifferentialEffectTraceError.InvalidState if trace.state != DifferentialEffectTraceState.Collecting
                trace.state <- DifferentialEffectTraceState.Sealed
            elif event == DifferentialEffectTraceEvent.Fail:
                raise DifferentialEffectTraceError.InvalidState if trace.state != DifferentialEffectTraceState.Collecting
                trace.state <- DifferentialEffectTraceState.Failed
            elif event == DifferentialEffectTraceEvent.Cancel:
                raise DifferentialEffectTraceError.CancelNotReady if trace.state != DifferentialEffectTraceState.Planned and trace.state != DifferentialEffectTraceState.Collecting
                trace.state <- DifferentialEffectTraceState.Cancelled
            return trace.state


        def differential_effect_trace_fingerprint(trace: DifferentialEffectTrace&) -> u64 can[Memory.Allocate, Abort.Panic]:
            return 0 if trace.state != DifferentialEffectTraceState.Sealed or trace.events.count > Limits::EVENTS or trace.next_index != trace.events.count
            valid: mutable bool = false
            catch validate_differential_effect_trace(trace):
                ok result:
                    valid <- result
                error failure:
                    _ = failure
                    return 0
            return 0 if not valid
            result: mutable u64 = Fingerprint::OFFSET
            result <- differential_effect_fingerprint_mix(result, trace.events.count.u64())
            for event in trace.events |result|:
                result <- differential_effect_fingerprint_mix(result, event.sequence_index.u64())
                for index in 0..<sview_len(event.family) |event, result|:
                    result <- differential_effect_fingerprint_mix(result, sview_at(event.family, index).u64())
                for index in 0..<sview_len(event.operation) |event, result|:
                    result <- differential_effect_fingerprint_mix(result, sview_at(event.operation, index).u64())
                result <- differential_effect_fingerprint_mix(result, event.payload_fingerprint)
                result <- differential_effect_fingerprint_mix(result, event.result_fingerprint)
                result <- differential_effect_fingerprint_mix(result, event.resumption_count.u64())
                result <- differential_effect_fingerprint_mix(result, 1u64 if event.multishot else 0u64)
            return result


        def compare_differential_effect_traces(reference: DifferentialEffectTrace&, candidate: DifferentialEffectTrace&) -> DifferentialEffectDifference:
            return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.TraceNotSealed, reason: "effect traces must be sealed before comparison"} if reference.state != DifferentialEffectTraceState.Sealed or candidate.state != DifferentialEffectTraceState.Sealed
            return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.Count, reason: "effect trace validation failed"} if reference.events.count > Limits::EVENTS or candidate.events.count > Limits::EVENTS or reference.next_index != reference.events.count or candidate.next_index != candidate.events.count
            for event in reference.events:
                return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.Invalid, reason: "reference effect trace record is invalid"} if not differential_effect_event_valid(event)
            for event in candidate.events:
                return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.Invalid, reason: "candidate effect trace record is invalid"} if not differential_effect_event_valid(event)
            return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.Count, index: reference.events.count if reference.events.count < candidate.events.count else candidate.events.count, reason: "effect event count differs"} if reference.events.count != candidate.events.count
            for index in 0..<reference.events.count |reference, candidate|:
                left: DifferentialEffectEvent = reference.events[index]
                right: DifferentialEffectEvent = candidate.events[index]
                return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.Invalid, index: index, reason: "effect sequence index is not contiguous"} if left.sequence_index != index or right.sequence_index != index
                return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.Family, index: index, reference_family: left.family, candidate_family: right.family, reference_operation: left.operation, candidate_operation: right.operation, reason: "effect family differs"} if left.family != right.family
                return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.Operation, index: index, reference_family: left.family, candidate_family: right.family, reference_operation: left.operation, candidate_operation: right.operation, reason: "effect operation differs"} if left.operation != right.operation
                return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.Payload, index: index, reason: "effect payload differs"} if left.payload_fingerprint != right.payload_fingerprint
                return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.Result, index: index, reason: "effect result differs"} if left.result_fingerprint != right.result_fingerprint
                return DifferentialEffectDifference{equal: false, kind: DifferentialEffectDifferenceKind.Resumption, index: index, reason: "effect resumption policy differs"} if left.resumption_count != right.resumption_count or left.multishot != right.multishot
            return DifferentialEffectDifference{equal: true, kind: DifferentialEffectDifferenceKind.Equal, reason: "effect traces are equal"}
