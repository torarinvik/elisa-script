# Bounded post-run filesystem snapshot and comparison contract.
#
# Differential adapters materialize a world before execution and may collect a
# relative file-tree snapshot after execution. This module keeps that result
# typed and deterministic: entries are path-ordered either as they arrive or by
# an explicit bounded batch seal, aggregate path/content sizes are capped,
# snapshots must be sealed before comparison, and the first difference is
# reported without performing host filesystem I/O. Submitted paths are copied
# along with exact file bytes or raw symlink-target bytes into snapshot-owned
# arenas; stored entries retain checked offsets, not borrowed views or digests.

module EsDifferentialFilesystem:
    public:
        const module Limits:
            ENTRIES: usize = 1048576
            PATH_BYTES: usize = 4096
            PATH_STORAGE_BYTES: usize = 67108864
            TOTAL_BYTES: usize = 268435456


        const enum DifferentialFilesystemEntryKind of u8:
            File
            Directory
            Symlink


        const enum DifferentialFilesystemState of u8:
            Planned
            Collecting
            Sealed
            Failed
            Cancelled


        const enum DifferentialFilesystemEvent of u8:
            Begin
            Entry
            Seal
            Fail
            Cancel


        struct DifferentialFilesystemEntry:
            # Submission values; the snapshot copies them before returning.
            path: sview
            kind: DifferentialFilesystemEntryKind = DifferentialFilesystemEntryKind.File
            # Files carry exact file bytes; symlinks carry raw target bytes;
            # directories carry no content. Binary payloads may contain NUL.
            content: darray[u8] = []
            mode: u32 = 0
            executable: bool = false


        struct DifferentialFilesystemEntryRecord:
            path_start: usize
            path_bytes: usize
            content_start: usize
            content_bytes: usize
            kind: DifferentialFilesystemEntryKind = DifferentialFilesystemEntryKind.File
            mode: u32 = 0
            executable: bool = false


        struct DifferentialFilesystemSnapshot:
            max_entries: usize = Limits::ENTRIES
            max_path_bytes: usize = Limits::PATH_STORAGE_BYTES
            max_bytes: usize = Limits::TOTAL_BYTES
            state: DifferentialFilesystemState = DifferentialFilesystemState.Planned
            entries: darray[DifferentialFilesystemEntryRecord] = []
            path_data: darray[u8] = []
            content_data: darray[u8] = []
            total_bytes: usize = 0


        const enum DifferentialFilesystemDifferenceKind of u8:
            Equal
            SnapshotNotSealed
            EntryLimit
            MissingReference
            MissingCandidate
            Kind
            Content
            Size
            Mode
            Executable
            InvalidSnapshot


        struct DifferentialFilesystemDifference:
            equal: bool
            kind: DifferentialFilesystemDifferenceKind
            index: usize = 0
            has_reference_entry: bool = false
            reference_entry_index: usize = 0
            has_candidate_entry: bool = false
            candidate_entry_index: usize = 0
            reason: sview = ""


        error DifferentialFilesystemError:
            InvalidState
            InvalidEvent
            InvalidEntryKind
            InvalidContent
            InvalidPath
            EmbeddedNul
            PathLimitExceeded
            PathStorageLimitExceeded
            EntryLimitExceeded
            EntryIndexOutOfBounds
            ByteLimitExceeded
            EntryOrderInvalid
            SnapshotAccountingInvalid
            SnapshotNotSealed
            ComparisonInvalid
            CancelNotReady


    private:
        const DIFFERENTIAL_FILESYSTEM_HASH_OFFSET: u64 = 14695981039346656037
        const DIFFERENTIAL_FILESYSTEM_HASH_PRIME: u64 = 1099511628211


        def differential_filesystem_state_valid(state: DifferentialFilesystemState) -> bool:
            return state in {DifferentialFilesystemState.Planned, DifferentialFilesystemState.Collecting, DifferentialFilesystemState.Sealed, DifferentialFilesystemState.Failed, DifferentialFilesystemState.Cancelled}


        def differential_filesystem_event_valid(event: DifferentialFilesystemEvent) -> bool:
            return event in {DifferentialFilesystemEvent.Begin, DifferentialFilesystemEvent.Entry, DifferentialFilesystemEvent.Seal, DifferentialFilesystemEvent.Fail, DifferentialFilesystemEvent.Cancel}


        def differential_filesystem_entry_kind_valid(kind: DifferentialFilesystemEntryKind) -> bool:
            return kind in {DifferentialFilesystemEntryKind.File, DifferentialFilesystemEntryKind.Directory, DifferentialFilesystemEntryKind.Symlink}


        def differential_filesystem_path_safe(path: sview) -> bool:
            length: usize = sview_len(path)
            return false if length == 0 or length > Limits::PATH_BYTES or sview_contains_byte(path, 0) or sview_at(path, 0) == 47
            segment_start: mutable usize = 0
            index: mutable usize = 0
            while index <= length:
                at_end: bool = index == length
                # This is a POSIX relative path contract: backslash is an
                # ordinary filename byte, not a separator.
                separator: bool = not at_end and sview_at(path, index) == 47
                if at_end or separator:
                    return false if index == segment_start
                    segment_length: usize = index - segment_start
                    return false if segment_length == 1 and sview_at(path, segment_start) == 46
                    return false if segment_length == 2 and sview_at(path, segment_start) == 46 and sview_at(path, segment_start + 1) == 46
                    segment_start <- index + 1
                index <- index + 1
            return true


        def differential_filesystem_snapshot_valid(snapshot: DifferentialFilesystemSnapshot&) -> bool:
            return differential_filesystem_state_valid(snapshot.state) and snapshot.max_entries != 0 and snapshot.max_entries <= Limits::ENTRIES and snapshot.max_path_bytes != 0 and snapshot.max_path_bytes <= Limits::PATH_STORAGE_BYTES and snapshot.max_bytes != 0 and snapshot.max_bytes <= Limits::TOTAL_BYTES


        def differential_filesystem_path_span_safe(data: darray[u8]&, start: usize, length: usize) -> bool:
            return false if length == 0 or length > Limits::PATH_BYTES
            return false if start > data.count
            return false if length > data.count - start
            return false if data[start] == 47
            segment_start: mutable usize = 0
            index: mutable usize = 0
            while index <= length:
                at_end: bool = index == length
                byte: u8 = 0 if at_end else data[start + index]
                return false if not at_end and byte == 0
                separator: bool = not at_end and byte == 47
                if at_end or separator:
                    return false if index == segment_start
                    segment_length: usize = index - segment_start
                    return false if segment_length == 1 and data[start + segment_start] == 46
                    return false if segment_length == 2 and data[start + segment_start] == 46 and data[start + segment_start + 1] == 46
                    segment_start <- index + 1
                index <- index + 1
            return true


        def differential_filesystem_content_span_valid(snapshot: DifferentialFilesystemSnapshot&, start: usize, length: usize) -> bool:
            return false if start > snapshot.content_data.count
            return false if length > snapshot.content_data.count - start
            return true


        def differential_filesystem_content_span_has_nul(snapshot: DifferentialFilesystemSnapshot&, start: usize, length: usize) -> bool:
            for index in 0..<length |snapshot, start|:
                return true if snapshot.content_data[start + index] == 0
            return false


        def differential_filesystem_record_valid(snapshot: DifferentialFilesystemSnapshot&, entry: DifferentialFilesystemEntryRecord) -> bool:
            return false if not differential_filesystem_entry_kind_valid(entry.kind)
            return false if not differential_filesystem_path_span_safe(snapshot.path_data, entry.path_start, entry.path_bytes)
            return false if not differential_filesystem_content_span_valid(snapshot, entry.content_start, entry.content_bytes)
            return false if entry.kind == DifferentialFilesystemEntryKind.Directory and entry.content_bytes != 0
            return false if entry.kind == DifferentialFilesystemEntryKind.Symlink and (entry.content_bytes == 0 or differential_filesystem_content_span_has_nul(snapshot, entry.content_start, entry.content_bytes))
            return true


        def differential_filesystem_path_spans_less(left_data: darray[u8]&, left_start: usize, left_length: usize, right_data: darray[u8]&, right_start: usize, right_length: usize) -> bool:
            shared: usize = left_length if left_length < right_length else right_length
            index: mutable usize = 0
            while index < shared:
                left_byte: u8 = left_data[left_start + index]
                right_byte: u8 = right_data[right_start + index]
                return left_byte < right_byte if left_byte != right_byte
                index <- index + 1
            return left_length < right_length


        def differential_filesystem_input_path_less_record(snapshot: DifferentialFilesystemSnapshot&, path: sview, record: DifferentialFilesystemEntryRecord) -> bool:
            left_length: usize = sview_len(path)
            shared: usize = left_length if left_length < record.path_bytes else record.path_bytes
            index: mutable usize = 0
            while index < shared:
                left_byte: u8 = sview_at(path, index)
                right_byte: u8 = snapshot.path_data[record.path_start + index]
                return left_byte < right_byte if left_byte != right_byte
                index <- index + 1
            return left_length < record.path_bytes


        def differential_filesystem_entries_path_data_contiguous(snapshot: DifferentialFilesystemSnapshot&) -> bool:
            expected_start: mutable usize = 0
            for entry in snapshot.entries |snapshot, expected_start|:
                return false if expected_start > snapshot.path_data.count
                return false if entry.path_start != expected_start or entry.path_bytes > snapshot.path_data.count - expected_start
                expected_start <- expected_start + entry.path_bytes
            return expected_start == snapshot.path_data.count


        def differential_filesystem_entries_content_data_contiguous(snapshot: DifferentialFilesystemSnapshot&) -> bool:
            expected_start: mutable usize = 0
            for entry in snapshot.entries |snapshot, expected_start|:
                return false if expected_start > snapshot.content_data.count
                return false if entry.content_start != expected_start or entry.content_bytes > snapshot.content_data.count - expected_start
                expected_start <- expected_start + entry.content_bytes
            return expected_start == snapshot.content_data.count


        def differential_filesystem_snapshot_unordered_records_valid(snapshot: DifferentialFilesystemSnapshot&) -> bool:
            return false if not differential_filesystem_snapshot_valid(snapshot)
            return false if snapshot.entries.count > snapshot.max_entries or snapshot.path_data.count > snapshot.max_path_bytes or snapshot.content_data.count > snapshot.max_bytes or snapshot.total_bytes > snapshot.max_bytes
            path_bytes: mutable usize = 0
            total_bytes: mutable usize = 0
            for entry in snapshot.entries |snapshot, path_bytes, total_bytes|:
                return false if not differential_filesystem_record_valid(snapshot, entry)
                return false if entry.path_bytes > snapshot.max_path_bytes - path_bytes
                return false if entry.content_bytes > snapshot.max_bytes - total_bytes
                path_bytes <- path_bytes + entry.path_bytes
                total_bytes <- total_bytes + entry.content_bytes
            return false if path_bytes != snapshot.path_data.count or total_bytes != snapshot.total_bytes or total_bytes != snapshot.content_data.count
            return differential_filesystem_entries_path_data_contiguous(snapshot) and differential_filesystem_entries_content_data_contiguous(snapshot)


        def differential_filesystem_entries_ordered(snapshot: DifferentialFilesystemSnapshot&) -> bool:
            for index in 0..<snapshot.entries.count |snapshot|:
                return false if not differential_filesystem_record_valid(snapshot, snapshot.entries[index])
                if index > 0:
                    previous: DifferentialFilesystemEntryRecord = snapshot.entries[index - 1]
                    current: DifferentialFilesystemEntryRecord = snapshot.entries[index]
                    return false if not differential_filesystem_path_spans_less(snapshot.path_data, previous.path_start, previous.path_bytes, snapshot.path_data, current.path_start, current.path_bytes)
            return true


        def differential_filesystem_swap_entries(snapshot: mutable DifferentialFilesystemSnapshot&, left: usize, right: usize) -> void:
            saved: DifferentialFilesystemEntryRecord = snapshot.entries[left]
            snapshot.entries[left] <- snapshot.entries[right]
            snapshot.entries[right] <- saved


        def differential_filesystem_sift_down(snapshot: mutable DifferentialFilesystemSnapshot&, start: usize, end: usize) -> void:
            root: mutable usize = start
            while root < end:
                # EntryLimitExceeded caps end at 1,048,576, so these child-index
                # operations cannot overflow usize on supported targets.
                break if root >= end / 2
                child: mutable usize = root * 2 + 1
                if child + 1 < end:
                    left_child: DifferentialFilesystemEntryRecord = snapshot.entries[child]
                    right_child: DifferentialFilesystemEntryRecord = snapshot.entries[child + 1]
                    child <- child + 1 if differential_filesystem_path_spans_less(snapshot.path_data, left_child.path_start, left_child.path_bytes, snapshot.path_data, right_child.path_start, right_child.path_bytes)
                root_entry: DifferentialFilesystemEntryRecord = snapshot.entries[root]
                child_entry: DifferentialFilesystemEntryRecord = snapshot.entries[child]
                break if not differential_filesystem_path_spans_less(snapshot.path_data, root_entry.path_start, root_entry.path_bytes, snapshot.path_data, child_entry.path_start, child_entry.path_bytes)
                differential_filesystem_swap_entries(snapshot, root, child)
                root <- child


        def differential_filesystem_sort_entries(snapshot: mutable DifferentialFilesystemSnapshot&) -> void:
            # In-place heapsort bounds scratch memory independently of the entry
            # count and produces ascending byte order in O(n log n) comparisons.
            heap_start: mutable usize = snapshot.entries.count / 2
            while heap_start > 0:
                heap_start <- heap_start - 1
                differential_filesystem_sift_down(snapshot, heap_start, snapshot.entries.count)
            heap_end: mutable usize = snapshot.entries.count
            while heap_end > 1:
                differential_filesystem_swap_entries(snapshot, 0, heap_end - 1)
                heap_end <- heap_end - 1
                differential_filesystem_sift_down(snapshot, 0, heap_end)


        def differential_filesystem_hash_entry(hash: u64, snapshot: DifferentialFilesystemSnapshot&, entry: DifferentialFilesystemEntryRecord) -> u64:
            result: mutable u64 = hash
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + entry.kind.u64()
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + entry.content_bytes.u64()
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + entry.mode.u64()
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + (1u64 if entry.executable else 0u64)
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + entry.path_bytes.u64()
            for index in 0..<entry.path_bytes |snapshot, entry, result|:
                result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + snapshot.path_data[entry.path_start + index].u64()
            for index in 0..<entry.content_bytes |snapshot, entry, result|:
                result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + snapshot.content_data[entry.content_start + index].u64()
            return result


        def differential_filesystem_compact_sorted_data(snapshot: mutable DifferentialFilesystemSnapshot&) -> void can[Memory.Allocate, Abort.Panic]:
            compacted_paths: mutable darray[u8] = []
            compacted_content: mutable darray[u8] = []
            compacted_paths.reserve(snapshot.path_data.count)
            compacted_content.reserve(snapshot.content_data.count)
            next_start: mutable usize = 0
            next_content_start: mutable usize = 0
            for index in 0..<snapshot.entries.count |snapshot, compacted_paths, compacted_content, next_start, next_content_start|:
                entry: DifferentialFilesystemEntryRecord = snapshot.entries[index]
                for path_index in 0..<entry.path_bytes |snapshot, entry, compacted_paths|:
                    compacted_paths.push(snapshot.path_data[entry.path_start + path_index])
                for content_index in 0..<entry.content_bytes |snapshot, entry, compacted_content|:
                    compacted_content.push(snapshot.content_data[entry.content_start + content_index])
                snapshot.entries[index].path_start <- next_start
                snapshot.entries[index].content_start <- next_content_start
                next_start <- next_start + entry.path_bytes
                next_content_start <- next_content_start + entry.content_bytes
            # The source arenas already have capacity for these exact byte
            # counts. Refill them in place only after both temporary copies are
            # complete, avoiding ownership aliasing during replacement.
            snapshot.path_data.count <- 0
            for index in 0..<compacted_paths.count:
                snapshot.path_data.push(compacted_paths[index])
            snapshot.content_data.count <- 0
            for index in 0..<compacted_content.count:
                snapshot.content_data.push(compacted_content[index])


        def differential_filesystem_store_entry(snapshot: mutable DifferentialFilesystemSnapshot&, entry: DifferentialFilesystemEntry) -> void can[Memory.Allocate, Abort.Panic]:
            path_length: usize = sview_len(entry.path)
            path_start: usize = snapshot.path_data.count
            content_start: usize = snapshot.content_data.count
            staged_path: mutable darray[u8] = []
            staged_content: mutable darray[u8] = []
            staged_path.reserve(path_length)
            staged_content.reserve(entry.content.count)
            for index in 0..<path_length:
                # Stage before either target reserve: callers may submit a view
                # into this snapshot's own arena, which a reserve can relocate.
                staged_path.push(sview_at(entry.path, index))
            for byte in entry.content:
                # Copy before either target reserve because a caller can pass a
                # value that aliases one of this snapshot's backing arenas.
                staged_content.push(byte)
            # Reserve both arrays before changing either logical count. A failed
            # allocation therefore cannot leave an entry pointing at a partial
            # path copy; allocation failure itself follows Memory.Allocate's
            # Abort.Panic contract.
            snapshot.path_data.reserve(path_start + path_length)
            snapshot.content_data.reserve(content_start + staged_content.count)
            snapshot.entries.reserve(snapshot.entries.count + 1)
            for index in 0..<path_length:
                snapshot.path_data.push(staged_path[index])
            for index in 0..<staged_content.count:
                snapshot.content_data.push(staged_content[index])
            snapshot.entries.push(DifferentialFilesystemEntryRecord{
                path_start: path_start,
                path_bytes: path_length,
                content_start: content_start,
                content_bytes: staged_content.count,
                kind: entry.kind,
                mode: entry.mode,
                executable: entry.executable
            })
            snapshot.total_bytes <- snapshot.total_bytes + staged_content.count


        def differential_filesystem_input_error(entry: DifferentialFilesystemEntry) -> DifferentialFilesystemError:
            return DifferentialFilesystemError.InvalidEntryKind if not differential_filesystem_entry_kind_valid(entry.kind)
            return DifferentialFilesystemError.PathLimitExceeded if sview_len(entry.path) == 0 or sview_len(entry.path) > Limits::PATH_BYTES
            return DifferentialFilesystemError.EmbeddedNul if sview_contains_byte(entry.path, 0)
            return DifferentialFilesystemError.InvalidPath if not differential_filesystem_path_safe(entry.path)
            return DifferentialFilesystemError.InvalidContent if entry.kind == DifferentialFilesystemEntryKind.Directory and entry.content.count != 0
            if entry.kind == DifferentialFilesystemEntryKind.Symlink:
                return DifferentialFilesystemError.InvalidContent if entry.content.count == 0
                for byte in entry.content:
                    return DifferentialFilesystemError.InvalidContent if byte == 0
            return DifferentialFilesystemError.InvalidState


        def differential_filesystem_snapshot_entry_admission(snapshot: DifferentialFilesystemSnapshot&, entry: DifferentialFilesystemEntry) -> DifferentialFilesystemError:
            return DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot) or snapshot.state != DifferentialFilesystemState.Collecting
            return DifferentialFilesystemError.EntryLimitExceeded if snapshot.entries.count >= snapshot.max_entries
            return DifferentialFilesystemError.ByteLimitExceeded if snapshot.total_bytes > snapshot.max_bytes or snapshot.content_data.count > snapshot.max_bytes
            return DifferentialFilesystemError.ByteLimitExceeded if entry.content.count > snapshot.max_bytes - snapshot.total_bytes
            return DifferentialFilesystemError.PathStorageLimitExceeded if snapshot.path_data.count > snapshot.max_path_bytes
            return DifferentialFilesystemError.PathStorageLimitExceeded if sview_len(entry.path) > snapshot.max_path_bytes - snapshot.path_data.count
            return differential_filesystem_input_error(entry)


    public:
        def validate_differential_filesystem_snapshot(snapshot: DifferentialFilesystemSnapshot&) -> bool error[DifferentialFilesystemError]:
            raise DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot)
            raise DifferentialFilesystemError.EntryLimitExceeded if snapshot.entries.count > snapshot.max_entries
            raise DifferentialFilesystemError.ByteLimitExceeded if snapshot.total_bytes > snapshot.max_bytes
            raise DifferentialFilesystemError.ByteLimitExceeded if snapshot.content_data.count > snapshot.max_bytes
            raise DifferentialFilesystemError.PathStorageLimitExceeded if snapshot.path_data.count > snapshot.max_path_bytes
            path_total: mutable usize = 0
            for entry in snapshot.entries:
                raise DifferentialFilesystemError.InvalidEntryKind if not differential_filesystem_entry_kind_valid(entry.kind)
                raise DifferentialFilesystemError.PathLimitExceeded if entry.path_bytes == 0 or entry.path_bytes > Limits::PATH_BYTES
                raise DifferentialFilesystemError.SnapshotAccountingInvalid if entry.path_start > snapshot.path_data.count or entry.path_bytes > snapshot.path_data.count - entry.path_start
                for index in 0..<entry.path_bytes |snapshot, entry|:
                    raise DifferentialFilesystemError.EmbeddedNul if snapshot.path_data[entry.path_start + index] == 0
                raise DifferentialFilesystemError.InvalidPath if not differential_filesystem_path_span_safe(snapshot.path_data, entry.path_start, entry.path_bytes)
                raise DifferentialFilesystemError.SnapshotAccountingInvalid if entry.content_start > snapshot.content_data.count or entry.content_bytes > snapshot.content_data.count - entry.content_start
                raise DifferentialFilesystemError.InvalidContent if entry.kind == DifferentialFilesystemEntryKind.Directory and entry.content_bytes != 0
                raise DifferentialFilesystemError.InvalidContent if entry.kind == DifferentialFilesystemEntryKind.Symlink and (entry.content_bytes == 0 or differential_filesystem_content_span_has_nul(snapshot, entry.content_start, entry.content_bytes))
                raise DifferentialFilesystemError.PathStorageLimitExceeded if entry.path_bytes > snapshot.max_path_bytes - path_total
                path_total <- path_total + entry.path_bytes
            raise DifferentialFilesystemError.EntryOrderInvalid if not differential_filesystem_entries_ordered(snapshot)
            total: mutable usize = 0
            for entry in snapshot.entries:
                raise DifferentialFilesystemError.ByteLimitExceeded if entry.content_bytes > snapshot.max_bytes - total
                total <- total + entry.content_bytes
            raise DifferentialFilesystemError.SnapshotAccountingInvalid if total != snapshot.total_bytes or total != snapshot.content_data.count or path_total != snapshot.path_data.count
            raise DifferentialFilesystemError.SnapshotAccountingInvalid if not differential_filesystem_entries_path_data_contiguous(snapshot) or not differential_filesystem_entries_content_data_contiguous(snapshot)
            return true


        # Admit each record and aggregate counter in O(path length); batch seal
        # performs the full stored-record audit once before sorting.
        def collect_unordered_differential_filesystem_entry(snapshot: mutable DifferentialFilesystemSnapshot&, entry: DifferentialFilesystemEntry) -> void error[DifferentialFilesystemError] can[Memory.Allocate, Abort.Panic]:
            admission_error: DifferentialFilesystemError = differential_filesystem_snapshot_entry_admission(snapshot, entry)
            raise admission_error if admission_error != DifferentialFilesystemError.InvalidState
            raise DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot) or snapshot.state != DifferentialFilesystemState.Collecting
            differential_filesystem_store_entry(snapshot, entry)


        def seal_unordered_differential_filesystem_snapshot(snapshot: mutable DifferentialFilesystemSnapshot&) -> DifferentialFilesystemState error[DifferentialFilesystemError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot) or snapshot.state != DifferentialFilesystemState.Collecting
            raise DifferentialFilesystemError.EntryLimitExceeded if snapshot.entries.count > snapshot.max_entries
            raise DifferentialFilesystemError.ByteLimitExceeded if snapshot.total_bytes > snapshot.max_bytes
            raise DifferentialFilesystemError.ByteLimitExceeded if snapshot.content_data.count > snapshot.max_bytes
            raise DifferentialFilesystemError.PathStorageLimitExceeded if snapshot.path_data.count > snapshot.max_path_bytes
            raise DifferentialFilesystemError.SnapshotAccountingInvalid if not differential_filesystem_snapshot_unordered_records_valid(snapshot)
            raise DifferentialFilesystemError.SnapshotAccountingInvalid if not differential_filesystem_entries_path_data_contiguous(snapshot) or not differential_filesystem_entries_content_data_contiguous(snapshot)
            differential_filesystem_sort_entries(snapshot)
            # Sorting records breaks their append-order adjacency in both data
            # arenas. Repack in sorted record order so the sealed layout retains
            # exact, non-overlapping arena coverage for paths and payloads.
            differential_filesystem_compact_sorted_data(snapshot)
            if not differential_filesystem_entries_ordered(snapshot):
                # At this point every entry is individually valid, so failure can
                # only be a duplicate path. Sorting has mutated the batch; make
                # that terminal outcome explicit rather than leaving a retryable,
                # reordered Collecting snapshot after returning an error.
                snapshot.state <- DifferentialFilesystemState.Failed
                raise DifferentialFilesystemError.EntryOrderInvalid
            snapshot.state <- DifferentialFilesystemState.Sealed
            return snapshot.state


        def advance_differential_filesystem_snapshot(snapshot: mutable DifferentialFilesystemSnapshot&, event: DifferentialFilesystemEvent, entry: DifferentialFilesystemEntry = DifferentialFilesystemEntry{path: ""}) -> DifferentialFilesystemState error[DifferentialFilesystemError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialFilesystemError.InvalidEvent if not differential_filesystem_event_valid(event)
            if event == DifferentialFilesystemEvent.Entry:
                # Appends validate only the new entry and bounded counters. The
                # complete record array is revalidated once at Seal, avoiding an
                # O(n^2) full-prefix scan for large snapshots.
                admission_error: DifferentialFilesystemError = differential_filesystem_snapshot_entry_admission(snapshot, entry)
                raise admission_error if admission_error != DifferentialFilesystemError.InvalidState
                raise DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot) or snapshot.state != DifferentialFilesystemState.Collecting
                if snapshot.entries.count > 0:
                    previous: DifferentialFilesystemEntryRecord = snapshot.entries[snapshot.entries.count - 1]
                    raise DifferentialFilesystemError.InvalidPath if not differential_filesystem_record_valid(snapshot, previous)
                    raise DifferentialFilesystemError.EntryOrderInvalid if not differential_filesystem_input_path_less_record(snapshot, entry.path, previous)
                differential_filesystem_store_entry(snapshot, entry)
                return snapshot.state
            if (event == DifferentialFilesystemEvent.Fail or event == DifferentialFilesystemEvent.Cancel) and snapshot.state == DifferentialFilesystemState.Collecting:
                # Failure and cancellation remain available while an unordered
                # batch is collecting; they need valid records/accounting, but
                # do not require the final sort that sealing performs.
                raise DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot)
                raise DifferentialFilesystemError.EntryLimitExceeded if snapshot.entries.count > snapshot.max_entries
                raise DifferentialFilesystemError.ByteLimitExceeded if snapshot.total_bytes > snapshot.max_bytes or snapshot.content_data.count > snapshot.max_bytes
                raise DifferentialFilesystemError.PathStorageLimitExceeded if snapshot.path_data.count > snapshot.max_path_bytes
                raise DifferentialFilesystemError.SnapshotAccountingInvalid if not differential_filesystem_snapshot_unordered_records_valid(snapshot) or not differential_filesystem_entries_path_data_contiguous(snapshot) or not differential_filesystem_entries_content_data_contiguous(snapshot)
            else:
                try validate_differential_filesystem_snapshot(snapshot)
            if event == DifferentialFilesystemEvent.Begin:
                raise DifferentialFilesystemError.InvalidState if snapshot.state != DifferentialFilesystemState.Planned
                snapshot.state <- DifferentialFilesystemState.Collecting
            elif event == DifferentialFilesystemEvent.Seal:
                raise DifferentialFilesystemError.InvalidState if snapshot.state != DifferentialFilesystemState.Collecting
                snapshot.state <- DifferentialFilesystemState.Sealed
            elif event == DifferentialFilesystemEvent.Fail:
                raise DifferentialFilesystemError.InvalidState if snapshot.state != DifferentialFilesystemState.Collecting
                snapshot.state <- DifferentialFilesystemState.Failed
            elif event == DifferentialFilesystemEvent.Cancel:
                raise DifferentialFilesystemError.CancelNotReady if snapshot.state != DifferentialFilesystemState.Planned and snapshot.state != DifferentialFilesystemState.Collecting
                snapshot.state <- DifferentialFilesystemState.Cancelled
            return snapshot.state


        def differential_filesystem_snapshot_fingerprint(snapshot: DifferentialFilesystemSnapshot&) -> u64:
            return 0 if not differential_filesystem_snapshot_valid(snapshot) or not differential_filesystem_snapshot_unordered_records_valid(snapshot) or not differential_filesystem_entries_ordered(snapshot) or snapshot.state != DifferentialFilesystemState.Sealed
            result: mutable u64 = DIFFERENTIAL_FILESYSTEM_HASH_OFFSET
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + snapshot.entries.count.u64()
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + snapshot.total_bytes.u64()
            for entry in snapshot.entries |snapshot, result|:
                result <- differential_filesystem_hash_entry(result, snapshot, entry)
            return result


        def compare_differential_filesystem_snapshots(reference: DifferentialFilesystemSnapshot&, candidate: DifferentialFilesystemSnapshot&) -> DifferentialFilesystemDifference:
            return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.SnapshotNotSealed, reason: "filesystem snapshots must be sealed before comparison"} if reference.state != DifferentialFilesystemState.Sealed or candidate.state != DifferentialFilesystemState.Sealed
            return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.InvalidSnapshot, reason: "filesystem snapshot validation failed"} if not differential_filesystem_snapshot_valid(reference) or not differential_filesystem_snapshot_valid(candidate) or not differential_filesystem_snapshot_unordered_records_valid(reference) or not differential_filesystem_snapshot_unordered_records_valid(candidate) or not differential_filesystem_entries_ordered(reference) or not differential_filesystem_entries_ordered(candidate)
            reference_index: mutable usize = 0
            candidate_index: mutable usize = 0
            while reference_index < reference.entries.count or candidate_index < candidate.entries.count:
                if reference_index >= reference.entries.count:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.MissingReference, index: candidate_index, has_candidate_entry: true, candidate_entry_index: candidate_index, reason: "candidate created a filesystem entry"}
                if candidate_index >= candidate.entries.count:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.MissingCandidate, index: reference_index, has_reference_entry: true, reference_entry_index: reference_index, reason: "candidate omitted a filesystem entry"}
                reference_entry: DifferentialFilesystemEntryRecord = reference.entries[reference_index]
                candidate_entry: DifferentialFilesystemEntryRecord = candidate.entries[candidate_index]
                if differential_filesystem_path_spans_less(reference.path_data, reference_entry.path_start, reference_entry.path_bytes, candidate.path_data, candidate_entry.path_start, candidate_entry.path_bytes):
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.MissingCandidate, index: reference_index, has_reference_entry: true, reference_entry_index: reference_index, has_candidate_entry: true, candidate_entry_index: candidate_index, reason: "candidate omitted a filesystem entry"}
                if differential_filesystem_path_spans_less(candidate.path_data, candidate_entry.path_start, candidate_entry.path_bytes, reference.path_data, reference_entry.path_start, reference_entry.path_bytes):
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.MissingReference, index: candidate_index, has_reference_entry: true, reference_entry_index: reference_index, has_candidate_entry: true, candidate_entry_index: candidate_index, reason: "candidate created a filesystem entry"}
                if reference_entry.kind != candidate_entry.kind:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.Kind, index: reference_index, has_reference_entry: true, reference_entry_index: reference_index, has_candidate_entry: true, candidate_entry_index: candidate_index, reason: "filesystem entry kind differs"}
                if reference_entry.content_bytes != candidate_entry.content_bytes:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.Size, index: reference_index, has_reference_entry: true, reference_entry_index: reference_index, has_candidate_entry: true, candidate_entry_index: candidate_index, reason: "filesystem entry size differs"}
                content_index: mutable usize = 0
                while content_index < reference_entry.content_bytes:
                    if reference.content_data[reference_entry.content_start + content_index] != candidate.content_data[candidate_entry.content_start + content_index]:
                        return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.Content, index: reference_index, has_reference_entry: true, reference_entry_index: reference_index, has_candidate_entry: true, candidate_entry_index: candidate_index, reason: "filesystem entry bytes differ"}
                    content_index <- content_index + 1
                if reference_entry.mode != candidate_entry.mode:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.Mode, index: reference_index, has_reference_entry: true, reference_entry_index: reference_index, has_candidate_entry: true, candidate_entry_index: candidate_index, reason: "filesystem entry mode differs"}
                if reference_entry.executable != candidate_entry.executable:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.Executable, index: reference_index, has_reference_entry: true, reference_entry_index: reference_index, has_candidate_entry: true, candidate_entry_index: candidate_index, reason: "filesystem entry executable bit differs"}
                reference_index <- reference_index + 1
                candidate_index <- candidate_index + 1
            return DifferentialFilesystemDifference{equal: true, kind: DifferentialFilesystemDifferenceKind.Equal, reason: "filesystem snapshots are equal"}


        def copy_differential_filesystem_entry_path(snapshot: DifferentialFilesystemSnapshot&, entry_index: usize) -> darray[u8] error[DifferentialFilesystemError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialFilesystemError.SnapshotNotSealed if snapshot.state != DifferentialFilesystemState.Sealed
            try validate_differential_filesystem_snapshot(snapshot)
            raise DifferentialFilesystemError.EntryIndexOutOfBounds if entry_index >= snapshot.entries.count
            entry: DifferentialFilesystemEntryRecord = snapshot.entries[entry_index]
            raise DifferentialFilesystemError.PathLimitExceeded if entry.path_bytes == 0 or entry.path_bytes > Limits::PATH_BYTES
            raise DifferentialFilesystemError.SnapshotAccountingInvalid if entry.path_start > snapshot.path_data.count or entry.path_bytes > snapshot.path_data.count - entry.path_start
            raise DifferentialFilesystemError.InvalidPath if not differential_filesystem_path_span_safe(snapshot.path_data, entry.path_start, entry.path_bytes)
            copied: mutable darray[u8] = []
            copied.reserve(entry.path_bytes)
            for index in 0..<entry.path_bytes |snapshot, entry, copied|:
                copied.push(snapshot.path_data[entry.path_start + index])
            return copied


        # For files this returns file bytes; for symlinks it returns the raw
        # target bytes. Directories return an empty array.
        def copy_differential_filesystem_entry_content(snapshot: DifferentialFilesystemSnapshot&, entry_index: usize) -> darray[u8] error[DifferentialFilesystemError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialFilesystemError.SnapshotNotSealed if snapshot.state != DifferentialFilesystemState.Sealed
            try validate_differential_filesystem_snapshot(snapshot)
            raise DifferentialFilesystemError.EntryIndexOutOfBounds if entry_index >= snapshot.entries.count
            entry: DifferentialFilesystemEntryRecord = snapshot.entries[entry_index]
            raise DifferentialFilesystemError.SnapshotAccountingInvalid if not differential_filesystem_content_span_valid(snapshot, entry.content_start, entry.content_bytes)
            copied: mutable darray[u8] = []
            copied.reserve(entry.content_bytes)
            for index in 0..<entry.content_bytes |snapshot, entry, copied|:
                copied.push(snapshot.content_data[entry.content_start + index])
            return copied
