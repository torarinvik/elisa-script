# Bounded post-run filesystem snapshot and comparison contract.
#
# Differential adapters materialize a world before execution and may collect a
# relative file-tree snapshot after execution. This module keeps that result
# typed and deterministic: entries are path-ordered either as they arrive or by
# an explicit bounded batch seal, aggregate path/content sizes are capped,
# snapshots must be sealed before comparison, and the first difference is
# reported without performing host filesystem I/O. Entry paths are borrowed
# views; callers retain their backing bytes for the snapshot lifetime.

module EsDifferentialFilesystem:
    public:
        const module Limits:
            ENTRIES: usize = 1048576
            PATH_BYTES: usize = 4096
            PATH_STORAGE_BYTES: usize = 67108864
            TOTAL_BYTES: usize = 268435456


        const enum DifferentialFilesystemEntryKind of u8:
            File
            Directory
            Symlink


        const enum DifferentialFilesystemState of u8:
            Planned
            Collecting
            Sealed
            Failed
            Cancelled


        const enum DifferentialFilesystemEvent of u8:
            Begin
            Entry
            Seal
            Fail
            Cancel


        struct DifferentialFilesystemEntry:
            path: sview
            kind: DifferentialFilesystemEntryKind = DifferentialFilesystemEntryKind.File
            content_fingerprint: u64 = 1
            size: usize = 0
            mode: u32 = 0
            executable: bool = false


        struct DifferentialFilesystemSnapshot:
            max_entries: usize = Limits::ENTRIES
            max_path_bytes: usize = Limits::PATH_STORAGE_BYTES
            max_bytes: usize = Limits::TOTAL_BYTES
            state: DifferentialFilesystemState = DifferentialFilesystemState.Planned
            entries: darray[DifferentialFilesystemEntry] = []
            path_bytes: usize = 0
            total_bytes: usize = 0


        const enum DifferentialFilesystemDifferenceKind of u8:
            Equal
            SnapshotNotSealed
            EntryLimit
            MissingReference
            MissingCandidate
            Kind
            Content
            Size
            Mode
            Executable


        struct DifferentialFilesystemDifference:
            equal: bool
            kind: DifferentialFilesystemDifferenceKind
            index: usize = 0
            reference_path: sview = ""
            candidate_path: sview = ""
            reason: sview = ""


        error DifferentialFilesystemError:
            InvalidState
            InvalidEvent
            InvalidEntryKind
            InvalidPath
            EmbeddedNul
            PathLimitExceeded
            PathStorageLimitExceeded
            EntryLimitExceeded
            ByteLimitExceeded
            EntryOrderInvalid
            SnapshotAccountingInvalid
            SnapshotNotSealed
            ComparisonInvalid
            CancelNotReady


    private:
        const DIFFERENTIAL_FILESYSTEM_HASH_OFFSET: u64 = 14695981039346656037
        const DIFFERENTIAL_FILESYSTEM_HASH_PRIME: u64 = 1099511628211


        def differential_filesystem_state_valid(state: DifferentialFilesystemState) -> bool:
            return state in {DifferentialFilesystemState.Planned, DifferentialFilesystemState.Collecting, DifferentialFilesystemState.Sealed, DifferentialFilesystemState.Failed, DifferentialFilesystemState.Cancelled}


        def differential_filesystem_event_valid(event: DifferentialFilesystemEvent) -> bool:
            return event in {DifferentialFilesystemEvent.Begin, DifferentialFilesystemEvent.Entry, DifferentialFilesystemEvent.Seal, DifferentialFilesystemEvent.Fail, DifferentialFilesystemEvent.Cancel}


        def differential_filesystem_entry_kind_valid(kind: DifferentialFilesystemEntryKind) -> bool:
            return kind in {DifferentialFilesystemEntryKind.File, DifferentialFilesystemEntryKind.Directory, DifferentialFilesystemEntryKind.Symlink}


        def differential_filesystem_difference_kind_valid(kind: DifferentialFilesystemDifferenceKind) -> bool:
            return kind in {DifferentialFilesystemDifferenceKind.Equal, DifferentialFilesystemDifferenceKind.SnapshotNotSealed, DifferentialFilesystemDifferenceKind.EntryLimit, DifferentialFilesystemDifferenceKind.MissingReference, DifferentialFilesystemDifferenceKind.MissingCandidate, DifferentialFilesystemDifferenceKind.Kind, DifferentialFilesystemDifferenceKind.Content, DifferentialFilesystemDifferenceKind.Size, DifferentialFilesystemDifferenceKind.Mode, DifferentialFilesystemDifferenceKind.Executable}


        def differential_filesystem_text_less(left: sview, right: sview) -> bool:
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            shared: usize = left_length if left_length < right_length else right_length
            index: usize = 0
            while index < shared:
                return sview_at(left, index) < sview_at(right, index) if sview_at(left, index) != sview_at(right, index)
                index <- index + 1
            return left_length < right_length


        def differential_filesystem_path_safe(path: sview) -> bool:
            length: usize = sview_len(path)
            return false if length == 0 or length > Limits::PATH_BYTES or sview_contains_byte(path, 0) or sview_at(path, 0) == 47 or sview_at(path, 0) == 92
            segment_start: mutable usize = 0
            index: mutable usize = 0
            while index <= length:
                at_end: bool = index == length
                separator: bool = not at_end and (sview_at(path, index) == 47 or sview_at(path, index) == 92)
                if at_end or separator:
                    return false if index == segment_start
                    segment_length: usize = index - segment_start
                    return false if segment_length == 1 and sview_at(path, segment_start) == 46
                    return false if segment_length == 2 and sview_at(path, segment_start) == 46 and sview_at(path, segment_start + 1) == 46
                    segment_start <- index + 1
                index <- index + 1
            return true


        def differential_filesystem_entry_valid(entry: DifferentialFilesystemEntry) -> bool:
            return differential_filesystem_entry_kind_valid(entry.kind) and differential_filesystem_path_safe(entry.path) and entry.content_fingerprint != 0


        def differential_filesystem_snapshot_valid(snapshot: DifferentialFilesystemSnapshot&) -> bool:
            return differential_filesystem_state_valid(snapshot.state) and snapshot.max_entries != 0 and snapshot.max_entries <= Limits::ENTRIES and snapshot.max_path_bytes != 0 and snapshot.max_path_bytes <= Limits::PATH_STORAGE_BYTES and snapshot.max_bytes != 0 and snapshot.max_bytes <= Limits::TOTAL_BYTES


        def differential_filesystem_snapshot_unordered_records_valid(snapshot: DifferentialFilesystemSnapshot&) -> bool:
            return false if not differential_filesystem_snapshot_valid(snapshot)
            return false if snapshot.entries.count > snapshot.max_entries or snapshot.path_bytes > snapshot.max_path_bytes or snapshot.total_bytes > snapshot.max_bytes
            path_bytes: mutable usize = 0
            total_bytes: mutable usize = 0
            for entry in snapshot.entries |snapshot, path_bytes, total_bytes|:
                return false if not differential_filesystem_entry_valid(entry)
                entry_path_bytes: usize = sview_len(entry.path)
                return false if entry_path_bytes > snapshot.max_path_bytes - path_bytes
                return false if entry.size > snapshot.max_bytes - total_bytes
                path_bytes <- path_bytes + entry_path_bytes
                total_bytes <- total_bytes + entry.size
            return path_bytes == snapshot.path_bytes and total_bytes == snapshot.total_bytes


        def differential_filesystem_entries_ordered(entries: darray[DifferentialFilesystemEntry]&) -> bool:
            for index in 0..<entries.count |entries|:
                return false if not differential_filesystem_entry_valid(entries[index])
                if index > 0:
                    return false if not differential_filesystem_text_less(entries[index - 1].path, entries[index].path)
            return true


        def differential_filesystem_swap_entries(entries: mutable darray[DifferentialFilesystemEntry]&, left: usize, right: usize) -> void:
            saved: DifferentialFilesystemEntry = entries[left]
            entries[left] <- entries[right]
            entries[right] <- saved


        def differential_filesystem_sift_down(entries: mutable darray[DifferentialFilesystemEntry]&, start: usize, end: usize) -> void:
            root: mutable usize = start
            while root < end:
                # EntryLimitExceeded caps end at 1,048,576, so these child-index
                # operations cannot overflow usize on supported targets.
                break if root >= end / 2
                child: mutable usize = root * 2 + 1
                if child + 1 < end and differential_filesystem_text_less(entries[child].path, entries[child + 1].path):
                    child <- child + 1
                break if not differential_filesystem_text_less(entries[root].path, entries[child].path)
                differential_filesystem_swap_entries(entries, root, child)
                root <- child


        def differential_filesystem_sort_entries(entries: mutable darray[DifferentialFilesystemEntry]&) -> void:
            # In-place heapsort bounds scratch memory independently of the entry
            # count and produces ascending byte order in O(n log n) comparisons.
            heap_start: mutable usize = entries.count / 2
            while heap_start > 0:
                heap_start <- heap_start - 1
                differential_filesystem_sift_down(entries, heap_start, entries.count)
            heap_end: mutable usize = entries.count
            while heap_end > 1:
                differential_filesystem_swap_entries(entries, 0, heap_end - 1)
                heap_end <- heap_end - 1
                differential_filesystem_sift_down(entries, 0, heap_end)


        def differential_filesystem_hash_entry(hash: u64, entry: DifferentialFilesystemEntry) -> u64:
            result: mutable u64 = hash
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + entry.kind.u64()
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + entry.content_fingerprint
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + entry.size.u64()
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + entry.mode.u64()
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + (1u64 if entry.executable else 0u64)
            for index in 0..<sview_len(entry.path) |entry, result|:
                result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + sview_at(entry.path, index).u64()
            return result


    public:
        def validate_differential_filesystem_snapshot(snapshot: DifferentialFilesystemSnapshot&) -> bool error[DifferentialFilesystemError]:
            raise DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot)
            raise DifferentialFilesystemError.EntryLimitExceeded if snapshot.entries.count > snapshot.max_entries
            raise DifferentialFilesystemError.ByteLimitExceeded if snapshot.total_bytes > snapshot.max_bytes
            raise DifferentialFilesystemError.PathStorageLimitExceeded if snapshot.path_bytes > snapshot.max_path_bytes
            for entry in snapshot.entries:
                raise DifferentialFilesystemError.InvalidEntryKind if not differential_filesystem_entry_kind_valid(entry.kind)
                raise DifferentialFilesystemError.PathLimitExceeded if sview_len(entry.path) == 0 or sview_len(entry.path) > Limits::PATH_BYTES
                raise DifferentialFilesystemError.EmbeddedNul if sview_contains_byte(entry.path, 0)
                raise DifferentialFilesystemError.InvalidPath if not differential_filesystem_path_safe(entry.path)
                raise DifferentialFilesystemError.InvalidPath if entry.content_fingerprint == 0
            raise DifferentialFilesystemError.EntryOrderInvalid if not differential_filesystem_entries_ordered(snapshot.entries)
            total: mutable usize = 0
            path_total: mutable usize = 0
            for entry in snapshot.entries:
                raise DifferentialFilesystemError.ByteLimitExceeded if entry.size > snapshot.max_bytes - total
                raise DifferentialFilesystemError.PathStorageLimitExceeded if sview_len(entry.path) > snapshot.max_path_bytes - path_total
                total <- total + entry.size
                path_total <- path_total + sview_len(entry.path)
            raise DifferentialFilesystemError.SnapshotAccountingInvalid if total != snapshot.total_bytes or path_total != snapshot.path_bytes
            return true


        # Admit each record and aggregate counter in O(path length); batch seal
        # performs the full stored-record audit once before sorting.
        def collect_unordered_differential_filesystem_entry(snapshot: mutable DifferentialFilesystemSnapshot&, entry: DifferentialFilesystemEntry) -> void error[DifferentialFilesystemError]:
            raise DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot) or snapshot.state != DifferentialFilesystemState.Collecting
            raise DifferentialFilesystemError.EntryLimitExceeded if snapshot.entries.count >= snapshot.max_entries
            raise DifferentialFilesystemError.ByteLimitExceeded if snapshot.total_bytes > snapshot.max_bytes
            raise DifferentialFilesystemError.PathStorageLimitExceeded if snapshot.path_bytes > snapshot.max_path_bytes
            raise DifferentialFilesystemError.InvalidEntryKind if not differential_filesystem_entry_kind_valid(entry.kind)
            raise DifferentialFilesystemError.PathLimitExceeded if sview_len(entry.path) == 0 or sview_len(entry.path) > Limits::PATH_BYTES
            raise DifferentialFilesystemError.EmbeddedNul if sview_contains_byte(entry.path, 0)
            raise DifferentialFilesystemError.InvalidPath if not differential_filesystem_path_safe(entry.path)
            raise DifferentialFilesystemError.InvalidPath if entry.content_fingerprint == 0
            raise DifferentialFilesystemError.ByteLimitExceeded if entry.size > snapshot.max_bytes - snapshot.total_bytes
            raise DifferentialFilesystemError.PathStorageLimitExceeded if sview_len(entry.path) > snapshot.max_path_bytes - snapshot.path_bytes
            snapshot.entries.push(entry)
            snapshot.total_bytes <- snapshot.total_bytes + entry.size
            snapshot.path_bytes <- snapshot.path_bytes + sview_len(entry.path)


        def seal_unordered_differential_filesystem_snapshot(snapshot: mutable DifferentialFilesystemSnapshot&) -> DifferentialFilesystemState error[DifferentialFilesystemError]:
            raise DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot) or snapshot.state != DifferentialFilesystemState.Collecting
            raise DifferentialFilesystemError.EntryLimitExceeded if snapshot.entries.count > snapshot.max_entries
            raise DifferentialFilesystemError.ByteLimitExceeded if snapshot.total_bytes > snapshot.max_bytes
            raise DifferentialFilesystemError.PathStorageLimitExceeded if snapshot.path_bytes > snapshot.max_path_bytes
            raise DifferentialFilesystemError.SnapshotAccountingInvalid if not differential_filesystem_snapshot_unordered_records_valid(snapshot)
            differential_filesystem_sort_entries(snapshot.entries)
            if not differential_filesystem_entries_ordered(snapshot.entries):
                # At this point every entry is individually valid, so failure can
                # only be a duplicate path. Sorting has mutated the batch; make
                # that terminal outcome explicit rather than leaving a retryable,
                # reordered Collecting snapshot after returning an error.
                snapshot.state <- DifferentialFilesystemState.Failed
                raise DifferentialFilesystemError.EntryOrderInvalid
            snapshot.state <- DifferentialFilesystemState.Sealed
            return snapshot.state


        def advance_differential_filesystem_snapshot(snapshot: mutable DifferentialFilesystemSnapshot&, event: DifferentialFilesystemEvent, entry: DifferentialFilesystemEntry = DifferentialFilesystemEntry{path: ""}) -> DifferentialFilesystemState error[DifferentialFilesystemError]:
            raise DifferentialFilesystemError.InvalidEvent if not differential_filesystem_event_valid(event)
            if event == DifferentialFilesystemEvent.Entry:
                # Appends validate only the new entry and bounded counters. The
                # complete record array is revalidated once at Seal, avoiding an
                # O(n^2) full-prefix scan for large snapshots.
                raise DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot) or snapshot.state != DifferentialFilesystemState.Collecting
                raise DifferentialFilesystemError.EntryLimitExceeded if snapshot.entries.count >= snapshot.max_entries
                raise DifferentialFilesystemError.ByteLimitExceeded if snapshot.total_bytes > snapshot.max_bytes
                raise DifferentialFilesystemError.PathStorageLimitExceeded if snapshot.path_bytes > snapshot.max_path_bytes
                raise DifferentialFilesystemError.InvalidEntryKind if not differential_filesystem_entry_kind_valid(entry.kind)
                raise DifferentialFilesystemError.PathLimitExceeded if sview_len(entry.path) == 0 or sview_len(entry.path) > Limits::PATH_BYTES
                raise DifferentialFilesystemError.EmbeddedNul if sview_contains_byte(entry.path, 0)
                raise DifferentialFilesystemError.InvalidPath if not differential_filesystem_path_safe(entry.path)
                raise DifferentialFilesystemError.InvalidPath if entry.content_fingerprint == 0
                if snapshot.entries.count > 0:
                    previous: DifferentialFilesystemEntry = snapshot.entries[snapshot.entries.count - 1]
                    raise DifferentialFilesystemError.InvalidEntryKind if not differential_filesystem_entry_kind_valid(previous.kind)
                    raise DifferentialFilesystemError.PathLimitExceeded if sview_len(previous.path) == 0 or sview_len(previous.path) > Limits::PATH_BYTES
                    raise DifferentialFilesystemError.EmbeddedNul if sview_contains_byte(previous.path, 0)
                    raise DifferentialFilesystemError.InvalidPath if not differential_filesystem_path_safe(previous.path) or previous.content_fingerprint == 0
                    raise DifferentialFilesystemError.EntryOrderInvalid if not differential_filesystem_text_less(previous.path, entry.path)
                raise DifferentialFilesystemError.ByteLimitExceeded if entry.size > snapshot.max_bytes - snapshot.total_bytes
                raise DifferentialFilesystemError.PathStorageLimitExceeded if sview_len(entry.path) > snapshot.max_path_bytes - snapshot.path_bytes
                snapshot.entries.push(entry)
                snapshot.total_bytes <- snapshot.total_bytes + entry.size
                snapshot.path_bytes <- snapshot.path_bytes + sview_len(entry.path)
                return snapshot.state
            if (event == DifferentialFilesystemEvent.Fail or event == DifferentialFilesystemEvent.Cancel) and snapshot.state == DifferentialFilesystemState.Collecting:
                # Failure and cancellation remain available while an unordered
                # batch is collecting; they need valid records/accounting, but
                # do not require the final sort that sealing performs.
                raise DifferentialFilesystemError.InvalidState if not differential_filesystem_snapshot_valid(snapshot)
                raise DifferentialFilesystemError.EntryLimitExceeded if snapshot.entries.count > snapshot.max_entries
                raise DifferentialFilesystemError.ByteLimitExceeded if snapshot.total_bytes > snapshot.max_bytes
                raise DifferentialFilesystemError.PathStorageLimitExceeded if snapshot.path_bytes > snapshot.max_path_bytes
                raise DifferentialFilesystemError.SnapshotAccountingInvalid if not differential_filesystem_snapshot_unordered_records_valid(snapshot)
            else:
                try validate_differential_filesystem_snapshot(snapshot)
            if event == DifferentialFilesystemEvent.Begin:
                raise DifferentialFilesystemError.InvalidState if snapshot.state != DifferentialFilesystemState.Planned
                snapshot.state <- DifferentialFilesystemState.Collecting
            elif event == DifferentialFilesystemEvent.Seal:
                raise DifferentialFilesystemError.InvalidState if snapshot.state != DifferentialFilesystemState.Collecting
                snapshot.state <- DifferentialFilesystemState.Sealed
            elif event == DifferentialFilesystemEvent.Fail:
                raise DifferentialFilesystemError.InvalidState if snapshot.state != DifferentialFilesystemState.Collecting
                snapshot.state <- DifferentialFilesystemState.Failed
            elif event == DifferentialFilesystemEvent.Cancel:
                raise DifferentialFilesystemError.CancelNotReady if snapshot.state != DifferentialFilesystemState.Planned and snapshot.state != DifferentialFilesystemState.Collecting
                snapshot.state <- DifferentialFilesystemState.Cancelled
            return snapshot.state


        def differential_filesystem_snapshot_fingerprint(snapshot: DifferentialFilesystemSnapshot&) -> u64 can[Memory.Allocate, Abort.Panic]:
            return 0 if not differential_filesystem_snapshot_valid(snapshot) or not differential_filesystem_snapshot_unordered_records_valid(snapshot) or not differential_filesystem_entries_ordered(snapshot.entries) or snapshot.state != DifferentialFilesystemState.Sealed
            result: mutable u64 = DIFFERENTIAL_FILESYSTEM_HASH_OFFSET
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + snapshot.entries.count.u64()
            result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME + snapshot.total_bytes.u64()
            for entry in snapshot.entries |result|:
                result <- differential_filesystem_hash_entry(result, entry)
            return result


        def compare_differential_filesystem_snapshots(reference: DifferentialFilesystemSnapshot&, candidate: DifferentialFilesystemSnapshot&) -> DifferentialFilesystemDifference:
            return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.SnapshotNotSealed, reason: "filesystem snapshots must be sealed before comparison"} if reference.state != DifferentialFilesystemState.Sealed or candidate.state != DifferentialFilesystemState.Sealed
            return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.EntryLimit, reason: "filesystem snapshot validation failed"} if not differential_filesystem_snapshot_valid(reference) or not differential_filesystem_snapshot_valid(candidate) or not differential_filesystem_snapshot_unordered_records_valid(reference) or not differential_filesystem_snapshot_unordered_records_valid(candidate) or not differential_filesystem_entries_ordered(reference.entries) or not differential_filesystem_entries_ordered(candidate.entries)
            reference_index: mutable usize = 0
            candidate_index: mutable usize = 0
            while reference_index < reference.entries.count or candidate_index < candidate.entries.count:
                if reference_index >= reference.entries.count:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.MissingReference, index: candidate_index, candidate_path: candidate.entries[candidate_index].path, reason: "candidate created a filesystem entry"}
                if candidate_index >= candidate.entries.count:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.MissingCandidate, index: reference_index, reference_path: reference.entries[reference_index].path, reason: "candidate omitted a filesystem entry"}
                reference_entry: DifferentialFilesystemEntry = reference.entries[reference_index]
                candidate_entry: DifferentialFilesystemEntry = candidate.entries[candidate_index]
                if differential_filesystem_text_less(reference_entry.path, candidate_entry.path):
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.MissingCandidate, index: reference_index, reference_path: reference_entry.path, candidate_path: candidate_entry.path, reason: "candidate omitted a filesystem entry"}
                if differential_filesystem_text_less(candidate_entry.path, reference_entry.path):
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.MissingReference, index: candidate_index, reference_path: reference_entry.path, candidate_path: candidate_entry.path, reason: "candidate created a filesystem entry"}
                if reference_entry.kind != candidate_entry.kind:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.Kind, index: reference_index, reference_path: reference_entry.path, candidate_path: candidate_entry.path, reason: "filesystem entry kind differs"}
                if reference_entry.content_fingerprint != candidate_entry.content_fingerprint:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.Content, index: reference_index, reference_path: reference_entry.path, candidate_path: candidate_entry.path, reason: "filesystem entry content differs"}
                if reference_entry.size != candidate_entry.size:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.Size, index: reference_index, reference_path: reference_entry.path, candidate_path: candidate_entry.path, reason: "filesystem entry size differs"}
                if reference_entry.mode != candidate_entry.mode:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.Mode, index: reference_index, reference_path: reference_entry.path, candidate_path: candidate_entry.path, reason: "filesystem entry mode differs"}
                if reference_entry.executable != candidate_entry.executable:
                    return DifferentialFilesystemDifference{equal: false, kind: DifferentialFilesystemDifferenceKind.Executable, index: reference_index, reference_path: reference_entry.path, candidate_path: candidate_entry.path, reason: "filesystem entry executable bit differs"}
                reference_index <- reference_index + 1
                candidate_index <- candidate_index + 1
            return DifferentialFilesystemDifference{equal: true, kind: DifferentialFilesystemDifferenceKind.Equal, reason: "filesystem snapshots are equal"}
