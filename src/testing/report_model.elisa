# Typed machine-readable differential reports.
#
# Report rendering is deliberately separate from comparison and process
# execution. Human, JSON, and JUnit adapters must consume this validated record
# rather than infer a failure category from free-form text or exit status.

module EsDifferentialReport:
    using EsDifferentialStability
    using EsEncoding

    public:
        const module Limits:
            TEXT_BYTES: usize = 1048576
            TOTAL_TEXT_BYTES: usize = 4194304
            MESSAGES: usize = 256
            REPEATS: usize = 1024


        const enum DifferentialReportFormat of u8:
            Human
            Json
            Junit


        const enum DifferentialReportStatus of u8:
            Passed
            Failed
            Skipped
            Inconclusive


        const enum DifferentialReportCategory of u8:
            None
            ValueMismatch
            ErrorMismatch
            ObservationMismatch
            ProcessFailure
            Timeout
            Crash
            ArtifactFailure
            InvalidInput
            InfrastructureFailure
            Flaky


        const enum DifferentialReportDifferenceKind of u8:
            Unavailable
            Equal
            Engine
            ExitStatus
            Error
            Stdout
            Stderr
            ReturnValue
            ObservationCount
            ObservationTrace
            ObservationValue
            Outcome
            CaseInvalid
            ObservationContract


        struct DifferentialReport:
            format: DifferentialReportFormat = DifferentialReportFormat.Json
            status: DifferentialReportStatus = DifferentialReportStatus.Passed
            category: DifferentialReportCategory = DifferentialReportCategory.None
            comparison_kind: DifferentialReportDifferenceKind = DifferentialReportDifferenceKind.Unavailable
            comparison_index: u32 = 0
            case_name: sview
            summary: sview
            reference_engine: sview
            candidate_engine: sview
            reference_detail: sview = ""
            candidate_detail: sview = ""
            reference_detail_omitted: bool = false
            candidate_detail_omitted: bool = false
            artifact_path: sview = ""
            repeat_count: usize = 1
            deterministic: bool = true
            has_stability_evidence: bool = false
            stability_evidence: DifferentialStabilitySession = DifferentialStabilitySession{}
            messages: darray[sview] = []


        error DifferentialReportError:
            InvalidFormat
            InvalidStatus
            InvalidCategory
            InvalidComparisonKind
            MissingCaseName
            SummaryInvalid
            EngineIdentityInvalid
            ArtifactPathInvalid
            TextLimitExceeded
            EmbeddedNul
            MessageLimitExceeded
            RepeatCountInvalid
            MessageVectorMalformed
            AggregateTextLimitExceeded
            InvalidUtf8
            StatusCategoryMismatch
            ComparisonStatusMismatch
            NondeterministicPass
            NondeterministicClaimInvalid
            FlakyEvidenceInvalid
            StabilityEvidenceInvalid
            DetailOmissionInvalid


    private:
        def differential_report_format_valid(format: DifferentialReportFormat) -> bool:
            return format in {DifferentialReportFormat.Human, DifferentialReportFormat.Json, DifferentialReportFormat.Junit}


        def differential_report_status_valid(status: DifferentialReportStatus) -> bool:
            return status in {DifferentialReportStatus.Passed, DifferentialReportStatus.Failed, DifferentialReportStatus.Skipped, DifferentialReportStatus.Inconclusive}


        def differential_report_category_valid(category: DifferentialReportCategory) -> bool:
            return category in {DifferentialReportCategory.None, DifferentialReportCategory.ValueMismatch, DifferentialReportCategory.ErrorMismatch, DifferentialReportCategory.ObservationMismatch, DifferentialReportCategory.ProcessFailure, DifferentialReportCategory.Timeout, DifferentialReportCategory.Crash, DifferentialReportCategory.ArtifactFailure, DifferentialReportCategory.InvalidInput, DifferentialReportCategory.InfrastructureFailure, DifferentialReportCategory.Flaky}


        def differential_report_difference_kind_valid(kind: DifferentialReportDifferenceKind) -> bool:
            return kind in {DifferentialReportDifferenceKind.Unavailable, DifferentialReportDifferenceKind.Equal, DifferentialReportDifferenceKind.Engine, DifferentialReportDifferenceKind.ExitStatus, DifferentialReportDifferenceKind.Error, DifferentialReportDifferenceKind.Stdout, DifferentialReportDifferenceKind.Stderr, DifferentialReportDifferenceKind.ReturnValue, DifferentialReportDifferenceKind.ObservationCount, DifferentialReportDifferenceKind.ObservationTrace, DifferentialReportDifferenceKind.ObservationValue, DifferentialReportDifferenceKind.Outcome, DifferentialReportDifferenceKind.CaseInvalid, DifferentialReportDifferenceKind.ObservationContract}


        def differential_report_text_length_valid(value: sview) -> bool:
            return sview_len(value) < Limits::TEXT_BYTES


        def differential_report_text_total_add_fits(total: mutable usize&, value: sview) -> bool:
            length: usize = sview_len(value)
            return false if total > Limits::TOTAL_TEXT_BYTES
            return false if length > Limits::TOTAL_TEXT_BYTES - total
            total <- total + length
            return true


        def differential_report_text_utf8_valid(value: sview) -> bool:
            cursor: mutable Utf8Cursor = Utf8Cursor{}
            for offset in 0..<sview_len(value) |value, cursor|:
                return false if not utf8_feed(sview_at(value, offset), cursor)
            return utf8_complete(cursor)


        def differential_report_failure_category(category: DifferentialReportCategory) -> bool:
            return category != DifferentialReportCategory.None


    public:
        def validate_differential_report(report: DifferentialReport&) -> bool error[DifferentialReportError]:
            raise DifferentialReportError.InvalidFormat if not differential_report_format_valid(report.format)
            raise DifferentialReportError.InvalidStatus if not differential_report_status_valid(report.status)
            raise DifferentialReportError.InvalidCategory if not differential_report_category_valid(report.category)
            raise DifferentialReportError.InvalidComparisonKind if not differential_report_difference_kind_valid(report.comparison_kind)
            raise DifferentialReportError.MissingCaseName if report.case_name == ""
            raise DifferentialReportError.SummaryInvalid if report.summary == ""
            raise DifferentialReportError.EngineIdentityInvalid if report.reference_engine == "" or report.candidate_engine == ""
            raise DifferentialReportError.TextLimitExceeded if not differential_report_text_length_valid(report.case_name) or not differential_report_text_length_valid(report.summary) or not differential_report_text_length_valid(report.reference_engine) or not differential_report_text_length_valid(report.candidate_engine) or not differential_report_text_length_valid(report.reference_detail) or not differential_report_text_length_valid(report.candidate_detail)
            raise DifferentialReportError.ArtifactPathInvalid if report.artifact_path != "" and not differential_report_text_length_valid(report.artifact_path)
            raise DifferentialReportError.RepeatCountInvalid if report.repeat_count == 0 or report.repeat_count > Limits::REPEATS
            raise DifferentialReportError.MessageLimitExceeded if report.messages.count > Limits::MESSAGES
            total_text_bytes: mutable usize = 0
            raise DifferentialReportError.AggregateTextLimitExceeded if not differential_report_text_total_add_fits(total_text_bytes, report.case_name)
            raise DifferentialReportError.AggregateTextLimitExceeded if not differential_report_text_total_add_fits(total_text_bytes, report.summary)
            raise DifferentialReportError.AggregateTextLimitExceeded if not differential_report_text_total_add_fits(total_text_bytes, report.reference_engine)
            raise DifferentialReportError.AggregateTextLimitExceeded if not differential_report_text_total_add_fits(total_text_bytes, report.candidate_engine)
            raise DifferentialReportError.AggregateTextLimitExceeded if not differential_report_text_total_add_fits(total_text_bytes, report.reference_detail)
            raise DifferentialReportError.AggregateTextLimitExceeded if not differential_report_text_total_add_fits(total_text_bytes, report.candidate_detail)
            raise DifferentialReportError.AggregateTextLimitExceeded if not differential_report_text_total_add_fits(total_text_bytes, report.artifact_path)
            for message in report.messages |report|:
                raise DifferentialReportError.TextLimitExceeded if not differential_report_text_length_valid(message)
                raise DifferentialReportError.AggregateTextLimitExceeded if not differential_report_text_total_add_fits(total_text_bytes, message)
            raise DifferentialReportError.EmbeddedNul if sview_contains_byte(report.case_name, 0) or sview_contains_byte(report.summary, 0) or sview_contains_byte(report.reference_engine, 0) or sview_contains_byte(report.candidate_engine, 0) or sview_contains_byte(report.reference_detail, 0) or sview_contains_byte(report.candidate_detail, 0)
            raise DifferentialReportError.EmbeddedNul if report.artifact_path != "" and sview_contains_byte(report.artifact_path, 0)
            for message in report.messages |report|:
                raise DifferentialReportError.EmbeddedNul if sview_contains_byte(message, 0)
            raise DifferentialReportError.InvalidUtf8 if not differential_report_text_utf8_valid(report.case_name) or not differential_report_text_utf8_valid(report.summary) or not differential_report_text_utf8_valid(report.reference_engine) or not differential_report_text_utf8_valid(report.candidate_engine) or not differential_report_text_utf8_valid(report.reference_detail) or not differential_report_text_utf8_valid(report.candidate_detail) or not differential_report_text_utf8_valid(report.artifact_path)
            for message in report.messages |report|:
                raise DifferentialReportError.InvalidUtf8 if not differential_report_text_utf8_valid(message)
            raise DifferentialReportError.StatusCategoryMismatch if report.status == DifferentialReportStatus.Passed and report.category != DifferentialReportCategory.None
            raise DifferentialReportError.StatusCategoryMismatch if report.status == DifferentialReportStatus.Failed and not differential_report_failure_category(report.category)
            raise DifferentialReportError.StatusCategoryMismatch if report.status == DifferentialReportStatus.Skipped and report.category != DifferentialReportCategory.None
            raise DifferentialReportError.StatusCategoryMismatch if report.status == DifferentialReportStatus.Inconclusive and report.category not in {DifferentialReportCategory.Flaky, DifferentialReportCategory.InfrastructureFailure, DifferentialReportCategory.Timeout, DifferentialReportCategory.Crash}
            # The outcome must agree with its comparison and stability
            # evidence. Category labels alone cannot turn mismatching evidence
            # green, hide a failed comparison, or mark completed work skipped.
            raise DifferentialReportError.ComparisonStatusMismatch if report.status == DifferentialReportStatus.Skipped and (report.comparison_kind != DifferentialReportDifferenceKind.Unavailable or report.has_stability_evidence or report.repeat_count != 1)
            raise DifferentialReportError.ComparisonStatusMismatch if report.status == DifferentialReportStatus.Inconclusive and report.comparison_kind == DifferentialReportDifferenceKind.Equal and (report.category != DifferentialReportCategory.Flaky or not report.has_stability_evidence)
            raise DifferentialReportError.ComparisonStatusMismatch if report.status == DifferentialReportStatus.Passed and report.comparison_kind != DifferentialReportDifferenceKind.Equal
            raise DifferentialReportError.ComparisonStatusMismatch if report.status == DifferentialReportStatus.Failed and (report.comparison_kind == DifferentialReportDifferenceKind.Equal or report.comparison_kind == DifferentialReportDifferenceKind.Unavailable)
            raise DifferentialReportError.DetailOmissionInvalid if (report.reference_detail_omitted and report.reference_detail != "") or (report.candidate_detail_omitted and report.candidate_detail != "") or ((report.reference_detail_omitted or report.candidate_detail_omitted) and report.artifact_path == "")
            raise DifferentialReportError.NondeterministicPass if report.status == DifferentialReportStatus.Passed and not report.deterministic
            raise DifferentialReportError.FlakyEvidenceInvalid if report.category == DifferentialReportCategory.Flaky and (report.status != DifferentialReportStatus.Inconclusive or report.deterministic or report.repeat_count < 2 or not report.has_stability_evidence)
            stability_valid: mutable bool = false
            catch validate_differential_stability(report.stability_evidence):
                ok:
                    stability_valid <- true
                    true
                error failure:
                    stability_valid <- false
                    true
            raise DifferentialReportError.StabilityEvidenceInvalid if not stability_valid
            if report.has_stability_evidence:
                raise DifferentialReportError.StabilityEvidenceInvalid if report.stability_evidence.state != DifferentialStabilityState.Completed or report.repeat_count != report.stability_evidence.observations.count
                raise DifferentialReportError.StabilityEvidenceInvalid if report.deterministic != (report.stability_evidence.classification != DifferentialStabilityClassification.Nondeterministic)
                raise DifferentialReportError.NondeterministicClaimInvalid if report.stability_evidence.classification == DifferentialStabilityClassification.Nondeterministic and (report.status != DifferentialReportStatus.Inconclusive or report.category != DifferentialReportCategory.Flaky)
                raise DifferentialReportError.StatusCategoryMismatch if report.status == DifferentialReportStatus.Passed and report.stability_evidence.classification != DifferentialStabilityClassification.StableEqual
                raise DifferentialReportError.StatusCategoryMismatch if report.status == DifferentialReportStatus.Failed and report.stability_evidence.classification != DifferentialStabilityClassification.StableMismatch
            else:
                raise DifferentialReportError.StabilityEvidenceInvalid if report.stability_evidence.state != DifferentialStabilityState.Planned or report.repeat_count != 1
                raise DifferentialReportError.NondeterministicClaimInvalid if not report.deterministic
            return true
