# Typed machine-readable differential reports.
#
# Report rendering is deliberately separate from comparison and process
# execution. Human, JSON, and JUnit adapters must consume this validated record
# rather than infer a failure category from free-form text or exit status.

module EsDifferentialReport:
    public:
        const DIFFERENTIAL_REPORT_MAX_TEXT_BYTES: usize = 1048576
        const DIFFERENTIAL_REPORT_MAX_MESSAGES: usize = 256
        const DIFFERENTIAL_REPORT_MAX_REPEATS: usize = 1024


        const enum DifferentialReportFormat of u8:
            Human
            Json
            Junit


        const enum DifferentialReportStatus of u8:
            Passed
            Failed
            Skipped
            Inconclusive


        const enum DifferentialReportCategory of u8:
            None
            ValueMismatch
            ErrorMismatch
            ObservationMismatch
            ProcessFailure
            Timeout
            Crash
            ArtifactFailure
            InvalidInput
            InfrastructureFailure
            Flaky


        struct DifferentialReport:
            format: DifferentialReportFormat = DifferentialReportFormat.Json
            status: DifferentialReportStatus = DifferentialReportStatus.Passed
            category: DifferentialReportCategory = DifferentialReportCategory.None
            case_name: sview
            summary: sview
            reference_engine: sview
            candidate_engine: sview
            artifact_path: sview = ""
            repeat_count: usize = 1
            deterministic: bool = true
            messages: darray[sview] = []


        error DifferentialReportError:
            InvalidFormat
            InvalidStatus
            InvalidCategory
            MissingCaseName
            SummaryInvalid
            EngineIdentityInvalid
            ArtifactPathInvalid
            TextLimitExceeded
            EmbeddedNul
            MessageLimitExceeded
            RepeatCountInvalid
            MessageVectorMalformed
            StatusCategoryMismatch
            NondeterministicPass


    private:
        def differential_report_format_valid(format: DifferentialReportFormat) -> bool:
            return format in {DifferentialReportFormat.Human, DifferentialReportFormat.Json, DifferentialReportFormat.Junit}


        def differential_report_status_valid(status: DifferentialReportStatus) -> bool:
            return status in {DifferentialReportStatus.Passed, DifferentialReportStatus.Failed, DifferentialReportStatus.Skipped, DifferentialReportStatus.Inconclusive}


        def differential_report_category_valid(category: DifferentialReportCategory) -> bool:
            return category in {DifferentialReportCategory.None, DifferentialReportCategory.ValueMismatch, DifferentialReportCategory.ErrorMismatch, DifferentialReportCategory.ObservationMismatch, DifferentialReportCategory.ProcessFailure, DifferentialReportCategory.Timeout, DifferentialReportCategory.Crash, DifferentialReportCategory.ArtifactFailure, DifferentialReportCategory.InvalidInput, DifferentialReportCategory.InfrastructureFailure, DifferentialReportCategory.Flaky}


        def differential_report_text_valid(value: sview) -> bool:
            return sview_len(value) < DIFFERENTIAL_REPORT_MAX_TEXT_BYTES and not sview_contains_byte(value, 0)


        def differential_report_failure_category(category: DifferentialReportCategory) -> bool:
            return category != DifferentialReportCategory.None


    public:
        def validate_differential_report(report: DifferentialReport&) -> bool error[DifferentialReportError]:
            raise DifferentialReportError.InvalidFormat if not differential_report_format_valid(report.format)
            raise DifferentialReportError.InvalidStatus if not differential_report_status_valid(report.status)
            raise DifferentialReportError.InvalidCategory if not differential_report_category_valid(report.category)
            raise DifferentialReportError.MissingCaseName if report.case_name == ""
            raise DifferentialReportError.SummaryInvalid if report.summary == ""
            raise DifferentialReportError.EngineIdentityInvalid if report.reference_engine == "" or report.candidate_engine == ""
            raise DifferentialReportError.TextLimitExceeded if not differential_report_text_valid(report.case_name) or not differential_report_text_valid(report.summary) or not differential_report_text_valid(report.reference_engine) or not differential_report_text_valid(report.candidate_engine)
            raise DifferentialReportError.EmbeddedNul if sview_contains_byte(report.case_name, 0) or sview_contains_byte(report.summary, 0) or sview_contains_byte(report.reference_engine, 0) or sview_contains_byte(report.candidate_engine, 0)
            raise DifferentialReportError.ArtifactPathInvalid if report.artifact_path != "" and not differential_report_text_valid(report.artifact_path)
            raise DifferentialReportError.EmbeddedNul if report.artifact_path != "" and sview_contains_byte(report.artifact_path, 0)
            raise DifferentialReportError.RepeatCountInvalid if report.repeat_count == 0 or report.repeat_count > DIFFERENTIAL_REPORT_MAX_REPEATS
            raise DifferentialReportError.MessageLimitExceeded if report.messages.count > DIFFERENTIAL_REPORT_MAX_MESSAGES
            for message in report.messages |report|:
                raise DifferentialReportError.TextLimitExceeded if not differential_report_text_valid(message)
                raise DifferentialReportError.EmbeddedNul if sview_contains_byte(message, 0)
            raise DifferentialReportError.StatusCategoryMismatch if report.status == DifferentialReportStatus.Passed and report.category != DifferentialReportCategory.None
            raise DifferentialReportError.StatusCategoryMismatch if report.status == DifferentialReportStatus.Failed and not differential_report_failure_category(report.category)
            raise DifferentialReportError.StatusCategoryMismatch if report.status == DifferentialReportStatus.Skipped and report.category != DifferentialReportCategory.None
            raise DifferentialReportError.StatusCategoryMismatch if report.status == DifferentialReportStatus.Inconclusive and report.category not in {DifferentialReportCategory.Flaky, DifferentialReportCategory.InfrastructureFailure}
            raise DifferentialReportError.NondeterministicPass if report.status == DifferentialReportStatus.Passed and not report.deterministic
            return true
